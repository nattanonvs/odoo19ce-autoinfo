<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Whitelist of models and fields the dashboard builder is allowed to
        read. Only the records declared here can be used by a widget, so the
        in-browser builder can never query an arbitrary model or field.
    -->

    <!-- ===================== Sales Orders ===================== -->
    <record id="source_sale_order" model="od19.dashboard.source">
        <field name="name">Sales Orders</field>
        <field name="model_name">sale.order</field>
        <field name="description">Quotations and confirmed sales orders.</field>
        <field name="sequence">10</field>
    </record>
    <record id="source_sale_order_amount_total" model="od19.dashboard.source.field">
        <field name="source_id" ref="source_sale_order"/>
        <field name="label">Order Amount</field>
        <field name="field_name">amount_total</field>
        <field name="kind">measure</field>
        <field name="agg">sum</field>
        <field name="sequence">10</field>
    </record>
    <record id="source_sale_order_amount_untaxed" model="od19.dashboard.source.field">
        <field name="source_id" ref="source_sale_order"/>
        <field name="label">Untaxed Amount</field>
        <field name="field_name">amount_untaxed</field>
        <field name="kind">measure</field>
        <field name="agg">sum</field>
        <field name="sequence">20</field>
    </record>
    <record id="source_sale_order_state" model="od19.dashboard.source.field">
        <field name="source_id" ref="source_sale_order"/>
        <field name="label">Status</field>
        <field name="field_name">state</field>
        <field name="kind">groupby</field>
        <field name="sequence">10</field>
    </record>
    <record id="source_sale_order_partner" model="od19.dashboard.source.field">
        <field name="source_id" ref="source_sale_order"/>
        <field name="label">Customer</field>
        <field name="field_name">partner_id</field>
        <field name="kind">groupby</field>
        <field name="sequence">20</field>
    </record>
    <record id="source_sale_order_user" model="od19.dashboard.source.field">
        <field name="source_id" ref="source_sale_order"/>
        <field name="label">Salesperson</field>
        <field name="field_name">user_id</field>
        <field name="kind">groupby</field>
        <field name="sequence">30</field>
    </record>
    <record id="source_sale_order_team" model="od19.dashboard.source.field">
        <field name="source_id" ref="source_sale_order"/>
        <field name="label">Sales Team</field>
        <field name="field_name">team_id</field>
        <field name="kind">groupby</field>
        <field name="sequence">40</field>
    </record>
    <record id="source_sale_order_date" model="od19.dashboard.source.field">
        <field name="source_id" ref="source_sale_order"/>
        <field name="label">Order Date</field>
        <field name="field_name">date_order</field>
        <field name="kind">date</field>
        <field name="sequence">10</field>
    </record>

