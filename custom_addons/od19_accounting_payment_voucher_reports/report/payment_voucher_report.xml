<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="payment_voucher_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">ใบสำคัญจ่าย</h2>
                    <h3 class="text-center">Payment Voucher</h3>

                    <div class="row mt-3">
                        <div class="col-6">
                            <strong>เลขที่เอกสาร:</strong>
                            <span t-field="doc.pv_number"/>
                        </div>
                        <div class="col-6 text-right">
                            <strong>วันที่:</strong>
                            <span t-field="doc.date"/>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <strong>ผู้รับเงิน:</strong>
                            <span t-field="doc.partner_id.name"/>
                        </div>
                        <div class="col-6">
                            <strong>ที่อยู่:</strong>
                            <span t-field="doc.partner_id.street"/>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <strong>เลขประจำตัวผู้เสียภาษี:</strong>
                            <span t-field="doc.partner_id.vat"/>
                        </div>
                        <div class="col-6">
                            <strong>สาขา:</strong>
                            <span t-esc="doc.partner_id.branch_code or '00000'"/>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-12">
                            <strong>รายการ:</strong>
                            <span t-field="doc.ref"/>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <strong>วิธีการชำระเงิน:</strong>
                            <span t-esc="dict(doc._fields['payment_type'].selection).get(doc.payment_type, doc.payment_type)"/>
                        </div>
                        <div class="col-6">
                            <strong>ธนาคาร:</strong>
                            <span t-field="doc.journal_id.name"/>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered mt-4">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width:10%">ลำดับ</th>
                                <th class="text-center">รายละเอียด</th>
                                <th class="text-right" style="width:20%">จำนวนเงิน</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-center">1</td>
                                <td>
                                    <t t-if="doc.ref"><span t-field="doc.ref"/></t>
                                    <t t-else="">ชำระเงิน</t>
                                </td>
                                <td class="text-right">
                                    <span t-esc="{:,.2f}'.format(doc.amount)"/>
                                </td>
                            </tr>
                            <tr class="font-weight-bold">
                                <td colspan="2" class="text-right">รวมทั้งสิ้น</td>
                                <td class="text-right">
                                    <span t-esc="{:,.2f}'.format(doc.amount)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="row mt-4">
                        <div class="col-12">
                            <strong>จำนวนเงิน (ตัวอักษร):</strong>
                            <span t-esc="doc.currency_id.amount_to_text(doc.amount)"/>
                        </div>
                    </div>

                    <div class="row mt-5">
                        <div class="col-4 text-center">
                            <div>__________________________</div>
                            <div>ผู้จ่ายเงิน</div>
                        </div>
                        <div class="col-4 text-center">
                            <div>__________________________</div>
                            <div>ผู้รับเงิน</div>
                        </div>
                        <div class="col-4 text-center">
                            <div>__________________________</div>
                            <div>ผู้อนุมัติ</div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_payment_voucher" model="ir.actions.report">
        <field name="name">Payment Voucher</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">od19_accounting_payment_voucher_reports.payment_voucher</field>
        <field name="report_file">od19_accounting_payment_voucher_reports.payment_voucher</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
