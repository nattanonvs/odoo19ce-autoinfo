<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Rename the Accounting app root menu.
        Odoo core labels this menu "Invoicing" (Thai: "ออกใบแจ้งหนี้") which the
        accounting team is not familiar with; the requested label is
        "Accounting" (Thai: "การบัญชี").
    -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="name">Accounting</field>
    </record>

    <!--
        Avoid a duplicated "Accounting &gt; Accounting" hierarchy: rename the
        inner menu (core "Accounting") to "Accounting Entries"
        (Thai: "รายการบัญชี").
    -->
    <record id="account.menu_finance_entries" model="ir.ui.menu">
        <field name="name">Accounting Entries</field>
    </record>

    <!--
        Keep Configuration as the last menu of the app (it must come after the
        operational menus such as Advance Payments, Cheques and Petty Cash).
    -->
    <record id="account.menu_finance_configuration" model="ir.ui.menu">
        <field name="sequence">99</field>
    </record>

    <!--
        Force the Thai labels of the two renamed menus. When a module is
        installed/upgraded Odoo loads its i18n/*.po files WITHOUT overwriting
        translations that already exist (overwrite_existing_translations is off
        by default), so the old core Thai text ("ออกใบแจ้งหนี้" / "การบัญชี")
        would otherwise stay attached to the new English labels.
    -->
    <function model="ir.ui.menu" name="update_field_translations"
              eval="[ref('account.menu_finance'), 'name', {'th_TH': 'การบัญชี'}]"/>
    <function model="ir.ui.menu" name="update_field_translations"
              eval="[ref('account.menu_finance_entries'), 'name', {'th_TH': 'รายการบัญชี'}]"/>

    <!--
        The Settings page renders one collapsible section per app and takes the
        section header from the "string" attribute of the <app> element in the
        res.config.settings form. Odoo core hardcodes it as "Invoicing"
        (Thai: "ออกใบแจ้งหนี้"), so the Accounting team still saw the old name in
        Settings even though the app menu itself was renamed to "Accounting".
        Override the label here instead of touching the Odoo core view.
    -->
    <record id="view_res_config_settings_account_app_label" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.app.label</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="attributes">
                <attribute name="string">Accounting</attribute>
                <attribute name="data-string">Accounting</attribute>
            </xpath>
        </field>
    </record>

</odoo>
