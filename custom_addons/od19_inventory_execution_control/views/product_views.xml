<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_od19_inventory_execution_control" model="ir.ui.view">
        <field name="name">product.template.form.od19.inventory.execution.control</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tracking']" position="after">
                <field
                    name="od19_tracking_required"
                    readonly="1"
                    groups="stock.group_production_lot"
                    invisible="not is_storable"
                />
                <field
                    name="od19_tracking_required_reason"
                    groups="stock.group_production_lot"
                    invisible="not is_storable or not od19_tracking_required"
                />
            </xpath>
        </field>
    </record>
</odoo>
