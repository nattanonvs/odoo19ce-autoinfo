<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_od19_inventory_execution_control" model="ir.ui.view">
        <field name="name">stock.picking.form.od19.inventory.execution.control</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="od19_flow_class" readonly="1"/>
                <field name="od19_execution_state" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
