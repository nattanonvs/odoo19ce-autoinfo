<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="od19_stock_valuation_by_lot_view_list" model="ir.ui.view">
        <field name="name">od19.stock.valuation.by.lot.list</field>
        <field name="model">od19.stock.valuation.by.lot</field>
        <field name="arch" type="xml">
            <list string="Stock Valuation by Lot">
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <field name="cost_method"/>
                <field name="quantity"/>
                <field name="unit_cost"/>
                <field name="total_value"
                       decoration-danger="total_value &lt; 0"
                       decoration-success="total_value &gt; 0"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="od19_stock_valuation_by_lot_view_search" model="ir.ui.view">
        <field name="name">od19.stock.valuation.by.lot.search</field>
        <field name="model">od19.stock.valuation.by.lot</field>
        <field name="arch" type="xml">
            <search string="Stock Valuation by Lot">
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <field name="categ_id"/>
                <group>
                    <filter string="Product" name="product" context="{'group_by': 'product_id'}"/>
                    <filter string="Lot" name="lot" context="{'group_by': 'lot_id'}"/>
                    <filter string="Location" name="location" context="{'group_by': 'location_id'}"/>
                    <filter string="Cost Method" name="cost_method" context="{'group_by': 'cost_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="od19_stock_valuation_by_lot_action" model="ir.actions.act_window">
        <field name="name">Stock Valuation by Lot</field>
        <field name="res_model">od19.stock.valuation.by.lot</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="od19_stock_valuation_by_lot_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stock valuation by lot found.
            </p>
        </field>
    </record>

    <menuitem id="menu_od19_stock_valuation_by_lot" name="Valuation by Lot"
              parent="stock.menu_stock_inventory_control"
              action="od19_stock_valuation_by_lot_action" sequence="75"/>
</odoo>
