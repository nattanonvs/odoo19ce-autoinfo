<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="od19_bring_forward_multi_company_rule" model="ir.rule">
            <field name="name">Bring Forward multi-company</field>
            <field ref="model_od19_bring_forward" name="model_id"/>
            <field eval="True" name="global"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="od19_bring_forward_line_multi_company_rule" model="ir.rule">
            <field name="name">Bring Forward Line multi-company</field>
            <field ref="model_od19_bring_forward_line" name="model_id"/>
            <field eval="True" name="global"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
