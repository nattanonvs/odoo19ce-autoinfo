<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_cheque" model="ir.ui.view">
        <field name="name">account.payment.form.cheque</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="cheque_id"
                       domain="[('cheque_type', '=', 'customer'), ('state', 'in', ('available', 'draft'))]"
                       invisible="payment_type != 'inbound'"/>
                <field name="cheque_paid_id"
                       domain="[('cheque_type', '=', 'supplier'), ('state', '=', 'available')]"
                       invisible="payment_type != 'outbound'"/>
                <field name="pay_to" invisible="not cheque_paid_id"/>
                <field name="od19_is_cheque_deposit" invisible="1"/>
            </xpath>

            <!-- Collecting cheques (F9/R6) are composed by the layout owner
                 (od19_accounting_payment_voucher_reports) in the form
                 notebook; this module only defines the field / model. -->
        </field>
    </record>

</odoo>
