<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_company_cheque_form" model="ir.ui.view">
        <field name="name">res.company.cheque.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="Cheque Management">
                    <field name="cheque_received_account_id"/>
                    <field name="cheque_paid_account_id"/>
                    <field name="cheque_return_account_id"/>
                    <field name="show_ac_payee"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
