<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_cheque_print" model="ir.actions.report">
        <field name="name">Cheque Print</field>
        <field name="model">account.cheque</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">od19_accounting_cheque.cheque_print</field>
        <field name="report_file">od19_accounting_cheque.cheque_print</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="cheque_print">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="cheque">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Cheque Print Layout - merged template for all banks -->
                        <div class="cheque-container"
                             style="position: relative; width: 100%; padding: 20px; font-family: 'Sarabun', sans-serif;">
                            <!-- Cheque Header -->
                            <div class="cheque-header" style="margin-bottom: 10px;">
                                <div t-if="cheque.company_id.name" class="company-name"
                                     style="font-size: 14px; font-weight: bold;">
                                    <span t-field="cheque.company_id.name"/>
                                </div>
                                <div t-if="cheque.journal_id.name" class="bank-name"
                                     style="font-size: 12px; color: #666;">
                                    <span t-field="cheque.journal_id.name"/>
                                </div>
                            </div>

                            <!-- Cheque Date (top right) -->
                            <div class="cheque-date"
                                 style="position: absolute; top: 20px; right: 20px; font-size: 12px;">
                                <span>Date: </span>
                                <span t-field="cheque.cheque_date"/>
                            </div>

                            <!-- Pay To -->
                            <div class="pay-to" style="margin-top: 30px; margin-bottom: 15px;">
                                <span style="font-weight: bold;">Pay To: </span>
                                <span t-field="cheque.pay_to or cheque.partner_id.name"
                                      style="border-bottom: 1px solid #000; padding: 0 10px; font-size: 14px;"/>
                            </div>

                            <!-- Amount (left) -->
                            <div class="amount-text" style="margin-bottom: 15px;">
                                <span style="font-weight: bold;">Amount: </span>
                                <span t-esc="cheque.currency_id.symbol"
                                      style="font-weight: bold;"/>
                                <span t-field="cheque.amount"
                                      style="font-size: 16px; font-weight: bold;"/>
                            </div>

                            <!-- Amount in text -->
                            <div class="amount-words" style="margin-bottom: 15px;">
                                <span style="font-weight: bold;">Amount in Words: </span>
                                <span t-esc="cheque.currency_id.with_context(lang='th_TH').amount_to_text(cheque.amount)"
                                      style="text-transform: uppercase;"/>
                            </div>

                            <!-- A/C Payee line -->
                            <div t-if="cheque.ac_payee" class="ac-payee"
                                 style="margin-top: 20px; padding: 5px 10px; border: 2px solid #000; display: inline-block;">
                                <strong style="transform: rotate(-10deg); display: inline-block;">
                                    A/C PAYEE ONLY
                                </strong>
                            </div>

                            <!-- Cheque Number -->
                            <div class="cheque-no"
                                 style="position: absolute; bottom: 20px; left: 20px; font-size: 12px;">
                                <span>Cheque No: </span>
                                <strong t-field="cheque.name"/>
                            </div>

                            <!-- Signature line -->
                            <div class="signature"
                                 style="position: absolute; bottom: 20px; right: 20px; text-align: center;">
                                <div style="border-top: 1px solid #000; width: 150px; margin-bottom: 5px;"></div>
                                <span style="font-size: 10px; color: #666;">Authorized Signature</span>
                            </div>

                            <!-- Memo -->
                            <div t-if="cheque.memo" class="memo"
                                 style="position: absolute; bottom: 50px; left: 20px; font-size: 11px; color: #666;">
                                <span>Memo: </span>
                                <span t-field="cheque.memo"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
