<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_od19_billing_evidence" model="ir.ui.view">
        <field name="name">sale.order.form.od19.billing.evidence</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='od19_contract_id']" position="after">
                <field name="od19_billing_readiness_state" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
