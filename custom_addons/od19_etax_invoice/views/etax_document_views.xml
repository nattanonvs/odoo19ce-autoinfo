<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_od19_etax_document_list" model="ir.ui.view">
        <field name="name">od19.etax.document.list</field>
        <field name="model">od19.etax.document</field>
        <field name="arch" type="xml">
            <list string="e-Tax Documents">
                <field name="name"/>
                <field name="document_type"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="issue_datetime"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'generated'"
                       decoration-success="state == 'signed'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_od19_etax_document_form" model="ir.ui.view">
        <field name="name">od19.etax.document.form</field>
        <field name="model">od19.etax.document</field>
        <field name="arch" type="xml">
            <form string="e-Tax Document">
                <header>
                    <field name="od19_etax_enabled" invisible="1"/>
                    <button name="action_generate_xml" type="object"
                            string="Generate XML" class="btn-primary"
                            invisible="state in ('signed', 'cancelled') or not od19_etax_enabled"/>
                    <button name="action_sign" type="object"
                            string="Sign" class="btn-primary"
                            invisible="state in ('signed', 'cancelled') or not od19_etax_enabled"/>
                    <button name="action_generate_pdf" type="object"
                            string="Generate PDF"
                            invisible="not od19_etax_enabled"/>
                    <button name="action_print" type="object"
                            string="Print"
                            invisible="not od19_etax_enabled"/>
                    <button name="action_submit_to_rd" type="object"
                            string="Submit to RD" class="btn-primary"
                            invisible="state != 'signed' or not od19_etax_enabled"/>
                    <button name="action_cancel" type="object"
                            string="Cancel Document"
                            invisible="state in ('signed', 'cancelled')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state in ('draft', 'signed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated,signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Document Reference"/>
                        <h1>
                            <field name="name" placeholder="e.g. INV/2026/00001"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="move_id"
                                   options="{'no_create': True, 'no_open': False}"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="issue_datetime"/>
                            <field name="type_code"/>
                            <field name="purpose_code"/>
                            <field name="source_document_id"
                                   invisible="document_type not in ('debit_credit_note', 'cancellation_note')"/>
                            <field name="certificate_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <group>
                                <field name="global_id"/>
                                <field name="note" placeholder="Additional information reported in the document"/>
                            </group>
                        </page>
                        <page string="Files" name="files">
                            <group>
                                <field name="xml_filename" invisible="1"/>
                                <field name="xml_file" filename="xml_filename"
                                       readonly="1"/>
                                <field name="signed_xml_filename" invisible="1"/>
                                <field name="signer_subject" readonly="1"/>
                                <field name="signer_serial" readonly="1"/>
                                <field name="signed_at" readonly="1"/>
                                <field name="signed_xml_file"
                                       filename="signed_xml_filename"
                                       readonly="1"/>
                                <field name="pdf_filename" invisible="1"/>
                                <field name="pdf_file" filename="pdf_filename"
                                       readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_od19_etax_document_search" model="ir.ui.view">
        <field name="name">od19.etax.document.search</field>
        <field name="model">od19.etax.document</field>
        <field name="arch" type="xml">
            <search string="e-Tax Documents">
                <field name="name"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <filter string="Signed" name="signed" domain="[('state', '=', 'signed')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter string="Document Type" name="group_type"
                            context="{'group_by': 'document_type'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Customer" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_od19_etax_document" model="ir.actions.act_window">
        <field name="name">e-Tax Documents</field>
        <field name="res_model">od19.etax.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_od19_etax_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Issue your first e-Tax document
            </p>
            <p>
                Open a posted customer invoice and click on
                <b>Create e-Tax Document</b> to build, sign and print the
                RD compliant XML.
            </p>
        </field>
    </record>

</odoo>
