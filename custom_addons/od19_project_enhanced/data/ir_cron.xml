<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_task_deadline_notification" model="ir.cron">
        <field name="name">OD19 Project Task Deadline Notification</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_task_deadline_notification()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="priority">5</field>
        <field name="nextcall" eval="datetime(2026, 1, 1, 8, 0, 0)"/>
    </record>
</odoo>
