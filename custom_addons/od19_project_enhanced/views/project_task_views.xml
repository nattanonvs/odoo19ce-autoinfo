<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_form_inherit_od19_enhanced" model="ir.ui.view">
        <field name="name">project.task.form.od19.enhanced</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="od19_project_type_id"
                       domain="[('task_ok', '=', True)]"
                       string="Project Type"/>
            </xpath>
        </field>
    </record>
</odoo>
