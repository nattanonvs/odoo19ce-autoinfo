<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_project_form_inherit_od19_enhanced" model="ir.ui.view">
        <field name="name">project.project.form.od19.enhanced</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od19_project_type_id"
                       domain="[('project_ok', '=', True)]"/>
            </xpath>
            <!-- Job Assignment tab: place it in the main notebook, right before Settings -->
            <xpath expr="//notebook/page[@name='settings']" position="before">
                <page string="Job Assignment" name="od19_job_assignment">
                    <group>
                        <group string="Assignment">
                            <field name="od19_responsible_person_ids"
                                   widget="many2many_tags"
                                   string="Responsible Persons"/>
                            <field name="od19_coordinator_ids"
                                   widget="many2many_tags"
                                   string="Coordinators"/>
                        </group>
                        <group string="Documents">
                            <field name="od19_scope_of_work"
                                   string="Scope of Work"/>
                            <field name="od19_document_requirements"
                                   string="Document Requirements"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Title bar: show '(job_no) project name' as the heading, then repeat the
         Job Number and Project Name as separate, editable fields underneath. -->
    <record id="view_project_project_form_title_inherit_od19_enhanced" model="ir.ui.view">
        <field name="name">project.project.form.title.od19.enhanced</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="od19_project_analytic.view_project_project_form_inherit_od19"/>
        <field name="arch" type="xml">
            <xpath expr="//h1[field[@name='job_no']]" position="replace">
                <h1 class="d-flex flex-row">
                    <field name="is_favorite" nolabel="1" widget="project_is_favorite" class="me-2" options="{'autosave': False}"/>
                    <field name="od19_title" nolabel="1" class="o_text_overflow"/>
                </h1>
            </xpath>
            <xpath expr="//h2[field[@name='name']]" position="replace">
                <div class="od19-title-fields mt-2">
                    <div class="row g-0 align-items-baseline mb-1">
                        <div class="col-12 col-sm-3 col-lg-2 text-muted fw-semibold">Job Number</div>
                        <div class="col-12 col-sm-9 col-lg-10">
                            <field name="job_no" nolabel="1" class="o_text_overflow" placeholder="e.g. JOB-2026-001" required="1"/>
                        </div>
                    </div>
                    <div class="row g-0 align-items-baseline">
                        <div class="col-12 col-sm-3 col-lg-2 text-muted fw-semibold">Project Name</div>
                        <div class="col-12 col-sm-9 col-lg-10">
                            <field name="name" nolabel="1" widget="text" options="{'line_breaks': False}" class="o_text_overflow" placeholder="e.g. Project Name"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_project_project_list_inherit_od19_enhanced" model="ir.ui.view">
        <field name="name">project.project.list.od19.enhanced</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od19_project_type_id" optional="show"/>
            </xpath>
            <!-- Single, combined title column. The core 'name' column is kept
                 available (hidden by default) so it can still be used for
                 sorting, while '(job_no) name' is the primary column shown. -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="od19_title" string="Project" class="fw-bold" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Clicking a project card must open the project form (summary/details)
         instead of jumping straight to the task list. Core wires the kanban
         card click to the task list via the 'action' attribute; dropping it
         restores the default behaviour (open the record). Tasks stay reachable
         from the card's "..." menu. -->
    <record id="view_project_project_kanban_inherit_od19_enhanced" model="ir.ui.view">
        <field name="name">project.project.kanban.od19.enhanced</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="action"></attribute>
            </xpath>
            <!-- Card heading shows '(job_no) project name'. The Job Number and
                 Project Name are not repeated; the card shows complementary
                 context instead (project category and department). -->
            <xpath expr="//kanban/templates" position="before">
                <field name="od19_title"/>
                <field name="od19_project_type_id"/>
                <field name="od19_department_id"/>
            </xpath>
            <xpath expr="//span[hasclass('fs-4')]" position="replace">
                <span class="text-truncate d-block fs-4 fw-bold" t-att-title="record.od19_title.value"><field name="od19_title"/></span>
            </xpath>
            <xpath expr="//div[hasclass('o_project_kanban_body')]" position="before">
                <div class="text-muted d-flex align-items-baseline" t-if="record.od19_project_type_id.raw_value">
                    <span class="fa fa-tag me-2" title="Project Category"/>
                    <field name="od19_project_type_id" class="text-truncate"/>
                </div>
                <div class="text-muted d-flex align-items-baseline" t-if="record.od19_department_id.raw_value">
                    <span class="fa fa-building me-2" title="Department"/>
                    <field name="od19_department_id" class="text-truncate"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- D7: data quality KPIs -->
    <record id="view_project_project_kpi_list" model="ir.ui.view">
        <field name="name">project.project.kpi.list</field>
        <field name="model">project.project</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Projects" create="false" delete="false">
                <field name="name"/>
                <field name="job_no"/>
                <field name="od19_department_id" optional="show"/>
                <field name="od19_project_type_id" optional="show"/>
                <field name="partner_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_od19_project_without_job_no" model="ir.actions.act_window">
        <field name="name">Projects without Job Number</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_project_project_kpi_list"/>
        <field name="domain">[('job_no', '=', False)]</field>
    </record>

    <record id="action_od19_project_without_analytic" model="ir.actions.act_window">
        <field name="name">Projects without Analytic Account</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_project_project_kpi_list"/>
        <field name="domain">[('account_id', '=', False)]</field>
    </record>

    <menuitem
        id="menu_od19_project_without_job_no"
        name="Projects without Job Number"
        parent="project.menu_main_pm"
        action="action_od19_project_without_job_no"
        sequence="97"
        groups="project.group_project_manager"
    />
    <menuitem
        id="menu_od19_project_without_analytic"
        name="Projects without Analytic Account"
        parent="project.menu_main_pm"
        action="action_od19_project_without_analytic"
        sequence="98"
        groups="project.group_project_manager"
    />
</odoo>
