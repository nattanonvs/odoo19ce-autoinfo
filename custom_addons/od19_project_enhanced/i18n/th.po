#. module: od19_project_enhanced
#: model:mail.template,body_html:od19_project_enhanced.mail_template_task_deadline_notification
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Dear <t t-esc=\"ctx.get('od19_recipient_name', '')\"/>,</p>\n"
"    <p>\n"
"        This is a friendly reminder that the task\n"
"        <strong>{{ object.name }}</strong>\n"
"        <t t-if=\"object.project_id\">\n"
"            in project <strong>{{ object.project_id.name }}</strong>\n"
"        </t>\n"
"        has a deadline on\n"
"        <strong>{{ object._get_deadline_formatted() }}</strong>.\n"
"    </p>\n"
"    <p>Please make sure the task is completed on time.</p>\n"
"    <p>\n"
"        Best regards,<br/>\n"
"        {{ object.company_id.name or user.company_id.name }}\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>เรียน <t t-esc=\"ctx.get('od19_recipient_name', '')\"/>,</p>\n"
"    <p>\n"
"        ขอแจ้งเตือนว่างาน\n"
"        <strong>{{ object.name }}</strong>\n"
"        <t t-if=\"object.project_id\">\n"
"            ในโครงการ <strong>{{ object.project_id.name }}</strong>\n"
"        </t>\n"
"        มีกำหนดส่งในวันที่\n"
"        <strong>{{ object._get_deadline_formatted() }}</strong>\n"
"    </p>\n"
"    <p>กรุณาดำเนินการให้งานเสร็จตามกำหนด</p>\n"
"    <p>\n"
"        ขอแสดงความนับถือ<br/>\n"
"        {{ object.company_id.name or user.company_id.name }}\n"
"    </p>\n"
"</div>\n"
"        "

