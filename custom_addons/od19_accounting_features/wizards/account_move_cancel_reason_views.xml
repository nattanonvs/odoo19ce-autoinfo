<odoo>

    <record id="view_od19_account_move_cancel_reason_form" model="ir.ui.view">
        <field name="name">od19.account.move.cancel.reason.form</field>
        <field name="model">od19.account.move.cancel.reason</field>
        <field name="arch" type="xml">
            <form string="Cancel Reason">
                <group>
                    <field name="move_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="move_type"/>
                            <field name="state"/>
                        </list>
                    </field>
                </group>
                <group>
                    <field name="reason" placeholder="Please enter the reason for cancellation..." nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm Cancel"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
