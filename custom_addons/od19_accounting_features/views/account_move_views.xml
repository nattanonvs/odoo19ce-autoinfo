<odoo>

    <!-- ============================================================= -->
    # Cancel reason: the standard Cancel button now opens the
    # cancel-reason wizard (handled in the account.move override).
    # Display the stored reason on the form once set.
    <!-- ============================================================= -->
    <record id="view_move_form_cancel_reason" model="ir.ui.view">
        <field name="name">account.move.form.cancel.reason</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="od19_cancel_reason" readonly="1"
                       invisible="not od19_cancel_reason"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================= -->
    # Payer / Payee on prepayments + BOT smart button + due date +
    # payment number on the invoice form.
    <!-- ============================================================= -->
    <record id="view_move_form_od19_features" model="ir.ui.view">
        <field name="name">account.move.form.od19.features</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- BOT smart button in the button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_bot_url"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-link"
                        string="BOT"
                        help="Open Revenue Department (BOT) tax invoice lookup"
                        invisible="not od19_bot_url"/>
            </xpath>

            <!-- Actual due date -->
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="od19_actual_due_date"
                       string="Actual Due Date"
                       invisible="not od19_actual_due_date"
                       readonly="1"/>
            </xpath>

            <!-- Payment number on vendor bills -->
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="od19_payment_number"
                       string="Payment Number"
                       readonly="1"
                       invisible="move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>

            <!-- Payer / Payee block, shown only for prepayments -->
            <xpath expr="//group[@id='header_right_group']" position="after">
                <group string="Prepayment Payer/Payee"
                       col="2"
                       invisible="not od19_is_downpayment">
                    <field name="od19_payer_id"
                           string="ผู้จ่ายเงิน / Payer"/>
                    <field name="od19_payee_id"
                           string="ผู้รับเงิน / Payee"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
