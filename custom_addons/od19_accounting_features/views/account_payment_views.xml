<odoo>

    <record id="view_account_payment_form_od19" model="ir.ui.view">
        <field name="name">account.payment.form.od19</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <!-- Payer / Payee (K1): hidden on the inbound receipt form, where
                 partner_id already is the payer. Kept for the outbound flow
                 (e.g. paying on behalf of another partner). -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od19_payer_id"
                       string="ผู้จ่ายเงิน / Payer"
                       invisible="payment_type == 'inbound'"/>
                <field name="od19_payee_id"
                       string="ผู้รับเงิน / Payee"
                       invisible="payment_type == 'inbound'"/>
                <!-- R3: receipt document type drives the RE / TI number series (K8). -->
                <field name="od19_receipt_doc_type"
                       string="ประเภทการเปิดเอกสาร / Document type"
                       invisible="payment_type != 'inbound'"/>
            </xpath>
            <!-- WHT / VAT detail is composed by the layout owner
                 (od19_accounting_payment_voucher_reports) in the form
                 notebook; this module only defines the fields. -->
        </field>
    </record>

</odoo>
