<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_od19_ai_chat_list" model="ir.ui.view">
        <field name="name">od19.ai.chat.list</field>
        <field name="model">od19.ai.chat</field>
        <field name="arch" type="xml">
            <list string="ผู้ช่วย AI">
                <field name="create_date"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"/>
                <field name="model_used"/>
            </list>
        </field>
    </record>

    <record id="view_od19_ai_chat_form" model="ir.ui.view">
        <field name="name">od19.ai.chat.form</field>
        <field name="model">od19.ai.chat</field>
        <field name="arch" type="xml">
            <form string="ผู้ช่วย AI">
                <header>
                    <button name="action_ask" type="object" string="ถาม AI"
                            class="oe_highlight" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,error"/>
                </header>
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="model_used"/>
                    </group>
                    <group string="คำถาม">
                        <field name="prompt" nolabel="1" placeholder="พิมพ์คำถามของคุณ ..."/>
                    </group>
                    <group string="คำตอบ">
                        <field name="response" nolabel="1" readonly="1"/>
                        <field name="error_message" nolabel="1" readonly="1"
                               invisible="not error_message" class="text-danger"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_od19_ai_chat" model="ir.actions.act_window">
        <field name="name">ผู้ช่วย AI</field>
        <field name="res_model">od19.ai.chat</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_od19_ai_root" name="ผู้ช่วย AI" sequence="95"/>
    <menuitem id="menu_od19_ai_chat" name="ถาม AI"
              parent="menu_od19_ai_root" action="action_od19_ai_chat" sequence="10"/>

</odoo>
