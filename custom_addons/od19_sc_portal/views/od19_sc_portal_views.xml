<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== Portal Page ===================== -->
    <record id="view_od19_sc_portal_page_list" model="ir.ui.view">
        <field name="name">od19.sc.portal.page.list</field>
        <field name="model">od19.sc.portal.page</field>
        <field name="arch" type="xml">
            <list string="Portal Pages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="template_id"/>
                <field name="kpi_count"/>
                <field name="is_published"/>
                <field name="group_ids" widget="many2many_tags" optional="hide"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_od19_sc_portal_page_form" model="ir.ui.view">
        <field name="name">od19.sc.portal.page.form</field>
        <field name="model">od19.sc.portal.page</field>
        <field name="arch" type="xml">
            <form string="Portal Page">
                <header>
                    <button name="action_open_portal" type="object"
                            string="Preview Portal" class="btn-primary"
                            invisible="not is_published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="เช่น Service Center — ลูกค้า"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_id"
                                   options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_published"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Visibility">
                        <field name="group_ids" widget="many2many_tags"
                               placeholder="เว้นว่าง = ผู้ใช้พอร์ทัลทุกคน"/>
                    </group>
                    <field name="intro" placeholder="คำอธิบายสั้น ๆ เหนือการ์ดรายงาน"/>
                    <notebook>
                        <page string="KPI Cards" name="kpi">
                            <field name="kpi_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="aggregate"/>
                                    <field name="target_model"/>
                                    <field name="measure_field"/>
                                    <field name="value_display" readonly="1"/>
                                    <field name="error"
                                           decoration-danger="error != ''" readonly="1"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_od19_sc_portal_page_search" model="ir.ui.view">
        <field name="name">od19.sc.portal.page.search</field>
        <field name="model">od19.sc.portal.page</field>
        <field name="arch" type="xml">
            <search string="Portal Pages">
                <field name="name"/>
                <field name="template_id"/>
                <filter name="filter_published" string="Published"
                        domain="[('is_published', '=', True)]"/>
                <filter name="filter_unpublished" string="Unpublished"
                        domain="[('is_published', '=', False)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_template" string="Template"
                            context="{'group_by': 'template_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== KPI Card ===================== -->
    <record id="view_od19_sc_portal_kpi_list" model="ir.ui.view">
        <field name="name">od19.sc.portal.kpi.list</field>
        <field name="model">od19.sc.portal.kpi</field>
        <field name="arch" type="xml">
            <list string="KPI Cards">
                <field name="sequence" widget="handle"/>
                <field name="page_id"/>
                <field name="name"/>
                <field name="aggregate"/>
                <field name="target_model"/>
                <field name="measure_field"/>
                <field name="value_display" readonly="1"/>
                <field name="error" decoration-danger="error != ''" readonly="1"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_od19_sc_portal_kpi_form" model="ir.ui.view">
        <field name="name">od19.sc.portal.kpi.form</field>
        <field name="model">od19.sc.portal.kpi</field>
        <field name="arch" type="xml">
            <form string="KPI Card">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="เช่น อุปกรณ์ทั้งหมด"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="page_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="value_display" readonly="1"/>
                            <field name="error" readonly="1"
                                   decoration-danger="error != ''"/>
                        </group>
                    </group>
                    <group string="Source">
                        <field name="target_model"
                               placeholder="เช่น maintenance.equipment"/>
                        <field name="aggregate"/>
                        <field name="measure_field"
                               invisible="aggregate == 'count'"
                               required="aggregate != 'count'"
                               placeholder="เช่น id, amount_total"/>
                        <field name="domain_filter"
                               placeholder="[('state', '=', 'done')]"/>
                        <field name="unit" placeholder="เช่น รายการ"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== Actions ===================== -->
    <record id="action_od19_sc_portal_page" model="ir.actions.act_window">
        <field name="name">Portal Pages</field>
        <field name="res_model">od19.sc.portal.page</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                สร้างหน้าพอร์ทัลจากเทมเพลตที่ออกแบบไว้
            </p>
            <p>
                ผูกเทมเพลตหนึ่งชิ้นกับการ์ด KPI แล้วเผยแพร่ให้ลูกค้า/พนักงาน
                เปิดดูที่ <code>/my/service-center</code>
            </p>
        </field>
    </record>

    <record id="action_od19_sc_portal_kpi" model="ir.actions.act_window">
        <field name="name">KPI Cards</field>
        <field name="res_model">od19.sc.portal.kpi</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
