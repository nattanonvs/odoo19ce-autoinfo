<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_sales_project_tree" model="ir.ui.view">
        <field name="name">od19.sales.project.tree</field>
        <field name="model">od19.sales.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_owner_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_od19_sales_project_form" model="ir.ui.view">
        <field name="name">od19.sales.project.form</field>
        <field name="model">od19.sales.project</field>
        <field name="arch" type="xml">
            <form string="Sales Project">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="project_owner_id"/>
                        <field name="contractor_ids" widget="many2many_tags"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_od19_sales_project" model="ir.actions.act_window">
        <field name="name">Sales Projects</field>
        <field name="res_model">od19.sales.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_od19_sales_project"
        name="Sales Projects"
        parent="sale.sale_menu_root"
        action="action_od19_sales_project"
        sequence="90"
    />
</odoo>
