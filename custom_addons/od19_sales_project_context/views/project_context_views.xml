<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project search card for the "Sale Projects" menu. The core project
         search only offers "Project" (name); add the Job Number and the
         Analytic Account so a value like JB26 finds every project that
         carries it - either as the job number or as its analytic account. -->
    <record id="view_project_project_search_od19_sales" model="ir.ui.view">
        <field name="name">project.project.search.od19.sales</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search//field[@name='name']" position="before">
                <field name="job_no" string="Job Number"/>
                <field name="account_id" string="Analytic Account"/>
            </xpath>
        </field>
    </record>

    <record id="action_od19_sales_project" model="ir.actions.act_window">
        <field name="name">Sale Projects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="search_view_id" ref="view_project_project_search_od19_sales"/>
    </record>

    <menuitem
        id="menu_od19_sales_project"
        name="Sale Projects"
        parent="sale.sale_menu_root"
        action="action_od19_sales_project"
        sequence="34"
    />
</odoo>
