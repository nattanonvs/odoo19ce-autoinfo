<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_od19_project_context" model="ir.ui.view">
        <field name="name">sale.order.form.od19.project.context</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od19_sale_mode"/>
                <field name="od19_project_id"/>
                <field name="od19_project_owner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
