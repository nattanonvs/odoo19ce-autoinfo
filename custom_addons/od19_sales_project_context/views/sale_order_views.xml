<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_od19_project_context" model="ir.ui.view">
        <field name="name">sale.order.form.od19.project.context</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('od19_is_commercial_customer', '=', True)]</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od19_sale_mode"/>
                <field name="od19_project_id" domain="[('active', '=', True)]"/>
                <field
                    name="od19_project_owner_id"
                    domain="[('od19_is_project_owner', '=', True)]"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_project_pnl_analysis"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-line-chart"
                    title="Cost &amp; Profit Analysis"
                    invisible="not od19_project_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Cost &amp; Profit</span>
                        <span class="o_stat_text">Analysis</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
