<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== Search ===================== -->
    <record id="view_od19_health_watchdog_search" model="ir.ui.view">
        <field name="name">od19.health.watchdog.search</field>
        <field name="model">od19.health.watchdog</field>
        <field name="arch" type="xml">
            <search string="ตัวเฝ้าชั้นนอก">
                <field name="name"/>
                <field name="code"/>
                <field name="source"/>
                <filter name="filter_active" string="เปิดใช้งาน" domain="[('active', '=', True)]"/>
                <filter name="filter_stale" string="สัญญาณขาดตอน"
                        domain="[('last_status', 'in', ['warning', 'critical'])]"/>
                <filter name="filter_never" string="ยังไม่เคยรายงาน" domain="[('last_heartbeat', '=', False)]"/>
                <group name="groupby">
                    <filter name="group_last_status" string="สถานะที่รายงาน" context="{'group_by': 'last_status'}"/>
                    <filter name="group_source" string="ที่มา" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== List ===================== -->
    <record id="view_od19_health_watchdog_list" model="ir.ui.view">
        <field name="name">od19.health.watchdog.list</field>
        <field name="model">od19.health.watchdog</field>
        <field name="arch" type="xml">
            <list string="ตัวเฝ้าชั้นนอก"
                  decoration-danger="state == 'critical'"
                  decoration-warning="state == 'warning'"
                  decoration-muted="state == 'unknown'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="source" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'critical'"
                       decoration-warning="state == 'warning'"
                       decoration-success="state == 'ok'"
                       decoration-muted="state == 'unknown'"/>
                <field name="last_status"/>
                <field name="heartbeat_age_minutes"/>
                <field name="last_heartbeat"/>
                <field name="heartbeat_count" optional="hide"/>
                <field name="expected_interval_minutes" optional="hide"/>
                <field name="max_age_minutes" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ===================== Form ===================== -->
    <record id="view_od19_health_watchdog_form" model="ir.ui.view">
        <field name="name">od19.health.watchdog.form</field>
        <field name="model">od19.health.watchdog</field>
        <field name="arch" type="xml">
            <form string="ตัวเฝ้าชั้นนอก">
                <header>
                    <button name="action_report_ping" type="object" string="จำลองสัญญาณ (ping)"
                            class="btn-primary" icon="fa-heartbeat"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="unknown,ok,warning,critical"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="เก็บถาวร" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="ชื่อตัวเฝ้า"/>
                        <h1><field name="name" placeholder="เช่น Odoo19 Health Watch (Task Scheduler)"/></h1>
                    </div>
                    <group>
                        <group string="ข้อมูลตัวเฝ้า">
                            <field name="code" placeholder="machine_key"/>
                            <field name="source"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="เกณฑ์เวลา">
                            <field name="expected_interval_minutes"/>
                            <field name="max_age_minutes"/>
                        </group>
                    </group>
                    <group>
                        <group string="สัญญาณล่าสุด">
                            <field name="last_heartbeat"/>
                            <field name="heartbeat_age_minutes"/>
                            <field name="last_status"/>
                            <field name="heartbeat_count"/>
                        </group>
                        <group string="ข้อความล่าสุด">
                            <field name="last_message" nolabel="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="คำอธิบาย" name="description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="ข้อมูลที่รายงานเข้ามา (JSON)" name="payload">
                            <field name="last_payload" widget="json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== Kanban ===================== -->
    <record id="view_od19_health_watchdog_kanban" model="ir.ui.view">
        <field name="name">od19.health.watchdog.kanban</field>
        <field name="model">od19.health.watchdog</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="state"/>
                <field name="last_status"/>
                <field name="heartbeat_age_minutes"/>
                <field name="last_heartbeat"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <field name="state" widget="badge"
                                       decoration-danger="state == 'critical'"
                                       decoration-warning="state == 'warning'"
                                       decoration-success="state == 'ok'"
                                       decoration-muted="state == 'unknown'"/>
                            </div>
                            <div class="text-muted small mt-1"><field name="code"/></div>
                            <div class="mt-2">
                                <span class="text-muted small">อายุสัญญาณ (นาที): </span>
                                <field name="heartbeat_age_minutes"/>
                            </div>
                            <div class="text-muted small"><field name="last_heartbeat"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===================== Action ===================== -->
    <record id="action_od19_health_watchdog" model="ir.actions.act_window">
        <field name="name">ตัวเฝ้าชั้นนอก</field>
        <field name="res_model">od19.health.watchdog</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_od19_health_watchdog_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีตัวเฝ้าชั้นนอกรายงานเข้ามา</p>
            <p>สคริปต์ od19-health-watch.ps1 จะรายงานสัญญาณเข้ามาผ่าน /od19/health/heartbeat</p>
        </field>
    </record>

</odoo>
