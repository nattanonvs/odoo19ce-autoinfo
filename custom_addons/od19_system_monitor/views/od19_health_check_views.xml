<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== Search ===================== -->
    <record id="view_od19_health_check_search" model="ir.ui.view">
        <field name="name">od19.health.check.search</field>
        <field name="model">od19.health.check</field>
        <field name="arch" type="xml">
            <search string="การตรวจสุขภาพระบบ">
                <field name="name"/>
                <field name="code"/>
                <field name="cron_id"/>
                <filter name="filter_active" string="เปิดใช้งาน" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="ปิดใช้งาน" domain="[('active', '=', False)]"/>
                <group name="groupby">
                    <filter name="group_category" string="หมวด" context="{'group_by': 'category'}"/>
                    <filter name="group_check_type" string="ประเภท" context="{'group_by': 'check_type'}"/>
                    <filter name="group_last_state" string="สถานะล่าสุด" context="{'group_by': 'last_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== List ===================== -->
    <record id="view_od19_health_check_list" model="ir.ui.view">
        <field name="name">od19.health.check.list</field>
        <field name="model">od19.health.check</field>
        <field name="arch" type="xml">
            <list string="การตรวจสุขภาพระบบ"
                  decoration-danger="last_state == 'critical'"
                  decoration-warning="last_state == 'warning'"
                  decoration-success="last_state == 'ok'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="category"/>
                <field name="check_type"/>
                <field name="last_state" widget="badge"
                       decoration-danger="last_state == 'critical'"
                       decoration-warning="last_state == 'warning'"
                       decoration-success="last_state == 'ok'"
                       decoration-muted="last_state == 'unknown'"/>
                <field name="last_value_label" optional="show"/>
                <field name="last_run" optional="show"/>
                <field name="last_result_age_minutes" optional="hide"/>
                <field name="last_message" optional="hide"/>
                <field name="rule_count" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ===================== Form ===================== -->
    <record id="view_od19_health_check_form" model="ir.ui.view">
        <field name="name">od19.health.check.form</field>
        <field name="model">od19.health.check</field>
        <field name="arch" type="xml">
            <form string="การตรวจสุขภาพระบบ">
                <header>
                    <button name="action_run_now" type="object" string="ตรวจเดี๋ยวนี้"
                            class="btn-primary" icon="fa-play"/>
                    <button name="action_view_results" type="object" string="ดูผลการตรวจ"
                            icon="fa-history"/>
                    <field name="last_state" widget="statusbar" statusbar_visible="ok,warning,critical"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_results" type="object" class="oe_stat_button" icon="fa-list">
                            <div class="o_stat_info">
                                <span class="o_stat_text">ผลการตรวจ</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="เก็บถาวร" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="ชื่อการตรวจ"/>
                        <h1><field name="name" placeholder="เช่น คิวอีเมลค้างส่ง"/></h1>
                    </div>
                    <group>
                        <group string="ข้อมูลการตรวจ">
                            <field name="code" placeholder="machine_key"/>
                            <field name="category"/>
                            <field name="check_type"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="พารามิเตอร์">
                            <field name="interval_minutes"/>
                            <field name="max_age_minutes"/>
                            <field name="cron_id"
                                   invisible="check_type != 'cron_heartbeat'"
                                   required="check_type == 'cron_heartbeat'"/>
                            <field name="warning_threshold"/>
                            <field name="critical_threshold"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="สถานะล่าสุด" name="last_status">
                            <group>
                                <group>
                                    <field name="last_run"/>
                                    <field name="last_result_age_minutes"/>
                                    <field name="last_value"/>
                                    <field name="last_value_label"/>
                                </group>
                                <group>
                                    <field name="last_state"/>
                                    <field name="last_message"/>
                                </group>
                            </group>
                        </page>
                        <page string="เกณฑ์ (Rules)" name="rules">
                            <field name="rule_ids">
                                <list decoration-danger="severity in ('critical', 'emergency')"
                                      decoration-warning="severity == 'warning'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="metric"/>
                                    <field name="operator"/>
                                    <field name="threshold"/>
                                    <field name="threshold_text"/>
                                    <field name="severity" widget="badge"
                                           decoration-danger="severity in ('critical', 'emergency')"
                                           decoration-warning="severity == 'warning'"
                                           decoration-info="severity == 'info'"/>
                                    <field name="check_state"/>
                                    <field name="active" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="ผลการตรวจ (ล่าสุด)" name="results">
                            <field name="result_ids">
                                <list create="false" edit="false" decoration-danger="state == 'critical'"
                                      decoration-warning="state == 'warning'">
                                    <field name="run_at"/>
                                    <field name="state" widget="badge"
                                           decoration-danger="state == 'critical'"
                                           decoration-warning="state == 'warning'"
                                           decoration-success="state == 'ok'"/>
                                    <field name="severity"/>
                                    <field name="value_label"/>
                                    <field name="message"/>
                                    <field name="duration_ms"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== Kanban (การ์ดสุขภาพระบบ) ===================== -->
    <record id="view_od19_health_check_kanban" model="ir.ui.view">
        <field name="name">od19.health.check.kanban</field>
        <field name="model">od19.health.check</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="last_state"/>
                <field name="last_state_color"/>
                <field name="last_value_label"/>
                <field name="last_message"/>
                <field name="last_run"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <field name="last_state" widget="badge"
                                       decoration-danger="last_state == 'critical'"
                                       decoration-warning="last_state == 'warning'"
                                       decoration-success="last_state == 'ok'"
                                       decoration-muted="last_state == 'unknown'"/>
                            </div>
                            <div class="text-muted small mt-1">
                                <field name="code"/>
                            </div>
                            <div class="mt-2 fw-bold">
                                <field name="last_value_label"/>
                            </div>
                            <div class="text-muted small">
                                <field name="last_message"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===================== Graph (แนวโน้มผลการตรวจ) ===================== -->
    <record id="view_od19_health_check_graph" model="ir.ui.view">
        <field name="name">od19.health.check.graph</field>
        <field name="model">od19.health.check</field>
        <field name="arch" type="xml">
            <graph string="การตรวจสุขภาพระบบ" type="bar">
                <field name="category"/>
                <field name="last_state"/>
            </graph>
        </field>
    </record>

    <!-- ===================== Action ===================== -->
    <record id="action_od19_health_check" model="ir.actions.act_window">
        <field name="name">การตรวจสุขภาพระบบ</field>
        <field name="res_model">od19.health.check</field>
        <field name="view_mode">kanban,list,form,graph</field>
        <field name="search_view_id" ref="view_od19_health_check_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีการตรวจสุขภาพระบบ</p>
            <p>สร้างการตรวจเพื่อเฝ้าคิวงาน ขนาดฐานข้อมูล และตัวเฝ้าชั้นนอก</p>
        </field>
    </record>

</odoo>
