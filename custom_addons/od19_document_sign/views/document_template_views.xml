<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ===================== Template: list ===================== -->
    <record id="od19_document_template_list" model="ir.ui.view">
        <field name="name">od19.document.template.list</field>
        <field name="model">od19.document.template</field>
        <field name="arch" type="xml">
            <list string="Signing Templates">
                <field name="name"/>
                <field name="role_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ===================== Template: form ===================== -->
    <record id="od19_document_template_form" model="ir.ui.view">
        <field name="name">od19.document.template.form</field>
        <field name="model">od19.document.template</field>
        <field name="arch" type="xml">
            <form string="Signing Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Template Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Non-Disclosure Agreement"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Short description of this template"/>
                    </group>
                    <notebook>
                        <page string="Document Content" name="content">
                            <field name="body_html" widget="html" placeholder="Type the document content here..."/>
                        </page>
                        <page string="Signer Roles" name="roles">
                            <field name="role_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== Template: search ===================== -->
    <record id="od19_document_template_search" model="ir.ui.view">
        <field name="name">od19.document.template.search</field>
        <field name="model">od19.document.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ===================== Template: action ===================== -->
    <record id="action_od19_document_template" model="ir.actions.act_window">
        <field name="name">Signing Templates</field>
        <field name="res_model">od19.document.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="od19_document_template_search"/>
    </record>
</odoo>
