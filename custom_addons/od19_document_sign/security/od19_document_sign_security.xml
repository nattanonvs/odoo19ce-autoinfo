<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Privilege ===================== -->
    <record id="res_groups_privilege_od19_document_sign" model="res.groups.privilege">
        <field name="name">Document Signing</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="sequence">82</field>
    </record>

    <!-- ===================== Groups ===================== -->
    <record id="group_od19_document_sign_user" model="res.groups">
        <field name="name">Document Signing User</field>
        <field name="comment">Send documents for signature and follow their status.</field>
        <field name="privilege_id" ref="res_groups_privilege_od19_document_sign"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_od19_document_sign_manager" model="res.groups">
        <field name="name">Document Signing Manager</field>
        <field name="comment">Manage signing templates and every signing request.</field>
        <field name="privilege_id" ref="res_groups_privilege_od19_document_sign"/>
        <field name="implied_ids" eval="[Command.link(ref('group_od19_document_sign_user'))]"/>
    </record>

    <!-- System administrators inherit the manager role so the module is
         usable out of the box; business roles are granted per user. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_od19_document_sign_manager'))]"/>
    </record>

    <!-- ===================== Record rules: document ===================== -->
    <record id="rule_od19_document_company" model="ir.rule">
        <field name="name">Document: multi-company</field>
        <field name="model_id" ref="model_od19_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_document_sign_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_od19_document_manager" model="ir.rule">
        <field name="name">Document: manager full access</field>
        <field name="model_id" ref="model_od19_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_document_sign_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ===================== Record rules: signer ===================== -->
    <record id="rule_od19_document_signer_company" model="ir.rule">
        <field name="name">Signer: multi-company</field>
        <field name="model_id" ref="model_od19_document_signer"/>
        <field name="domain_force">[('document_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_document_sign_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_od19_document_signer_manager" model="ir.rule">
        <field name="name">Signer: manager full access</field>
        <field name="model_id" ref="model_od19_document_signer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_document_sign_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ===================== Record rules: template ===================== -->
    <record id="rule_od19_document_template_company" model="ir.rule">
        <field name="name">Signing template: multi-company</field>
        <field name="model_id" ref="model_od19_document_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_document_sign_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_od19_document_template_manager" model="ir.rule">
        <field name="name">Signing template: manager full access</field>
        <field name="model_id" ref="model_od19_document_template"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_document_sign_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
