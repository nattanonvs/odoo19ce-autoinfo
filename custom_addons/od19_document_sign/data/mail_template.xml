<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_document_sign_request" model="mail.template">
        <field name="name">Document Signing Request</field>
        <field name="model_id" ref="model_od19_document_signer"/>
        <field name="subject">ลงนามเอกสาร {{ object.document_id.name }}</field>
        <field name="email_from">{{ (object.document_id.company_id.partner_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>เรียนคุณ <t t-out="object.partner_id.name"/>,</p>
    <p>
        มีเอกสารรอการลงนามของคุณในฐานะ
        <strong t-out="object.role_name or 'ผู้ลงนาม'"/>
    </p>
    <table style="margin: 12px 0;">
        <tr>
            <td style="padding-right: 12px;">เลขที่เอกสาร</td>
            <td><strong t-out="object.document_id.name"/></td>
        </tr>
        <tr t-if="object.document_id.reference">
            <td style="padding-right: 12px;">อ้างอิง</td>
            <td t-out="object.document_id.reference"/>
        </tr>
        <tr t-if="object.document_id.date_deadline">
            <td style="padding-right: 12px;">กำหนดลงนามภายใน</td>
            <td><span t-field="object.document_id.date_deadline"/></td>
        </tr>
    </table>
    <p style="margin: 24px 0;">
        <a t-att-href="'%s?access_token=%s' % (object.access_url, object.access_token)"
           style="background-color:#9E2424;color:#ffffff;padding:10px 18px;border-radius:4px;text-decoration:none;">
            ลงนามเอกสาร
        </a>
    </p>
    <p>
        ขอแสดงความนับถือ,<br/>
        <t t-out="object.document_id.company_id.name"/>
    </p>
</div>
        </field>
    </record>
</odoo>
