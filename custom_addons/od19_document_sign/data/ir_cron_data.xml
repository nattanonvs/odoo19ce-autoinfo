<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_od19_document_expire" model="ir.cron">
        <field name="name">Document Signing: expire overdue requests</field>
        <field name="model_id" ref="model_od19_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_documents()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(DateTime.today() + relativedelta(days=1, hour=8, minute=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
