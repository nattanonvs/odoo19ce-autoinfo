<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Keep "Developer Tools" and "About" at the very bottom of the General
        Settings page.

        Odoo core places them last inside <app name="general_settings">, but
        other modules (od19_field_hints, od19_ai_assistant,
        od19_thai_localization_base, ...) append their own <block> at the end
        of the same app using position="inside", which pushes the core
        "Developer Tools" widget and the "About" section above them.

        This view is applied last (priority 99 > the default 16) so it can
        remove the two core nodes and re-append them at the very end of the app.
    -->
    <record id="res_config_settings_view_form_dev_about_last" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dev.about.last</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='res_config_dev_tool']" position="replace"/>
            <xpath expr="//div[@id='about']" position="replace"/>
            <xpath expr="//app[@name='general_settings']" position="inside">
                <widget name="res_config_dev_tool"/>
                <div id="about">
                    <block title="About" name="about_setting_container">
                        <widget name="res_config_edition"/>
                    </block>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
