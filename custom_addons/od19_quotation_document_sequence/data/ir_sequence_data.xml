            <field name="code">sale.quotation.ia</field>
            <field name="prefix">QI%(y)s%(month)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sale_quotation_fdes" model="ir.sequence">
            <field name="name">Quotation (QD), Dept : F/DES</field>
            <field name="code">sale.quotation.fdes</field>
