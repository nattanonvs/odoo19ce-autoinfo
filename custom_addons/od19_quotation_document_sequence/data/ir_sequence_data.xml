<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ==================== Quotation Sequences ==================== -->
        <record id="seq_sale_quotation_ba" model="ir.sequence">
            <field name="name">Quotation (QB), Dept : BA</field>
            <field name="code">sale.quotation.ba</field>
            <field name="prefix">QB%(y)s%(month)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sale_quotation_ta" model="ir.sequence">
            <field name="name">Quotation (QT), Dept : TA</field>
