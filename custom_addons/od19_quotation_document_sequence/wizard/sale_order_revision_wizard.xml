<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_revision_wizard" model="ir.ui.view">
        <field name="name">sale.order.revision.wizard.form</field>
        <field name="model">sale.order.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Quotation Revision">
                <sheet>
                    <group>
                        <field name="name" nolabel="1"/>
                    </group>
                    <group>
                        <field name="cancel_original"/>
                    </group>
                </sheet>
                <footer>
                    <button name="confirm" string="Create Revision" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
