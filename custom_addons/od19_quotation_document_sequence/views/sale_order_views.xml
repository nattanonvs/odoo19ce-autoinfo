<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sale_order_form_od19_seq" model="ir.ui.view">
            <field name="name">sale.order.form.od19.seq</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="department_id"/>
                </xpath>
                <xpath expr="//button[@name='action_confirm']" position="before">
                    <button
                        name="action_create_revision"
                        string="Create Revision"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', 'not in', ('draft', 'sent'))]}"
                    />
                    <button
                        name="action_view_revisions"
                        string="Revisions"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('revision_count', '=', 0)]}"
                    />
                </xpath>
            </field>
        </record>

        <record id="view_sale_order_tree_od19_seq" model="ir.ui.view">
            <field name="name">sale.order.list.od19.seq</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="department_id" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="view_sale_order_search_od19_seq" model="ir.ui.view">
            <field name="name">sale.order.search.od19.seq</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="department_id"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
