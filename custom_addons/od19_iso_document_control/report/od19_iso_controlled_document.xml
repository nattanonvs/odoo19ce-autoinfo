<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Controlled Document — Auto document generation (WP3)
         Assembles one PDF from:
           Page 1  Cover Page + History of Changes
           Page 2  Distribution List (active distribution list)
           Page 3  Document Stamp / Copy control
         The document's PDF attachments are concatenated after these
         pages by ir.actions.report._render_qweb_pdf.
    ============================================================ -->
    <record id="action_report_iso_controlled_document" model="ir.actions.report">
        <field name="name">เอกสารควบคุม (Controlled Document)</field>
        <field name="model">od19.iso.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">od19_iso_document_control.report_iso_controlled_document</field>
        <field name="report_file">od19_iso_document_control.report_iso_controlled_document</field>
        <field name="print_report_name">'%s' % (object.filename_pattern or object.code or 'ISO-Document')</field>
        <field name="binding_model_id" ref="model_od19_iso_document"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_iso_controlled_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="rev_history" t-value="o._get_revision_history()"/>
                <t t-set="distribution_lines" t-value="o._get_distribution_lines()"/>
                <t t-set="print_copies" t-value="o._get_print_copies()"/>
                <t t-set="qr_payload" t-value="'%s|Rev.%s' % (o.code or '', o.revision or '00')"/>
                <t t-call="web.external_layout">

                    <!-- ============ Page 1: Cover + History of Changes ============ -->
                    <div class="page">
                        <t t-if="o.print_cover_page">
                            <h2 class="text-center">เอกสารควบคุม (Controlled Document)</h2>
                            <table class="table table-sm table-borderless mt-3">
                                <tr>
                                    <td style="width:25%;"><strong>รหัสเอกสาร</strong></td>
                                    <td><span t-field="o.code"/></td>
                                    <td style="width:20%;"><strong>Revision</strong></td>
                                    <td><span t-field="o.revision"/></td>
                                </tr>
                                <tr>
                                    <td><strong>ชื่อเอกสาร</strong></td>
                                    <td colspan="3"><span t-field="o.document_title"/></td>
                                </tr>
                                <tr>
                                    <td><strong>ประเภทเอกสาร</strong></td>
                                    <td><span t-field="o.category_id"/></td>
                                    <td><strong>แผนก</strong></td>
                                    <td><span t-field="o.department_id"/></td>
                                </tr>
                                <tr>
                                    <td><strong>วันที่มีผล</strong></td>
                                    <td><span t-field="o.effective_date"/></td>
                                    <td><strong>ตรวจทานถัดไป</strong></td>
                                    <td><span t-field="o.review_date"/></td>
                                </tr>
                                <tr>
                                    <td><strong>มาตรฐาน ISO</strong></td>
                                    <td colspan="3">
                                        <span t-foreach="o.standard_ids" t-as="standard">
                                            <span t-field="standard.name"/>&#160;</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>ข้อ ISO</strong></td>
                                    <td colspan="3"><span t-field="o.iso_clause"/></td>
                                </tr>
                            </table>
                        </t>

                        <h4>ประวัติการแก้ไข (History of Changes)</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Revision</th>
                                    <th>วันที่มีผล</th>
                                    <th>ผู้อนุมัติ</th>
                                    <th>หมายเหตุ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rev_history" t-as="rev">
                                    <td><span t-field="rev.revision"/></td>
                                    <td><span t-field="rev.effective_date"/></td>
                                    <td><span t-field="rev.approved_by"/></td>
                                    <td><span t-field="rev.note"/></td>
                                </tr>
                                <tr t-if="not rev_history">
                                    <td colspan="4" class="text-center">— ไม่มีประวัติการแก้ไข —</td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="mt-4 border-top pt-1">
                            <t t-call="od19_iso_document_control.iso_footer">
                                <t t-set="iso_document" t-value="o"/>
                            </t>
                        </div>
                    </div>

                    <!-- ============ Page 2: Distribution List ============ -->
                    <div class="page">
                        <h4>ทะเบียนแจกจ่าย (Distribution List)</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>ผู้รับ</th>
                                    <th>แผนก</th>
                                    <th>จำนวนสำเนา</th>
                                    <th>ประเภท</th>
                                    <th>รับทราบ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="distribution_lines" t-as="line">
                                    <td><span t-esc="line_index + 1"/></td>
                                    <td>
                                        <span t-field="line.recipient_id"/>
                                        <span t-field="line.holder_name"/>
                                    </td>
                                    <td><span t-field="line.department_id"/></td>
                                    <td><span t-field="line.copies_required"/></td>
                                    <td><span t-field="line.copy_type"/></td>
                                    <td><span t-esc="'✓' if line.acknowledged else ''"/></td>
                                </tr>
                                <tr t-if="not distribution_lines">
                                    <td colspan="6" class="text-center">— ไม่มีทะเบียนแจกจ่ายที่ใช้งาน —</td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="mt-4 border-top pt-1">
                            <t t-call="od19_iso_document_control.iso_footer">
                                <t t-set="iso_document" t-value="o"/>
                            </t>
                        </div>
                    </div>

                    <!-- ============ Page 3: Document Stamp / Copy control ============ -->
                    <div class="page">
                        <h4>ตราประทับสำเนาควบคุม (Document Stamp)</h4>
                        <div style="border: 2px solid #000; padding: 10px; width: 380px;">
                            <div style="font-weight: bold; text-align: center;">CONTROLLED COPY</div>
                            <table class="table table-sm table-borderless mb-1">
                                <tr>
                                    <td><strong>เอกสาร</strong></td>
                                    <td><span t-field="o.code"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Revision</strong></td>
                                    <td><span t-field="o.revision"/></td>
                                </tr>
                                <tr>
                                    <td><strong>วันที่มีผล</strong></td>
                                    <td><span t-field="o.effective_date"/></td>
                                </tr>
                            </table>
                            <div style="text-align: center;">
                                <img t-attf-src="/report/barcode/QR/{{qr_payload}}?&amp;width=110&amp;height=110&amp;quiet=0" alt="QR Code"/>
                            </div>
                            <div style="font-size: 9px; text-align: center; margin-top: 4px;">
                                UNCONTROLLED WHEN PRINTED
                            </div>
                        </div>

                        <h4 class="mt-3">สำเนาควบคุมที่เกี่ยวข้อง</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>เลขสำเนา</th>
                                    <th>ประเภท</th>
                                    <th>ผู้ถือครอง</th>
                                    <th>วันจ่าย</th>
                                    <th>สถานะ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="print_copies" t-as="copy">
                                    <td><span t-field="copy.name"/></td>
                                    <td><span t-field="copy.copy_type"/></td>
                                    <td>
                                        <span t-field="copy.holder_id"/>
                                        <span t-field="copy.holder_name"/>
                                    </td>
                                    <td><span t-field="copy.issue_date"/></td>
                                    <td><span t-field="copy.state"/></td>
                                </tr>
                                <tr t-if="not print_copies">
                                    <td colspan="5" class="text-center">— ยังไม่มีสำเนาควบคุม —</td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="mt-4 border-top pt-1">
                            <t t-call="od19_iso_document_control.iso_footer">
                                <t t-set="iso_document" t-value="o"/>
                            </t>
                        </div>
                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
