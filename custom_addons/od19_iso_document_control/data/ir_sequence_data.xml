<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        ISO Document sequences.
        Each document category (prefix) has its own numeric sequence.
        The document code is assembled as {PREFIX}-{DEPT}-{NNN} in code.
    -->

    <record id="seq_iso_doc_fm" model="ir.sequence">
        <field name="name">ISO Document - Form (FM)</field>
        <field name="code">od19.iso.document.fm</field>
        <field name="prefix"></field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

