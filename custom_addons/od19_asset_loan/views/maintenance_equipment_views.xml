<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend equipment form to add loan fields -->
    <record id="maintenance_equipment_view_form_inherit_loan" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.loan</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="before">
                <field name="is_loanable"/>
                <field name="asset_id"/>
                <field name="calibration_date"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_loans" type="object"
                        class="oe_stat_button" icon="fa-exchange">
                    <field name="loan_count" widget="statinfo" string="Loans"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
