<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="asset_loan_line_view_tree" model="ir.ui.view">
        <field name="name">asset.loan.line.tree</field>
        <field name="model">asset.loan.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="loan_id"/>
                <field name="equipment_id"/>
                <field name="quantity"/>
                <field name="returned_quantity"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="asset_loan_line_view_form" model="ir.ui.view">
        <field name="name">asset.loan.line.form</field>
        <field name="model">asset.loan.line</field>
        <field name="arch" type="xml">
            <form string="Loan Line">
                <group>
                    <field name="loan_id"/>
                    <field name="equipment_id"/>
                    <field name="quantity"/>
                    <field name="returned_quantity"/>
                    <field name="state"/>
                    <field name="note"/>
                </group>
            </form>
        </field>
    </record>

</odoo>
