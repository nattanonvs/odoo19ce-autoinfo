<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Record rule: users see all loans, but only managers can unlink -->
    <record id="asset_loan_rule_company" model="ir.rule">
        <field name="name">Asset Loan: multi-company</field>
        <field name="model_id" ref="model_asset_loan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>
