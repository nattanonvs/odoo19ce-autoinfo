<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_asset_loan_due_reminder" model="ir.cron">
        <field name="name">Asset Loan: Due Reminders</field>
        <field name="model_id" ref="model_asset_loan"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_due_reminders(days=1)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_asset_loan_overdue_alert" model="ir.cron">
        <field name="name">Asset Loan: Overdue Alerts</field>
        <field name="model_id" ref="model_asset_loan"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_overdue_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_equipment_calibration_reminder" model="ir.cron">
        <field name="name">Equipment: Calibration Reminders</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_calibration_reminders(days=7)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
