<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_inventory_accuracy_list" model="ir.ui.view">
        <field name="name">od19.report.inventory.accuracy.list</field>
        <field name="model">od19.report.inventory.accuracy</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="session_id"/>
                <field name="location_id"/>
                <field name="state"/>
                <field name="line_count"/>
                <field name="variance_line_count"/>
                <field name="total_variance_qty"/>
            </list>
        </field>
    </record>

    <record id="action_od19_inventory_accuracy_report" model="ir.actions.act_window">
        <field name="name">Inventory Accuracy</field>
        <field name="res_model">od19.report.inventory.accuracy</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No count sessions yet.
            </p>
        </field>
    </record>

    <menuitem id="menu_od19_inventory_accuracy_report"
              name="Inventory Accuracy"
              parent="stock.menu_warehouse_report"
              action="action_od19_inventory_accuracy_report"
              groups="stock.group_stock_manager"
              sequence="60"/>
</odoo>
