<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_inventory_movement_backlog_list" model="ir.ui.view">
        <field name="name">od19.report.inventory.movement.backlog.list</field>
        <field name="model">od19.report.inventory.movement.backlog</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="picking_id"/>
                <field name="flow_class"/>
                <field name="execution_state"/>
                <field name="reference_document"/>
            </list>
        </field>
    </record>

    <record id="action_od19_inventory_movement_backlog_report" model="ir.actions.act_window">
        <field name="name">Inventory Movement Backlog</field>
        <field name="res_model">od19.report.inventory.movement.backlog</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending stock movements.
            </p>
        </field>
    </record>

    <menuitem id="menu_od19_inventory_movement_backlog_report"
              name="Movement Backlog"
              parent="stock.menu_warehouse_report"
              action="action_od19_inventory_movement_backlog_report"
              groups="stock.group_stock_manager"
              sequence="65"/>
</odoo>
