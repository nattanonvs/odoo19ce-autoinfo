<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_od19_ewht_submission" model="ir.sequence">
        <field name="name">e-Withholding Tax Submission</field>
        <field name="code">od19.ewht.submission</field>
        <field name="prefix">EWHT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_od19_ewht_submission_list" model="ir.ui.view">
        <field name="name">od19.ewht.submission.list</field>
        <field name="model">od19.ewht.submission</field>
        <field name="arch" type="xml">
            <list string="e-WHT Submissions">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="channel"/>
                <field name="submitted_at"/>
                <field name="attempt_count"/>
                <field name="reference"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'accepted'"
                       decoration-warning="state == 'rejected'"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_od19_ewht_submission_form" model="ir.ui.view">
        <field name="name">od19.ewht.submission.form</field>
        <field name="model">od19.ewht.submission</field>
        <field name="arch" type="xml">
            <form string="e-WHT Submission">
                <header>
                    <field name="od19_ewht_enabled" invisible="1"/>
                    <button name="action_submit" type="object"
                            string="Submit to Bank" class="btn-primary"
                            invisible="state not in ('draft', 'failed', 'rejected') or not od19_ewht_enabled"/>
                    <button name="action_retry" type="object"
                            string="Retry"
                            invisible="state not in ('failed', 'rejected') or not od19_ewht_enabled"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,accepted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Submission Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="channel"/>
                            <field name="submitted_at"/>
                            <field name="attempt_count"/>
                        </group>
                        <group>
                            <field name="reference"/>
                            <field name="response_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Withholding Records" name="records">
                            <field name="move_ids">
                                <list string="Withholding Records" create="false">
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="amount_income"/>
                                    <field name="amount_wht"/>
                                    <field name="wht_tax_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Response" name="response">
                            <group>
                                <field name="response_message" nolabel="1"
                                       readonly="1"/>
                                <field name="note" placeholder="Internal note"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_od19_ewht_submission_search" model="ir.ui.view">
        <field name="name">od19.ewht.submission.search</field>
        <field name="model">od19.ewht.submission</field>
        <field name="arch" type="xml">
            <search string="e-WHT Submissions">
                <field name="name"/>
                <field name="reference"/>
                <field name="move_ids"/>
                <filter string="Accepted" name="accepted"
                        domain="[('state', '=', 'accepted')]"/>
                <filter string="Failed or Rejected" name="problem"
                        domain="[('state', 'in', ('failed', 'rejected'))]"/>
                <group>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Channel" name="group_channel"
                            context="{'group_by': 'channel'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_od19_ewht_submission" model="ir.actions.act_window">
        <field name="name">e-WHT Submissions</field>
        <field name="res_model">od19.ewht.submission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_od19_ewht_submission_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first e-Withholding Tax submission
            </p>
            <p>
                Group the withholding records (ภาษีหัก ณ ที่จ่าย) and hand them
                over to the bank's e-Withholding Tax service.
            </p>
        </field>
    </record>

</odoo>
