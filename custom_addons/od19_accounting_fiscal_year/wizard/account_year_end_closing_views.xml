<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_year_end_closing_form" model="ir.ui.view">
        <field name="name">account.year.end.closing.form</field>
        <field name="model">account.year.end.closing</field>
        <field name="arch" type="xml">
            <form string="Year-End Closing">
                <group>
                    <group>
                        <field name="fiscal_year_id"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="retained_earnings_account_id"/>
                        <field name="journal_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_close_fiscal_year" type="object"
                            string="Close Fiscal Year" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
