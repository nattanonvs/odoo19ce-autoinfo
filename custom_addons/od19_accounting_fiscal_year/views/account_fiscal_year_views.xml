<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_fiscal_year_list" model="ir.ui.view">
        <field name="name">account.fiscal.year.list</field>
        <field name="model">account.fiscal.year</field>
        <field name="arch" type="xml">
            <list string="Fiscal Years">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'open'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_account_fiscal_year_form" model="ir.ui.view">
        <field name="name">account.fiscal.year.form</field>
        <field name="model">account.fiscal.year</field>
        <field name="arch" type="xml">
            <form string="Fiscal Year">
                <header>
                    <button name="action_open" type="object" string="Open"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'open'"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_from"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_fiscal_year_search" model="ir.ui.view">
        <field name="name">account.fiscal.year.search</field>
        <field name="model">account.fiscal.year</field>
        <field name="arch" type="xml">
            <search string="Search Fiscal Years">
                <field name="name"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
            </search>
        </field>
    </record>

    <record id="action_account_fiscal_year" model="ir.actions.act_window">
        <field name="name">Fiscal Years</field>
        <field name="res_model">account.fiscal.year</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_account_year_end_closing" model="ir.actions.act_window">
        <field name="name">Year-End Closing</field>
        <field name="res_model">account.year.end.closing</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_account_fiscal_year"
        name="Fiscal Years"
        parent="account.menu_finance_configuration"
        action="action_account_fiscal_year"
        sequence="80"
    />

    <menuitem
        id="menu_account_year_end_closing"
        name="Year-End Closing"
        parent="account.menu_finance"
        action="action_account_year_end_closing"
        sequence="85"
    />

</odoo>
