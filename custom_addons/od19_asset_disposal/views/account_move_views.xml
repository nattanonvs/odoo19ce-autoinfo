<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ============================================================ -->
    <!-- Bill form: choose an existing asset to merge the line value  -->
    <!-- into instead of creating a new asset (multi-bill support).   -->
    <!-- ============================================================ -->
    <record id="view_move_form_od19_merge_asset" model="ir.ui.view">
        <field name="name">account.move.form.od19.merge.asset</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <!-- Bill lines (list) -->
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='asset_profile_id']"
                position="before"
            >
                <field
                    name="od19_target_asset_id"
                    column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"
                    domain="[('company_id', '=', parent.company_id)]"
                    optional="show"
                    groups="account.group_account_invoice"
                />
            </xpath>

            <!-- Bill lines (form) -->
            <xpath
                expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='asset_profile_id']"
                position="before"
            >
                <field
                    name="od19_target_asset_id"
                    invisible="parent.move_type not in ('in_invoice', 'in_refund')"
                    domain="[('company_id', '=', parent.company_id)]"
                    groups="account.group_account_invoice"
                />
            </xpath>

            <!-- Journal items -->
            <xpath
                expr="//notebook//field[@name='line_ids']/list/field[@name='asset_profile_id']"
                position="before"
            >
                <field
                    name="od19_target_asset_id"
                    domain="[('company_id', '=', parent.company_id)]"
                    optional="hide"
                    groups="account.group_account_invoice"
                />
            </xpath>

        </field>
    </record>

</odoo>
