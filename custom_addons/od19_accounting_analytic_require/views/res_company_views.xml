<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_company_form_analytic_require" model="ir.ui.view">
        <field name="name">res.company.form.analytic.require</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='branches']" position="after">
                <page string="Accounting" name="accounting_setup">
                    <group string="Analytic Requirement">
                        <field name="od19_analytic_required_account_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="od19_analytic_require_journal_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
