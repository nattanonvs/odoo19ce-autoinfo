<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form_analytic_warning" model="ir.ui.view">
        <field name="name">account.move.form.analytic.warning</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']" position="before">
                <div class="alert alert-info" role="alert"
                     invisible="journal_id.od19_analytic_require or False">
                    <strong>Note:</strong> Analytic account may be required for some accounts in this entry.
                </div>
            </xpath>
        </field>
    </record>

</odoo>
