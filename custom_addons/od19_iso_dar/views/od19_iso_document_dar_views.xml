<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_iso_document_form_dar_button" model="ir.ui.view">
        <field name="name">od19.iso.document.form.dar.button</field>
        <field name="model">od19.iso.document</field>
        <field name="inherit_id" ref="od19_iso_document_control.view_iso_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_dar"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o">
                        <field name="dar_count" widget="statinfo" string="ใบ DAR"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
