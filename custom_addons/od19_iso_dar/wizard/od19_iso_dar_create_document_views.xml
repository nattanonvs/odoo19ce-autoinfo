<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_od19_iso_dar_create_document_form" model="ir.ui.view">
        <field name="name">od19.iso.dar.create.document.form</field>
        <field name="model">od19.iso.dar.create.document</field>
        <field name="arch" type="xml">
            <form string="สร้างเอกสารใหม่จาก DAR">
                <group>
                    <field name="document_title"/>
                    <field name="category_id"/>
                    <field name="department_id"/>
                    <field name="revision"/>
                    <field name="dar_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_create_document" type="object"
                            string="สร้างเอกสาร" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
