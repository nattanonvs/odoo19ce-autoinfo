<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_od19_iso_print" model="ir.module.category">
        <field name="name">ISO Print &amp; Distribution Control</field>
        <field name="sequence">93</field>
    </record>

    <record id="privilege_od19_iso_print" model="res.groups.privilege">
        <field name="name">ISO Print &amp; Distribution Control</field>
        <field name="category_id" ref="module_category_od19_iso_print"/>
    </record>

    <record id="group_iso_print_user" model="res.groups">
        <field name="name">ISO Print User</field>
        <field name="privilege_id" ref="privilege_od19_iso_print"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_iso_print_controller" model="res.groups">
        <field name="name">ISO Print Controller (DCC)</field>
        <field name="privilege_id" ref="privilege_od19_iso_print"/>
        <field name="implied_ids" eval="[(4, ref('group_iso_print_user'))]"/>
    </record>

    <record id="group_iso_print_manager" model="res.groups">
        <field name="name">ISO Print Manager</field>
        <field name="privilege_id" ref="privilege_od19_iso_print"/>
        <field name="implied_ids" eval="[(4, ref('group_iso_print_controller'))]"/>
    </record>

</odoo>
