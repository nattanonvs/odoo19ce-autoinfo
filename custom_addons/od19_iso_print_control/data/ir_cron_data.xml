<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="action_server_copy_return_overdue" model="ir.actions.server">
        <field name="name">ISO Print Copy: Overdue Return Reminder</field>
        <field name="model_id" ref="model_od19_iso_print_copy"/>
        <field name="state">code</field>
        <field name="code">model._cron_copy_return_overdue()</field>
    </record>

    <record id="ir_cron_copy_return_overdue" model="ir.cron">
        <field name="name">ISO Print Copy: Overdue Return Reminder</field>
        <field name="ir_actions_server_id" ref="action_server_copy_return_overdue"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
