<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- เลขที่ใบขอพิมพ์: PRN{ปี ค.ศ. 2 หลัก}-{NNN} เช่น PRN26-001 -->
    <record id="seq_iso_print_request" model="ir.sequence">
        <field name="name">ISO Print Request (PDR)</field>
        <field name="code">od19.iso.print.request</field>
        <field name="prefix"></field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- เลขที่ทะเบียนแจกจ่าย: DL{ปี ค.ศ. 2 หลัก}-{NNN} เช่น DL26-001 -->
    <record id="seq_iso_distribution_list" model="ir.sequence">
        <field name="name">ISO Distribution List</field>
        <field name="code">od19.iso.distribution.list</field>
        <field name="prefix"></field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
