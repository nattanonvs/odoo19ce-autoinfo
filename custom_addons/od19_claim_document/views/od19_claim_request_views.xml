<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_claim_request_tree" model="ir.ui.view">
        <field name="name">od19.claim.request.tree</field>
        <field name="model">od19.claim.request</field>
        <field name="arch" type="xml">
            <list string="แฟ้มเรื่องเรียกร้อง">
                <field name="name"/>
                <field name="request_date"/>
                <field name="claim_type"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="department_id"/>
                <field name="user_id"/>
                <field name="attachment_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_od19_claim_request_form" model="ir.ui.view">
        <field name="name">od19.claim.request.form</field>
        <field name="model">od19.claim.request</field>
        <field name="arch" type="xml">
            <form string="เรื่องเรียกร้อง">
                <header>
                    <button name="action_submit" type="object" string="ยื่นเรื่อง"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="อนุมัติ"
                            class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_close" type="object" string="ปิดเรื่อง"
                            invisible="state not in ('submitted', 'approved')"/>
                    <button name="action_cancel" type="object" string="ยกเลิก"
                            invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="กลับเป็นฉบับร่าง"
                            invisible="state == 'draft'"/>
                    <button name="action_print_form" type="object" string="พิมพ์แบบฟอร์ม"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="claim_type"/>
                            <field name="subject"/>
                            <field name="partner_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="request_date"/>
                            <field name="form_id"/>
                            <field name="source_ref"/>
                        </group>
                    </group>
                    <group>
                        <group string="การจัดเก็บเอกสาร">
                            <field name="category_id"/>
                            <field name="retention_policy_id"/>
                            <field name="legal_hold"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="รายละเอียด">
                            <field name="description"/>
                        </page>
                        <page string="ไฟล์แนบ/หลักฐาน">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_od19_claim_request_search" model="ir.ui.view">
        <field name="name">od19.claim.request.search</field>
        <field name="model">od19.claim.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="form_id"/>
                <filter name="filter_draft" string="ฉบับร่าง" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_closed" string="ปิดเรื่อง" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_legal_hold" string="ห้ามทำลาย" domain="[('legal_hold', '=', True)]"/>
                <group>
                    <filter name="group_claim_type" string="ชนิดเรื่องเรียกร้อง"
                            context="{'group_by': 'claim_type'}"/>
                    <filter name="group_state" string="สถานะ"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_department" string="แผนก"
                            context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_od19_claim_request" model="ir.actions.act_window">
        <field name="name">แฟ้มเรื่องเรียกร้อง</field>
        <field name="res_model">od19.claim.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
