<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_sales_project_revenue_report_tree" model="ir.ui.view">
        <field name="name">od19.sales.project.revenue.report.tree</field>
        <field name="model">od19.sales.project.revenue.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="commercial_customer_id"/>
                <field name="project_owner_id"/>
                <field name="order_count"/>
                <field name="amount_untaxed"/>
            </list>
        </field>
    </record>

    <record id="action_od19_sales_project_revenue_report" model="ir.actions.act_window">
        <field name="name">Project Revenue Overview</field>
        <field name="res_model">od19.sales.project.revenue.report</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No project revenue data yet.
            </p>
        </field>
    </record>

    <menuitem id="menu_od19_sales_project_revenue_report"
              name="Project Revenue"
              parent="sale.menu_sale_report"
              action="action_od19_sales_project_revenue_report"
              groups="sales_team.group_sale_manager,account.group_account_manager"
              sequence="50"/>
</odoo>
