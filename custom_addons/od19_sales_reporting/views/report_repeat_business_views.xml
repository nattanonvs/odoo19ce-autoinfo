<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_sales_repeat_business_report_tree" model="ir.ui.view">
        <field name="name">od19.sales.repeat.business.report.tree</field>
        <field name="model">od19.sales.repeat.business.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="commercial_customer_id"/>
                <field name="project_owner_id"/>
                <field name="project_count"/>
                <field name="sale_order_count"/>
            </list>
        </field>
    </record>

    <record id="action_od19_sales_repeat_business_report" model="ir.actions.act_window">
        <field name="name">Repeat Business</field>
        <field name="res_model">od19.sales.repeat.business.report</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No repeat business data yet.
            </p>
        </field>
    </record>

    <menuitem id="menu_od19_sales_repeat_business_report"
              name="Repeat Business"
              parent="sale.menu_sale_report"
              action="action_od19_sales_repeat_business_report"
              groups="sales_team.group_sale_manager,account.group_account_manager"
              sequence="55"/>
</odoo>
