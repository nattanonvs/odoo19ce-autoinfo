<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Repeat Business Report -->
    <record id="od19_sales_repeat_business_report_company_rule" model="ir.rule">
        <field name="name">OD19 Sales Repeat Business Report: multi-company</field>
        <field name="model_id" ref="model_od19_sales_repeat_business_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="od19_sales_repeat_business_report_manager_rule" model="ir.rule">
        <field name="name">OD19 Sales Repeat Business Report: managers see all</field>
        <field name="model_id" ref="model_od19_sales_repeat_business_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('account.group_account_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Sales Project Revenue Report -->
    <record id="od19_sales_project_revenue_report_company_rule" model="ir.rule">
        <field name="name">OD19 Sales Project Revenue Report: multi-company</field>
        <field name="model_id" ref="model_od19_sales_project_revenue_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="od19_sales_project_revenue_report_manager_rule" model="ir.rule">
        <field name="name">OD19 Sales Project Revenue Report: managers see all</field>
        <field name="model_id" ref="model_od19_sales_project_revenue_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('account.group_account_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
