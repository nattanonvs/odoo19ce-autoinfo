<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wht_type_tree" model="ir.ui.view">
        <field name="name">wht.type.tree</field>
        <field name="model">wht.type</field>
        <field name="arch" type="xml">
            <list string="Withholding Tax Types">
                <field name="name"/>
                <field name="percent" widget="percentage"/>
                <field name="account_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wht_type_form" model="ir.ui.view">
        <field name="name">wht.type.form</field>
        <field name="model">wht.type</field>
        <field name="arch" type="xml">
            <form string="Withholding Tax Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="percent" widget="percentage"/>
                        </group>
                        <group>
                            <field name="account_id"/>
                            <field name="active" optional="hide"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wht_type_search" model="ir.ui.view">
        <field name="name">wht.type.search</field>
        <field name="model">wht.type</field>
        <field name="arch" type="xml">
            <search string="Search Withholding Tax Types">
                <field name="name"/>
                <field name="account_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_wht_type" model="ir.actions.act_window">
        <field name="name">Withholding Tax Types</field>
        <field name="res_model">wht.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define withholding tax types
            </p>
        </field>
    </record>

    <menuitem
        id="menu_wht_type"
        name="Withholding Tax Types"
        parent="account.menu_finance_configuration"
        action="action_wht_type"
        sequence="30"
    />

</odoo>
