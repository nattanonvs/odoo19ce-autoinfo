<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_form_inherit_wht" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.wht</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="wht_type_id" options="{'no_create': True}"/>
                <field name="wht_base_amount" invisible="not wht_type_id"/>
                <field name="wht_amount" invisible="not wht_type_id"/>
                <field name="wht_net_amount" invisible="not wht_type_id"/>
            </xpath>
        </field>
    </record>

</odoo>
