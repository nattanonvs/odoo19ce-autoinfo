<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_company_form_inherit_supplier_quality" model="ir.ui.view">
        <field name="name">res.company.form.inherit.supplier.quality</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="enable_supplier_quality_block"/>
            </xpath>
        </field>
    </record>

</odoo>
