<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_res_partner_customer" model="ir.sequence">
            <field name="name">Customer Master</field>
            <field name="code">res.partner</field>
            <field name="prefix">C</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_res_partner_vendor" model="ir.sequence">
            <field name="name">Vendor Master</field>
            <field name="code">res.partner.vendor</field>
            <field name="prefix">V</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
