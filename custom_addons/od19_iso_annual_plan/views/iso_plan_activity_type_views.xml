<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_iso_plan_activity_type_tree" model="ir.ui.view">
        <field name="name">od19.iso.plan.activity.type.tree</field>
        <field name="model">od19.iso.plan.activity.type</field>
        <field name="arch" type="xml">
            <list string="ประเภทกิจกรรมแผนงาน ISO" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_frequency"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_iso_plan_activity_type_form" model="ir.ui.view">
        <field name="name">od19.iso.plan.activity.type.form</field>
        <field name="model">od19.iso.plan.activity.type</field>
        <field name="arch" type="xml">
            <form string="ประเภทกิจกรรมแผนงาน ISO">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="default_frequency"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iso_plan_activity_type" model="ir.actions.act_window">
        <field name="name">ประเภทกิจกรรมแผนงาน ISO</field>
        <field name="res_model">od19.iso.plan.activity.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
