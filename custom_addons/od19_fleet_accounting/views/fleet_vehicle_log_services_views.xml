<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Fleet Vehicle Log Services Form View -->
    <record id="fleet_vehicle_log_services_view_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.form.inherit.od19</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vendor_id']" position="after">
                <field name="expense_category_id"/>
                <field name="department_id"/>
                <field name="analytic_account_id"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Fleet Vehicle Log Services List View -->
    <record id="fleet_vehicle_log_services_view_list_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.list.inherit.od19</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_tree"/>
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="expense_category_id" optional="hide"/>
                <field name="department_id" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
