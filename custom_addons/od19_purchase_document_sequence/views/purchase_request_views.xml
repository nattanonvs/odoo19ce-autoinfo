<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_purchase_request_form_od19_seq" model="ir.ui.view">
            <field name="name">purchase.request.form.od19.seq</field>
            <field name="model">purchase.request</field>
            <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='requested_by']" position="after">
                    <field name="department_id"/>
                </xpath>
            </field>
        </record>

        <record id="view_purchase_request_tree_od19_seq" model="ir.ui.view">
            <field name="name">purchase.request.list.od19.seq</field>
            <field name="model">purchase.request</field>
            <field name="inherit_id" ref="purchase_request.view_purchase_request_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='requested_by']" position="after">
                    <field name="department_id" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="view_purchase_request_search_od19_seq" model="ir.ui.view">
            <field name="name">purchase.request.search.od19.seq</field>
            <field name="model">purchase.request</field>
            <field name="inherit_id" ref="purchase_request.view_purchase_request_search"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="department_id"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
