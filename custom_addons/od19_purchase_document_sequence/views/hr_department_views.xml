<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_department_form_inherit_od19_seq" model="ir.ui.view">
            <field name="name">hr.department.form.inherit.od19.seq</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/group" position="after">
                    <group string="Document Sequences">
                        <group string="Purchase">
                            <field name="code"/>
                            <field name="pr_sequence_id"/>
                            <field name="po_sequence_id"/>
                            <field name="po_indent_sequence_id"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
