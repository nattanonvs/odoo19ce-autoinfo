        <field name="name">Customer Credit Gate</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">60</field>
    </record>

    <record id="group_od19_credit_reviewer" model="res.groups">
        <field name="name">Credit Reviewer</field>
