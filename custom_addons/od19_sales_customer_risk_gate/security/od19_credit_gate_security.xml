        <field name="privilege_id" ref="res_groups_privilege_od19_credit_gate"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="implied_by_ids" eval="[Command.link(ref('account.group_account_manager'))]"/>
    </record>
</odoo>
