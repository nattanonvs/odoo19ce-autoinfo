<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_credit_gate_event_tree" model="ir.ui.view">
        <field name="name">od19.credit.gate.event.tree</field>
        <field name="model">od19.credit.gate.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="reason_code"/>
                <field name="stage"/>
                <field name="order_ref"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_od19_credit_gate_event_search" model="ir.ui.view">
        <field name="name">od19.credit.gate.event.search</field>
        <field name="model">od19.credit.gate.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="reason_code"/>
                <field name="stage"/>
                <filter string="Blacklist" name="od19_reason_blacklist"
                        domain="[('reason_code','=','blacklist')]"/>
                <filter string="Credit" name="od19_reason_credit"
                        domain="[('reason_code','=','credit')]"/>
                <group name="group_by">
                    <filter string="Reason" name="group_reason" context="{'group_by':'reason_code'}"/>
                    <filter string="Stage" name="group_stage" context="{'group_by':'stage'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_od19_credit_gate_event" model="ir.actions.act_window">
        <field name="name">Credit Gate Events</field>
        <field name="res_model">od19.credit.gate.event</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_od19_credit_gate_event_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No blocked sales yet.
            </p>
        </field>
    </record>

    <record id="view_res_partner_credit_pending_tree" model="ir.ui.view">
        <field name="name">res.partner.credit.pending.tree</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='complete_name']" position="after">
                <field name="od19_credit_request_state" optional="show"/>
                <field name="od19_credit_request_date" optional="show"/>
                <field name="od19_credit_review_owner_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="action_res_partner_credit_pending" model="ir.actions.act_window">
        <field name="name">Credit Pending Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('od19_credit_request_state','=','pending')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No customers pending credit review.
            </p>
        </field>
    </record>

    <menuitem id="menu_od19_credit_gate"
              name="Credit Gate"
              parent="sale.menu_sale_report"
              sequence="60"/>

    <menuitem id="menu_od19_credit_gate_events"
              name="Blocked Sales"
              parent="menu_od19_credit_gate"
              action="action_od19_credit_gate_event"
              sequence="10"/>

    <menuitem id="menu_od19_credit_pending"
              name="Credit Pending"
              parent="menu_od19_credit_gate"
              action="action_res_partner_credit_pending"
              sequence="20"/>
</odoo>
