<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_od19_credit_gate" model="ir.ui.view">
        <field name="name">sale.order.form.od19.credit.gate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-danger"
                     role="alert"
                     invisible="not od19_gate_blocked_reason">
                    <field name="od19_gate_blocked_reason" readonly="1"/>
                </div>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od19_is_credit_sale"
                       widget="boolean_toggle"
                       readonly="1"
                       invisible="1"/>
            </xpath>

            <xpath expr="//page[@name='other_information']" position="inside">
                <group string="Credit &amp; Risk Gate">
                    <field name="od19_is_credit_sale"/>
                    <field name="od19_risk_status_snapshot"/>
                    <field name="od19_credit_state_snapshot"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_order_search_od19_credit_gate" model="ir.ui.view">
        <field name="name">sale.order.search.od19.credit.gate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter string="Credit sale" name="od19_credit_sale"
                        domain="[('od19_is_credit_sale','=',True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
