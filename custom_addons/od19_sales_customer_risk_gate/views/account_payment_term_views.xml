<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_term_form_od19_credit_gate" model="ir.ui.view">
        <field name="name">account.payment.term.form.od19.credit.gate</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/field[@name='company_id']" position="after">
                <field name="od19_is_credit_term" groups="account.group_account_manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_payment_term_tree_od19_credit_gate" model="ir.ui.view">
        <field name="name">account.payment.term.list.od19.credit.gate</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="od19_is_credit_term" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
