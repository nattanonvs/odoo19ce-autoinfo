<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_od19_scan_page_tree" model="ir.ui.view">
        <field name="name">od19.scan.page.tree</field>
        <field name="model">od19.scan.page</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="image" widget="od19_camera" filename="image_filename" options="{'preview_image': 'image'}"/>
                <field name="image_filename" invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'error'"/>
                <field name="ocr_engine" readonly="1"/>
                <field name="error_message" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_od19_scan_article_wizard_form" model="ir.ui.view">
        <field name="name">od19.scan.article.wizard.form</field>
        <field name="model">od19.scan.article.wizard</field>
        <field name="arch" type="xml">
            <form string="แปลงไฟล์สแกนเป็นบทความ">
                <group>
                    <group string="ภาพที่สแกน">
                        <field name="page_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="image" widget="od19_camera" filename="image_filename"/>
                                <field name="image_filename" invisible="1"/>
                                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'error'"/>
                                <field name="ocr_engine" readonly="1"/>
                                <field name="error_message" readonly="1"/>
                            </list>
                        </field>
                    </group>
                    <group string="ตัวเลือก OCR">
                        <field name="run_ocr"/>
                        <field name="ocr_engine"/>
                        <field name="language"/>
                        <field name="engine_used"/>
                        <label for="attach_images" string=""/>
                        <field name="attach_images"/>
                    </group>
                </group>
                <group string="รายละเอียดบทความ">
                    <field name="title" placeholder="เช่น รายงานการประชุมประจำเดือน พ.ย. 2569"/>
                    <field name="template"/>
                    <field name="category"/>
                    <field name="keywords" placeholder="คำค้นหา, คั่น, ด้วย, จุลภาค"/>
                    <field name="parent_id" options="{'no_create': True}"/>
                </group>
                <group string="เนื้อหา">
                    <field name="text_content" nolabel="1" widget="text" placeholder="เนื้อหาที่อ่านได้จะปรากฏที่นี่ แก้ไขได้ก่อนสร้างบทความ"/>
                </group>
                <field name="article_id" invisible="1"/>
                <field name="state" invisible="1"/>
                <footer>
                    <button name="action_run_ocr" type="object" string="อ่านข้อความด้วย OCR" class="btn-secondary"/>
                    <button name="action_create_article" type="object" string="สร้างบทความ" class="btn-primary"/>
                    <button special="cancel" string="ยกเลิก" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_od19_scan_article_wizard" model="ir.actions.act_window">
        <field name="name">สแกนเป็นบทความ Knowledge</field>
        <field name="res_model">od19.scan.article.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_title': ''}</field>
    </record>

</odoo>
