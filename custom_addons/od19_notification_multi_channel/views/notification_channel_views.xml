<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="notification_channel_tree" model="ir.ui.view">
        <field name="name">notification.channel.tree</field>
        <field name="model">notification.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="channel_type"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="notification_channel_form" model="ir.ui.view">
        <field name="name">notification.channel.form</field>
        <field name="model">notification.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="channel_type"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="notification_channel_search" model="ir.ui.view">
        <field name="name">notification.channel.search</field>
        <field name="model">notification.channel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="channel_type"/>
            </search>
        </field>
    </record>

    <record id="notification_channel_action" model="ir.actions.act_window">
        <field name="name">Notification Channels</field>
        <field name="res_model">notification.channel</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="notification_channel_search"/>
    </record>
</odoo>
