<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="notification_preference_tree" model="ir.ui.view">
        <field name="name">notification.preference.tree</field>
        <field name="model">notification.preference</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="event"/>
                <field name="channel_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="notification_preference_form" model="ir.ui.view">
        <field name="name">notification.preference.form</field>
        <field name="model">notification.preference</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="event"/>
                        <field name="channel_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="notification_preference_search" model="ir.ui.view">
        <field name="name">notification.preference.search</field>
        <field name="model">notification.preference</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="event"/>
                <filter string="Default" name="filter_default" domain="[('event','=','default')]"/>
                <group name="group_by">
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Event" name="group_event" context="{'group_by': 'event'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="notification_preference_action" model="ir.actions.act_window">
        <field name="name">Notification Preferences</field>
        <field name="res_model">notification.preference</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="notification_preference_search"/>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>

    <menuitem id="menu_notification_root"
              name="Notifications"
              parent="base.menu_administration"
              sequence="90"/>

    <menuitem id="menu_notification_channels"
              name="Channels"
              parent="menu_notification_root"
              action="notification_channel_action"
              sequence="10"/>

    <menuitem id="menu_notification_preferences"
              name="My Preferences"
              parent="menu_notification_root"
              action="notification_preference_action"
              sequence="20"/>
</odoo>
