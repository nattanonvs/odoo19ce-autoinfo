<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_line_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.line.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="line_user_id" placeholder="LINE User ID"/>
            </xpath>
        </field>
    </record>
</odoo>
