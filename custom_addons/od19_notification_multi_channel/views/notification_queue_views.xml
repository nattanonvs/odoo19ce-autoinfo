<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="od19_notification_queue_view_tree" model="ir.ui.view">
        <field name="name">od19.notification.queue.tree</field>
        <field name="model">od19.notification.queue</field>
        <field name="arch" type="xml">
            <list string="Notification Queue">
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="channel"/>
                <field name="subject"/>
                <field name="event" optional="hide"/>
                <field name="retry_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-warning="state in ('sending', 'failed')"
                       decoration-success="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="od19_notification_queue_view_form" model="ir.ui.view">
        <field name="name">od19.notification.queue.form</field>
        <field name="model">od19.notification.queue</field>
        <field name="arch" type="xml">
            <form string="Notification Queue">
                <header>
                    <button name="action_send" string="Send Now" type="object"
                            class="btn-primary" invisible="state in ('sending', 'sent')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,sending,sent,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="channel"/>
                            <field name="event"/>
                        </group>
                        <group>
                            <field name="subject"/>
                            <field name="retry_count" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="od19_notification_queue_view_search" model="ir.ui.view">
        <field name="name">od19.notification.queue.search</field>
        <field name="model">od19.notification.queue</field>
        <field name="arch" type="xml">
            <search string="Notification Queue">
                <field name="partner_id"/>
                <field name="channel"/>
                <field name="event"/>
                <filter string="Pending" name="filter_pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Failed" name="filter_failed"
                        domain="[('state', '=', 'failed')]"/>
                <filter string="Sent" name="filter_sent"
                        domain="[('state', '=', 'sent')]"/>
                <group>
                    <filter string="Channel" name="group_channel"
                            context="{'group_by': 'channel'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="od19_notification_queue_action" model="ir.actions.act_window">
        <field name="name">Notification Queue</field>
        <field name="res_model">od19.notification.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="od19_notification_queue_view_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

    <menuitem id="menu_notification_queue" name="Queue"
              parent="menu_notification_root"
              action="od19_notification_queue_action" sequence="30"/>

</odoo>
