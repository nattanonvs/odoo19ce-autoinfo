<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_notification" model="mail.template">
        <field name="name">Notification Multi-Channel: Email</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="subject">{{ ctx.get('notification_subject', 'Notification') }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or '') }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="body_html" type="html">
<div style="font-family: 'Sarabun', 'Noto Sans Thai', Arial, sans-serif; color: #333;">
    <p>เรียน {{ object.name }},</p>
    <p style="white-space: pre-line;">{{ ctx.get('notification_message', '') }}</p>
    <p>ขอแสดงความนับถือ<br/>ระบบแจ้งเตือนอัตโนมัติ</p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
