<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Actions -->
    <record id="action_internal_issue_my" model="ir.actions.act_window">
        <field name="name">เรื่องของฉัน</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('reported_by_id', '=', uid)]</field>
        <field name="path">internal-issue-my</field>
    </record>
    <record id="action_internal_issue_it_support" model="ir.actions.act_window">
        <field name="name">IT Support</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form,pivot</field>
        <field name="domain">[('team_id', '=', ref('team_issue_it_support'))]</field>
        <field name="path">internal-issue-it-support</field>
    </record>
    <record id="action_internal_issue_improvement_iso" model="ir.actions.act_window">
        <field name="name">ปรับปรุง-ISO</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form,pivot</field>
        <field name="domain">[('team_id', 'in', [ref('team_issue_improvement'), ref('team_issue_iso_capa')])]</field>
        <field name="path">internal-issue-improvement-iso</field>
    </record>
    <record id="action_internal_issue_triage" model="ir.actions.act_window">
        <field name="name">Triage</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form,pivot</field>
        <field name="domain">[('team_id', '=', ref('team_issue_triage'))]</field>
        <field name="path">internal-issue-triage</field>
    </record>

    <!-- Submenu ใต้ Helpdesk (ขยายเมนูเดิม ไม่สร้างเมนูหลักซ้ำ) -->
    <menuitem id="menu_internal_issue_my"
              name="เรื่องของฉัน"
              parent="helpdesk_mgmt.helpdesk_ticket_main_menu"
              action="action_internal_issue_my"
              sequence="10"/>
    <menuitem id="menu_internal_issue_it_support"
              name="IT Support"
              parent="helpdesk_mgmt.helpdesk_ticket_main_menu"
              action="action_internal_issue_it_support"
              sequence="20"/>
    <menuitem id="menu_internal_issue_improvement_iso"
              name="ปรับปรุง-ISO"
              parent="helpdesk_mgmt.helpdesk_ticket_main_menu"
              action="action_internal_issue_improvement_iso"
              sequence="30"/>
    <menuitem id="menu_internal_issue_triage"
              name="Triage"
              parent="helpdesk_mgmt.helpdesk_ticket_main_menu"
              action="action_internal_issue_triage"
              sequence="40"/>
    <menuitem id="menu_internal_issue_queue_request"
              name="คำขอแซงคิว"
              parent="helpdesk_mgmt.helpdesk_ticket_main_menu"
              action="action_helpdesk_queue_request"
              sequence="50"/>

    <!-- Settings -->
    <menuitem id="menu_internal_issue_routing_rule"
              name="กฎการส่งเรื่องอัตโนมัติ"
              parent="helpdesk_mgmt.helpdesk_ticket_config_main_menu"
              action="action_helpdesk_routing_rule"
              sequence="50"/>

</odoo>
