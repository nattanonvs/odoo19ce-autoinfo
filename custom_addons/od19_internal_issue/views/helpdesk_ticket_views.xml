<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend ticket form -->
    <record id="helpdesk_ticket_view_form_inherit_internal" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.internal</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="visibility"/>
                <field name="department_id"
                       invisible="visibility != 'department'"/>
                <field name="reported_by_id"/>
                <field name="is_emergency"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,submitted,validated,in_progress,done"
                       statusbar_colors='{"cancelled":"danger"}'/>
            </xpath>

            <xpath expr="//form/header" position="inside">
                <button name="action_submit" type="object"
                        string="ส่งตรวจสอบ" class="btn-primary"
                        invisible="state != 'draft'"/>
                <button name="action_validate" type="object"
                        string="ตรวจสอบผ่าน" class="btn-success"
                        invisible="state not in ('submitted',)"/>
                <button name="action_reject" type="object"
                        string="ปฏิเสธ" class="btn-danger"
                        invisible="state not in ('submitted',)"/>
                <button name="action_start_work" type="object"
                        string="เริ่มดำเนินการ"
                        invisible="state != 'validated'"/>
                <button name="action_done" type="object"
                        string="เสร็จสิ้น" class="btn-success"
                        invisible="state != 'in_progress'"/>
                <button name="action_cancel" type="object"
                        string="ยกเลิก" class="btn-danger"
                        invisible="state in ('done','cancelled')"/>
                <button name="action_reset_to_draft" type="object"
                        string="กลับเป็นร่าง"
                        invisible="state not in ('cancelled',)"/>
            </xpath>

            <xpath expr="//notebook/page[@name='other_info']" position="after">
                <page string="Internal" name="internal">
                    <group>
                        <group>
                            <field name="visibility"/>
                            <field name="department_id"/>
                            <field name="reported_by_id"/>
                            <field name="is_emergency"/>
                            <field name="need_validation" readonly="1"/>
                            <field name="validation_status" readonly="1"/>
                        </group>
                    </group>
                    <field name="resolution" placeholder="Root cause and solution..."/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend ticket list view -->
    <record id="ticket_view_tree_inherit_internal" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list.internal</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="visibility"/>
                <field name="is_emergency" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <!-- Extend ticket search view -->
    <record id="helpdesk_ticket_view_search_inherit_internal" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search.internal</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.helpdesk_ticket_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="visibility"/>
                <field name="department_id"/>
                <field name="reported_by_id"/>
                <field name="is_emergency"/>
            </xpath>
            <xpath expr="//search/group[1]" position="inside">
                <filter string="Emergency" name="filter_emergency"
                        domain="[('is_emergency','=',True)]"/>
                <filter string="Public" name="filter_public"
                        domain="[('visibility','=','public')]"/>
                <filter string="Department" name="filter_department"
                        domain="[('visibility','=','department')]"/>
                <filter string="Private" name="filter_private"
                        domain="[('visibility','=','private')]"/>
            </xpath>
        </field>
    </record>

</odoo>
