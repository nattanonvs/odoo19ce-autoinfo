<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_od19_contract_core" model="ir.ui.view">
        <field name="name">sale.order.form.od19.contract.core</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='od19_project_owner_id']" position="after">
                <field name="od19_contract_id"/>
            </xpath>
        </field>
    </record>
</odoo>
