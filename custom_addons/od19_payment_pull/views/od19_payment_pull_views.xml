<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Wizard: ดึงเอกสาร (บิล/ใบแจ้งหนี้) มาตั้งใบสำคัญ
         ============================================================ -->
    <record id="view_od19_payment_pull_wizard_form" model="ir.ui.view">
        <field name="name">od19.payment.pull.wizard.form</field>
        <field name="model">od19.payment.pull.wizard</field>
        <field name="arch" type="xml">
            <form string="ดึงเอกสารตั้งใบสำคัญ / Pull documents into voucher">
                <group>
                    <group>
                        <field name="payment_type" widget="radio"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="partner_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="journal_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="payment_date"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="only_overdue"/>
                        <field name="include_refunds"/>
                        <field name="group_by_partner"/>
                    </group>
                </group>
                <div class="mb-2 text-muted">
                    <span class="me-3">เลือก <field name="selected_count" class="oe_inline"/> รายการ
                        / <field name="selected_count" class="oe_inline"/> selected</span>
                    <span class="me-3">รวม <field name="selected_amount" class="oe_inline" widget="monetary"/></span>
                    <span>จะสร้าง <field name="planned_voucher_count" class="oe_inline"/> ใบสำคัญ
                        / <field name="planned_voucher_count" class="oe_inline"/> voucher(s)</span>
                    <field name="currency_id" invisible="1"/>
                </div>
                <field name="line_ids" nolabel="1">
                    <list create="false" delete="false" editable="bottom"
                          decoration-info="selected"
                          decoration-warning="is_partial">
                        <field name="selected"/>
                        <field name="move_id" column_invisible="1" force_save="1"/>
                        <field name="ref" optional="show"/>
                        <field name="partner_id" optional="show"/>
                        <field name="invoice_date" optional="show"/>
                        <field name="date_due" optional="show"/>
                        <field name="amount_total" optional="show"/>
                        <field name="amount_residual"/>
                        <field name="amount_to_pay"/>
                        <field name="is_partial" readonly="1"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_pull" type="object"
                            string="ดึงรายการ &amp; สร้างใบสำคัญ / Pull &amp; Create"
                            class="btn-primary"/>
                    <button string="ยกเลิก / Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_od19_payment_pull_wizard_outbound" model="ir.actions.act_window">
        <field name="name">สร้างใบสำคัญจ่าย (ดึงเอกสาร) / New Voucher (Pull)</field>
        <field name="res_model">od19.payment.pull.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_od19_payment_pull_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_payment_type': 'outbound'}</field>
    </record>

    <record id="action_od19_payment_pull_wizard_inbound" model="ir.actions.act_window">
        <field name="name">สร้างใบสำคัญรับ (ดึงเอกสาร) / New Voucher (Pull)</field>
        <field name="res_model">od19.payment.pull.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_od19_payment_pull_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_payment_type': 'inbound'}</field>
    </record>

    <!-- ============================================================
         ทะเบียนใบสำคัญ: ปิดปุ่ม New แล้วเปิดวิซาร์ดดึงเอกสารแทน
         ============================================================ -->
    <record id="view_od19_payment_voucher_tree_pull" model="ir.ui.view">
        <field name="name">account.payment.voucher.list.pull</field>
        <field name="model">account.payment</field>
        <field name="inherit_id"
               ref="od19_accounting_payment_voucher_reports.view_od19_payment_voucher_tree"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">false</attribute>
            </list>
            <header position="inside">
                <button name="%(action_od19_payment_pull_wizard_outbound)d"
                        type="action"
                        string="สร้างใบสำคัญจ่าย (ดึงเอกสาร) / New Voucher (Pull)"
                        class="btn-primary"
                        invisible="context.get('default_payment_type') == 'inbound'"/>
                <button name="%(action_od19_payment_pull_wizard_inbound)d"
                        type="action"
                        string="สร้างใบสำคัญรับ (ดึงเอกสาร) / New Voucher (Pull)"
                        class="btn-primary"
                        invisible="context.get('default_payment_type') != 'inbound'"/>
            </header>
        </field>
    </record>

    <!-- ให้ action ของทะเบียนใบสำคัญใช้ list view ของ OD19 (ไม่ใช่ของ Core) -->
    <record id="od19_accounting_payment_voucher_reports.action_od19_payment_vouchers"
            model="ir.actions.act_window">
        <field name="view_id"
               ref="od19_accounting_payment_voucher_reports.view_od19_payment_voucher_tree"/>
    </record>
    <record id="od19_accounting_payment_voucher_reports.action_od19_receipt_vouchers"
            model="ir.actions.act_window">
        <field name="view_id"
               ref="od19_accounting_payment_voucher_reports.view_od19_payment_voucher_tree"/>
    </record>

</odoo>
