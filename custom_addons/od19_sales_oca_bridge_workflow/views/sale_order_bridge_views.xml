<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_od19_oca_bridge" model="ir.ui.view">
        <field name="name">sale.order.form.od19.oca.bridge</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <separator string="OCA Bridge (Required Now)"/>
                <field name="delivery_status" readonly="1"/>
                <field name="current_revision_id" readonly="1"/>
                <field name="main_exception_id" readonly="1"/>
                <field name="exceptions_summary" readonly="1"/>
                <field name="blanket_order_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
