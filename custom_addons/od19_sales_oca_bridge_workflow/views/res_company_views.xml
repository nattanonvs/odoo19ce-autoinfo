<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_od19_sale_approval_threshold" model="ir.ui.view">
        <field name="name">res.company.od19.sale.approval.threshold</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="od19_so_manager_approval_threshold"/>
                <field name="od19_so_director_approval_threshold"/>
            </xpath>
        </field>
    </record>
</odoo>
