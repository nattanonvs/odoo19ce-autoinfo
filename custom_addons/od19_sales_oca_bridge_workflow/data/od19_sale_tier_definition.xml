<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Sale Order Tier Validation Definitions
    ======================================
    วงเงินอนุมัติถูกเก็บไว้ที่ res.company (Settings -> Companies) เพื่อให้แต่ละ
    บริษัทปรับแต่งได้เอง

    ฟิลด์ tier.definition.definition_domain เป็น Char ที่เครื่องยนต์ tier
    validation ประเมินด้วย literal_eval จึงต้องสร้าง domain ใหม่ทุกครั้งที่วงเงิน
    เปลี่ยน ฟังก์ชันด้านล่างจะ sync นิยามให้ทุกบริษัททั้งตอนติดตั้งและตอน upgrade
    (หมายเหตุ: <function> ในบล็อก noupdate จะไม่ถูกเรียกตอน upgrade จึงไม่ใส่ noupdate)
    -->
    <function name="_od19_sync_all_sale_tier_definitions" model="res.company"/>
</odoo>
