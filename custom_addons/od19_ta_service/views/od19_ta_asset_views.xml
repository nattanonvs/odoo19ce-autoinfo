<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ============ ปุ่มประวัติงานบริการบนทะเบียน ATG ============ -->
    <!-- บันทึกไว้ในกลุ่ม TA Service เท่านั้น เพื่อไม่ให้ผู้ใช้ทะเบียนทั่วไป
         ต้องอ่าน helpdesk.ticket โดยไม่จำเป็น -->

    <!-- Plant -->
    <record id="od19_ta_plant_view_form_tickets" model="ir.ui.view">
        <field name="name">od19.ta.plant.form.inherit.tickets</field>
        <field name="model">od19.ta.plant</field>
        <field name="inherit_id" ref="od19_ta_asset.od19_ta_plant_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_od19_ta_tickets"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-life-ring"
                    groups="od19_ta_service.group_od19_ta_service"
                    invisible="od19_ta_ticket_count == 0"
                >
                    <field
                        name="od19_ta_ticket_count"
                        widget="statinfo"
                        string="Tickets"
                    />
                </button>
            </xpath>
        </field>
    </record>

    <!-- Tank -->
    <record id="od19_ta_tank_view_form_tickets" model="ir.ui.view">
        <field name="name">od19.ta.tank.form.inherit.tickets</field>
        <field name="model">od19.ta.tank</field>
        <field name="inherit_id" ref="od19_ta_asset.od19_ta_tank_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_od19_ta_tickets"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-life-ring"
                    groups="od19_ta_service.group_od19_ta_service"
                    invisible="od19_ta_ticket_count == 0"
                >
                    <field
                        name="od19_ta_ticket_count"
                        widget="statinfo"
                        string="Tickets"
                    />
                </button>
            </xpath>
        </field>
    </record>

    <!-- อุปกรณ์ ATG (core maintenance.equipment) -->
    <record id="od19_ta_equipment_view_form_tickets" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.inherit.tickets.od19.ta</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_od19_ta_tickets"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-life-ring"
                    groups="od19_ta_service.group_od19_ta_service"
                    invisible="od19_ta_ticket_count == 0"
                >
                    <field
                        name="od19_ta_ticket_count"
                        widget="statinfo"
                        string="Tickets"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
