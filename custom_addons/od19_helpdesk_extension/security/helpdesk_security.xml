<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Groups: use helpdesk_mgmt's existing category & privilege -->
    <record id="group_internal_helpdesk" model="res.groups">
        <field name="name">Internal Helpdesk User</field>
        <field name="privilege_id" ref="helpdesk_mgmt.group_helpdesk_privilege" />
        <field name="implied_ids" eval="[(4, ref('helpdesk_mgmt.group_helpdesk_user_own'))]" />
        <field name="comment">Can see and manage only Internal IT Helpdesk tickets.</field>
    </record>

    <record id="group_sales_service" model="res.groups">
        <field name="name">Sales Services User</field>
        <field name="privilege_id" ref="helpdesk_mgmt.group_helpdesk_privilege" />
        <field name="implied_ids" eval="[(4, ref('helpdesk_mgmt.group_helpdesk_user'))]" />
        <field name="comment">Can see and manage only Customer Sales Services tickets (with billing).</field>
    </record>

    <!-- Record rules: separate ticket visibility by team_type -->

    <!-- Internal Helpdesk users see only internal tickets -->
    <record id="rule_internal_helpdesk_ticket" model="ir.rule">
        <field name="name">Internal Helpdesk: only internal tickets</field>
        <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket" />
        <field name="domain_force">[('team_id.team_type', '=', 'internal')]</field>
        <field name="groups" eval="[(4, ref('group_internal_helpdesk'))]" />
    </record>

    <!-- Sales Services users see only customer_service tickets -->
    <record id="rule_sales_service_ticket" model="ir.rule">
        <field name="name">Sales Services: only customer service tickets</field>
        <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket" />
        <field name="domain_force">[('team_id.team_type', '=', 'customer_service')]</field>
        <field name="groups" eval="[(4, ref('group_sales_service'))]" />
    </record>

    <!-- Team visibility: internal users see only internal teams -->
    <record id="rule_internal_helpdesk_team" model="ir.rule">
        <field name="name">Internal Helpdesk: only internal teams</field>
        <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket_team" />
        <field name="domain_force">[('team_type', '=', 'internal')]</field>
        <field name="groups" eval="[(4, ref('group_internal_helpdesk'))]" />
    </record>

    <!-- Team visibility: sales service users see only customer_service teams -->
    <record id="rule_sales_service_team" model="ir.rule">
        <field name="name">Sales Services: only customer service teams</field>
        <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket_team" />
        <field name="domain_force">[('team_type', '=', 'customer_service')]</field>
        <field name="groups" eval="[(4, ref('group_sales_service'))]" />
    </record>
</odoo>
