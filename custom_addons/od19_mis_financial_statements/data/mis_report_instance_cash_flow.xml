<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="True">

    <!-- ============================== งบกระแสเงินสด ============================== -->
    <record id="mis_instance_cash_flow" model="mis.report.instance">
        <field name="name">งบกระแสเงินสด (วิธีทางอ้อม)</field>
        <field name="report_id" ref="mis_report_cash_flow" />
        <field name="sequence">30</field>
        <field name="comparison_mode" eval="True" />
        <field name="landscape_pdf" eval="True" />
        <field name="target_move">posted</field>
    </record>

    <record id="mis_period_cf_m0" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_instance_cash_flow" />
        <field name="name">เดือนปัจจุบัน</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
        <field name="sequence">10</field>
    </record>

    <record id="mis_period_cf_m1" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_instance_cash_flow" />
        <field name="name">เดือนก่อน</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-1</field>
        <field name="duration">1</field>
        <field name="sequence">20</field>
    </record>

    <record id="mis_period_cf_m12" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_instance_cash_flow" />
        <field name="name">เดือนเดียวกันปีก่อน</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-12</field>
        <field name="duration">1</field>
        <field name="sequence">30</field>
    </record>

</odoo>
