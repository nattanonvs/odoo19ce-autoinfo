<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="True">

    <!-- ============================== งบแสดงฐานะทางการเงิน ============================== -->
    <record id="mis_instance_balance_sheet" model="mis.report.instance">
        <field name="name">งบแสดงฐานะทางการเงิน (หัวข้อบัญชี)</field>
        <field name="report_id" ref="mis_report_balance_sheet" />
        <field name="sequence">10</field>
        <field name="comparison_mode" eval="True" />
        <field name="landscape_pdf" eval="True" />
        <field name="target_move">posted</field>
    </record>

    <record id="mis_period_bs_m0" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_instance_balance_sheet" />
        <field name="name">เดือนปัจจุบัน</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
        <field name="sequence">10</field>
    </record>

    <record id="mis_period_bs_m1" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_instance_balance_sheet" />
        <field name="name">เดือนก่อน</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-1</field>
        <field name="duration">1</field>
        <field name="sequence">20</field>
    </record>

    <record id="mis_period_bs_m12" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_instance_balance_sheet" />
        <field name="name">เดือนเดียวกันปีก่อน</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-12</field>
        <field name="duration">1</field>
        <field name="sequence">30</field>
    </record>

    <!-- ============================== งบกำไรขาดทุน ============================== -->
    <record id="mis_instance_profit_loss" model="mis.report.instance">
        <field name="name">งบกำไรขาดทุน (หัวข้อบัญชี)</field>
        <field name="report_id" ref="mis_report_profit_loss" />
        <field name="sequence">20</field>
        <field name="comparison_mode" eval="True" />
        <field name="landscape_pdf" eval="True" />
        <field name="target_move">posted</field>
    </record>

    <record id="mis_period_pl_m0" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_instance_profit_loss" />
        <field name="name">เดือนปัจจุบัน</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
        <field name="sequence">10</field>
    </record>

    <record id="mis_period_pl_m1" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_instance_profit_loss" />
        <field name="name">เดือนก่อน</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-1</field>
        <field name="duration">1</field>
        <field name="sequence">20</field>
    </record>

    <record id="mis_period_pl_m12" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_instance_profit_loss" />
        <field name="name">เดือนเดียวกันปีก่อน</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-12</field>
        <field name="duration">1</field>
        <field name="sequence">30</field>
    </record>

</odoo>
