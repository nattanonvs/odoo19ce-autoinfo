    <record id="mis_budget_annual_pl" model="mis.budget">
        <field name="name">งบประมาณประจำปี (งบกำไรขาดทุน)</field>
        <field name="description">งบประมาณตั้งต้นสำหรับเปรียบเทียบกับผลจริง — ปรับจำนวนเงินของแต่ละบรรทัดในหน้านี้อีกครั้งตามที่อนุมัติ</field>
        <field name="report_id" ref="mis_report_profit_loss" />
        <field name="company_id" ref="base.main_company" />
        <field name="date_from" eval="datetime.now().strftime('%Y-01-01')" />
        <field name="date_to" eval="datetime.now().strftime('%Y-12-31')" />
    </record>

