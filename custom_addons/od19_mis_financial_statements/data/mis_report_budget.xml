    <!-- ============================== รายงาน : งบประมาณ เทียบผลจริง ============================== -->
    <record id="mis_instance_budget_vs_actual" model="mis.report.instance">
        <field name="name">งบประมาณ เทียบผลจริง (งบกำไรขาดทุน)</field>
        <field name="report_id" ref="mis_report_profit_loss" />
        <field name="sequence">40</field>
        <field name="comparison_mode" eval="True" />
        <field name="landscape_pdf" eval="True" />
        <field name="target_move">posted</field>
    </record>

    <record id="mis_period_bva_actual_m" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_instance_budget_vs_actual" />
        <field name="name">ผลจริง เดือนปัจจุบัน</field>
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
        <field name="sequence">10</field>
    </record>

    <record id="mis_period_bva_budget_m" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_instance_budget_vs_actual" />
        <field name="name">งบประมาณ เดือนปัจจุบัน</field>
        <field name="source">mis_budget</field>
        <field name="source_mis_budget_id" ref="mis_budget_annual_pl" />
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
        <field name="sequence">20</field>
    </record>

    <record id="mis_period_bva_actual_ytd" model="mis.report.instance.period">
