<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Attendance Device List View -->
    <record id="hr_attendance_device_list" model="ir.ui.view">
        <field name="name">hr.attendance.device.list</field>
        <field name="model">hr.attendance.device</field>
        <field name="arch" type="xml">
            <list string="Devices" decoration-success="state == 'online'" decoration-danger="state == 'offline'">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="location"/>
                <field name="device_ip"/>
                <field name="state" widget="badge"/>
                <field name="last_activity"/>
                <field name="log_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Attendance Device Form View -->
    <record id="hr_attendance_device_form" model="ir.ui.view">
        <field name="name">hr.attendance.device.form</field>
        <field name="model">hr.attendance.device</field>
        <field name="arch" type="xml">
            <form string="Device">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Device Name"/>
                        <h1><field name="name" placeholder="e.g. Front Gate Terminal"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="serial_number"/>
                            <field name="device_model"/>
                            <field name="firmware_version"/>
                        </group>
                        <group string="Network &amp; Security">
                            <field name="device_ip"/>
                            <field name="comm_key" password="True"/>
                            <field name="location"/>
                        </group>
                    </group>
                    <group>
                        <group string="Status">
                            <field name="state" widget="badge"/>
                            <field name="last_activity"/>
                            <field name="log_count"/>
                        </group>
                        <group string="Settings">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Punch Logs" name="punch_logs">
                            <field name="log_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="punch_time"/>
                                    <field name="employee_identifier"/>
                                    <field name="employee_id"/>
                                    <field name="punch_type"/>
                                    <field name="verify_type"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Attendance Device Search View -->
    <record id="hr_attendance_device_search" model="ir.ui.view">
        <field name="name">hr.attendance.device.search</field>
        <field name="model">hr.attendance.device</field>
        <field name="arch" type="xml">
            <search string="Devices">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="location"/>
                <filter string="Online" name="online" domain="[('state', '=', 'online')]"/>
                <filter string="Offline" name="offline" domain="[('state', '=', 'offline')]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="group_company" domain="[]"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Attendance Device Action -->
    <record id="hr_attendance_device_action" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">hr.attendance.device</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a ZKTeco attendance device
            </p>
            <p>
                Configure the terminal with this server as "Cloud Server" and it
                will appear here automatically after its first connection.
            </p>
        </field>
    </record>

</odoo>
