<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Punch Log List View -->
    <record id="hr_attendance_device_log_list" model="ir.ui.view">
        <field name="name">hr.attendance.device.log.list</field>
        <field name="model">hr.attendance.device.log</field>
        <field name="arch" type="xml">
            <list string="Punch Logs" decoration-danger="state == 'error'"
                  decoration-warning="state == 'no_employee'"
                  decoration-muted="state == 'duplicate'">
                <field name="punch_time"/>
                <field name="device_id"/>
                <field name="employee_identifier"/>
                <field name="employee_id"/>
                <field name="punch_type"/>
                <field name="verify_type"/>
                <field name="state" widget="badge"/>
                <field name="attendance_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Punch Log Form View -->
    <record id="hr_attendance_device_log_form" model="ir.ui.view">
        <field name="name">hr.attendance.device.log.form</field>
        <field name="model">hr.attendance.device.log</field>
        <field name="arch" type="xml">
            <form string="Punch Log">
                <header>
                    <button name="action_process" type="object" string="Process"
                            class="btn-primary"
                            invisible="state not in ('draft', 'error', 'no_employee')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Punch">
                            <field name="device_id"/>
                            <field name="employee_identifier"/>
                            <field name="punch_time"/>
                            <field name="punch_type"/>
                            <field name="verify_type"/>
                            <field name="work_code"/>
                        </group>
                        <group string="Result">
                            <field name="employee_id"/>
                            <field name="attendance_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Diagnostics">
                        <field name="error_message" colspan="2"/>
                        <field name="raw_data" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Punch Log Search View -->
    <record id="hr_attendance_device_log_search" model="ir.ui.view">
        <field name="name">hr.attendance.device.log.search</field>
        <field name="model">hr.attendance.device.log</field>
        <field name="arch" type="xml">
            <search string="Punch Logs">
                <field name="employee_identifier"/>
                <field name="employee_id"/>
                <field name="device_id"/>
                <field name="punch_time"/>
                <filter string="To Process" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Processed" name="processed" domain="[('state', '=', 'processed')]"/>
                <filter string="Employee Not Found" name="no_employee" domain="[('state', '=', 'no_employee')]"/>
                <filter string="Errors" name="error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('punch_time', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('punch_time', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <group>
                    <filter string="Device" name="group_device" domain="[]"
                            context="{'group_by': 'device_id'}"/>
                    <filter string="Employee" name="group_employee" domain="[]"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_state" domain="[]"
                            context="{'group_by': 'state'}"/>
                    <filter string="Punch Date" name="group_date" domain="[]"
                            context="{'group_by': 'punch_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Punch Log Action -->
    <record id="hr_attendance_device_log_action" model="ir.actions.act_window">
        <field name="name">Punch Logs</field>
        <field name="res_model">hr.attendance.device.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No punch received yet
            </p>
            <p>
                Punches will show up here as soon as a device pushes them.
            </p>
        </field>
    </record>

</odoo>
