<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_zkteco" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.attendance.zkteco</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='kiosk_mode_setting_container']" position="after">
                <block title="ZKTeco Devices" name="od19_zkteco_settings">
                    <setting string="Enable ZKTeco Devices" company_dependent="1"
                             help="Accept attendance punches pushed by ZKTeco ADMS / iClock compatible terminals.">
                        <field name="od19_zkteco_enabled"/>
                    </setting>
                    <setting string="Process Punches Automatically" company_dependent="1"
                             invisible="not od19_zkteco_enabled"
                             help="Pair punches into attendances as soon as they arrive. Otherwise the scheduled action processes them every 15 minutes.">
                        <field name="od19_zkteco_auto_process"/>
                    </setting>
                    <setting string="Employee Match Field" company_dependent="1"
                             invisible="not od19_zkteco_enabled"
                             help="Employee field compared with the ID sent by the device.">
                        <field name="od19_zkteco_match_field"/>
                    </setting>
                    <setting string="Communication Key" company_dependent="1"
                             invisible="not od19_zkteco_enabled"
                             help="Optional key shared with the device. Leave empty to accept any key.">
                        <field name="od19_zkteco_comm_key" password="True"/>
                    </setting>
                    <setting string="Check-out Grace" company_dependent="1"
                             invisible="not od19_zkteco_enabled"
                             help="Punches made within this delay after a check-in are ignored as duplicates.">
                        <field name="od19_zkteco_grace_minutes" class="text-center" style="width: 6ch;"/>
                        <span> minutes</span>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
