<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_jasper_db_list" model="ir.ui.view">
        <field name="name">od19.jasper.db.list</field>
        <field name="model">od19.jasper.db</field>
        <field name="arch" type="xml">
            <list string="Jasper Database Connections">
                <field name="name"/>
                <field name="host"/>
                <field name="port"/>
                <field name="database"/>
                <field name="username"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_jasper_db_form" model="ir.ui.view">
        <field name="name">od19.jasper.db.form</field>
        <field name="model">od19.jasper.db</field>
        <field name="arch" type="xml">
            <form string="Jasper Database Connection">
                <sheet>
                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="driver"/>
                            <field name="host"/>
                            <field name="port"/>
                        </group>
                        <group>
                            <field name="database"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="jdbc_dir"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Role Creation Script" name="setup_sql">
                            <field name="setup_sql" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jasper_db" model="ir.actions.act_window">
        <field name="name">Jasper Database Connection</field>
        <field name="res_model">od19.jasper.db</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a Jasper database connection
            </p>
            <p>
                JasperReports reads the data straight from PostgreSQL through
                JDBC. Defaults are taken from odoo.conf, so a single record is
                usually enough.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_jasper_db"
        name="Jasper Database Connection"
        parent="menu_jasper_reporting"
        action="action_jasper_db"
        sequence="30"/>

</odoo>
