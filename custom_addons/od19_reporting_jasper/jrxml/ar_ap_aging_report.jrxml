	<subDataset name="inv_detail" uuid="8f02bd52-a4c4-4491-9470-f21799a356a6">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="133 bnb"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="220"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="772"/>
		<parameter name="p_Type" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["ar"]]></defaultValueExpression>
		</parameter>
		<parameter name="p_Days" class="java.lang.Integer" isForPrompting="false">
			<defaultValueExpression><![CDATA[30]]></defaultValueExpression>
		</parameter>
		<parameter name="p_DateFormat" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["dd/MM/yyyy"]]></defaultValueExpression>
		</parameter>
		<parameter name="p_As_Date" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["2023-02-01"]]></defaultValueExpression>
		</parameter>
		<parameter name="company_id" class="java.lang.Integer" isForPrompting="false">
			<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
		</parameter>
		<parameter name="account_ids" class="java.lang.String" isForPrompting="false"/>
		<parameter name="partner_id" class="java.lang.Integer" isForPrompting="false">
			<defaultValueExpression><![CDATA[3170]]></defaultValueExpression>
		</parameter>
		<parameter name="m_report_count" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[SELECT
     am.name as invoice_no,
     coalesce(am.invoice_date, am.date) as date,
     coalesce(am.invoice_date_due, am.date) as due_date,
     case when coalesce(am.invoice_date_due, am.date) > $P{p_As_Date}::date then agl.res_amount else 0.0 end as undue_amount,
     case when coalesce(am.invoice_date_due, am.date) between $P{p_As_Date}::date - (1*$P{p_Days}) and $P{p_As_Date}::date then agl.res_amount else 0.0 end as overdue1,
     case when coalesce(am.invoice_date_due, am.date) between $P{p_As_Date}::date - (2*$P{p_Days}) and $P{p_As_Date}::date - (1*$P{p_Days}+1) then agl.res_amount else 0.0 end as overdue2,
     case when coalesce(am.invoice_date_due, am.date) between $P{p_As_Date}::date - (3*$P{p_Days}) and $P{p_As_Date}::date - (2*$P{p_Days}+1) then agl.res_amount else 0.0 end as overdue3,
     case when coalesce(am.invoice_date_due, am.date) between $P{p_As_Date}::date - (4*$P{p_Days}) and $P{p_As_Date}::date - (3*$P{p_Days}+1) then agl.res_amount else 0.0 end as overdue4,
     case when coalesce(am.invoice_date_due, am.date) between $P{p_As_Date}::date - (5*$P{p_Days}) and $P{p_As_Date}::date - (4*$P{p_Days}+1) then agl.res_amount else 0.0 end as overdue5,
     case when coalesce(am.invoice_date_due, am.date) < $P{p_As_Date}::date - (5*$P{p_Days}) then agl.res_amount else 0.0 end as overdue6
FROM
 (
    SELECT
        aml.move_id,
        aml.id as move_line_id,
        aml.partner_id,
        aml.account_id,
        case when '$P!{p_Type}' = 'ap' 
            then (aml.credit - coalesce(sum(rcc.amount), 0)) - (aml.debit - coalesce(sum(rcd.amount), 0))
            else (aml.debit - coalesce(sum(rcd.amount), 0)) - (aml.credit - coalesce(sum(rcc.amount), 0))
        end as res_amount
    FROM account_move am
    JOIN account_move_line aml ON am.id = aml.move_id
    JOIN account_account aa ON aml.account_id = aa.id
    LEFT JOIN account_partial_reconcile rcd ON aml.id = rcd.debit_move_id and aml.debit > 0 and rcd.max_date <= $P{p_As_Date}::date
    LEFT JOIN account_partial_reconcile rcc ON aml.id = rcc.credit_move_id and aml.credit > 0 and rcc.max_date <= $P{p_As_Date}::date
    WHERE am.state = 'posted' and am.company_id = $P{company_id}
    and aa.account_type = case when '$P!{p_Type}' = 'ap' then 'liability_payable' else 'asset_receivable' end
    and (aml.account_id = any($P!{account_ids}) or $P!{account_ids} is null)
	and (aml.partner_id = $P!{partner_id})
    and (
        (am.move_type = 'entry' and am.date <= $P{p_As_Date}::date)
        OR (am.move_type != 'entry' and am.invoice_date <= $P{p_As_Date}::date)
    )
    GROUP BY aml.move_id, aml.id, aml.partner_id, aml.account_id, aml.debit, aml.credit
	HAVING aml.debit > coalesce(sum(round(rcd.amount,2)), 0) or aml.credit > coalesce(sum(round(rcc.amount,2)), 0)
) agl
join account_move am on agl.move_id = am.id
order by am.name, am.date, am.invoice_date, am.invoice_date_due]]>
		</queryString>
