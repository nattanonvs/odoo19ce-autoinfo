	<queryString>
		<![CDATA[SELECT
    p.id as partner_id,
    p.ref as partner_ref,
    p.name,
    sum(case when coalesce(am.invoice_date_due, am.date) > $P{p_As_Date}::date then agl.res_amount else 0.0 end) as sum_undue_amount,
    sum(case when coalesce(am.invoice_date_due, am.date) between $P{p_As_Date}::date - (1*$P{p_Days}) and $P{p_As_Date}::date then agl.res_amount else 0.0 end) as sum_overdue1,
    sum(case when coalesce(am.invoice_date_due, am.date) between $P{p_As_Date}::date - (2*$P{p_Days}) and $P{p_As_Date}::date - (1*$P{p_Days}+1) then agl.res_amount else 0.0 end) as sum_overdue2,
    sum(case when coalesce(am.invoice_date_due, am.date) between $P{p_As_Date}::date - (3*$P{p_Days}) and $P{p_As_Date}::date - (2*$P{p_Days}+1) then agl.res_amount else 0.0 end) as sum_overdue3,
    sum(case when coalesce(am.invoice_date_due, am.date) between $P{p_As_Date}::date - (4*$P{p_Days}) and $P{p_As_Date}::date - (3*$P{p_Days}+1) then agl.res_amount else 0.0 end) as sum_overdue4,
    sum(case when coalesce(am.invoice_date_due, am.date) between $P{p_As_Date}::date - (5*$P{p_Days}) and $P{p_As_Date}::date - (4*$P{p_Days}+1) then agl.res_amount else 0.0 end) as sum_overdue5,
    sum(case when coalesce(am.invoice_date_due, am.date) < $P{p_As_Date}::date - (5*$P{p_Days}) then agl.res_amount else 0.0 end) as sum_overdue6,
    sum(agl.res_amount) as sum_total
FROM
 (
    SELECT
        aml.move_id,
        aml.id as move_line_id,
        aml.partner_id,
        aml.account_id,
        case when '$P!{p_Type}' = 'ap' 
            then (aml.credit - coalesce(sum(rcc.amount), 0)) - (aml.debit - coalesce(sum(rcd.amount), 0))
            else (aml.debit - coalesce(sum(rcd.amount), 0)) - (aml.credit - coalesce(sum(rcc.amount), 0))
        end as res_amount
    FROM account_move am
    JOIN account_move_line aml ON am.id = aml.move_id
    JOIN account_account aa ON aml.account_id = aa.id
    LEFT JOIN account_partial_reconcile rcd ON aml.id = rcd.debit_move_id and aml.debit > 0 and rcd.max_date <= $P{p_As_Date}::date
    LEFT JOIN account_partial_reconcile rcc ON aml.id = rcc.credit_move_id and aml.credit > 0 and rcc.max_date <= $P{p_As_Date}::date
    LEFT JOIN res_partner rp ON aml.partner_id = rp.id
	WHERE am.state = 'posted' and am.company_id = $P{company_id}
    and aa.account_type = case when '$P!{p_Type}' = 'ap' then 'liability_payable' else 'asset_receivable' end
    and (aml.account_id = any($P!{account_ids}) or $P!{account_ids} is null)
    and (aml.partner_id = any($P!{partner_ids}) or $P!{partner_ids} is null)
	and (case when '$P!{p_Type}' = 'ap' then rp.supplier_rank > 0 else rp.customer_rank > 0 end)
    and (
        (am.move_type = 'entry' and am.date <= $P{p_As_Date}::date)
        OR (am.move_type != 'entry' and am.invoice_date <= $P{p_As_Date}::date)
    )
    GROUP BY aml.move_id, aml.id, aml.partner_id, aml.account_id, aml.debit, aml.credit
    HAVING aml.debit > coalesce(sum(round(rcd.amount,2)), 0) or aml.credit > coalesce(sum(round(rcc.amount,2)), 0)
) as agl
JOIN account_move am on agl.move_id = am.id
JOIN res_partner p on agl.partner_id = p.id
GROUP BY p.id, p.ref, p.name
ORDER BY p.ref, p.name]]>
	</queryString>
