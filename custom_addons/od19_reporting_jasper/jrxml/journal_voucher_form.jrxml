	<queryString>
		<![CDATA[SELECT 
	c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo
	,COALESCE(c.company_address_thai,'') AS company_address_thai
	,COALESCE(c.company_address_en,'') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website

	,am.id,am.name
	,NULL::varchar AS voucher_running_no
	,am.date
	,COALESCE(am.ref,'') AS ref
	,''::varchar AS je_type
	,COALESCE(je.name->>'th_TH','') AS je_name
	,''::varchar AS voucher_title_general
	,''::varchar AS voucher_title_receive
	,''::varchar AS voucher_title_pay
	,''::varchar AS voucher_title_general_th
	,''::varchar AS voucher_title_receive_th
	,''::varchar AS voucher_title_pay_th
	,pn.tax_name AS partner_name
	,pn.ref AS partner_ref
	,CONCAT(pn.street,' ',pn.street2) AS partner_address
	,COALESCE(pn.phone,'') AS partner_phone
	,COALESCE(pn.fax,'') AS partner_fax
	,COALESCE(pn.vat,'') AS partner_tax
	,COALESCE(pn.branch_code,'') AS partner_branch

	,(SELECT CONCAT(a.code_store->>(am.company_id::text),' ',COALESCE(a.name->>'th_TH',''))
		FROM account_account a
		WHERE a.id=al.account_id
	)AS voucher_account_name

	,al.name AS voucher_description
	,al.debit AS voucher_debit
	,al.credit AS voucher_credit
	,al.balance AS voucher_balance
	,convert_num_th_with_currency((SELECT sum(aml.debit) FROM account_move_line aml WHERE aml.move_id = am.id), am.currency_id) AS voucher_amount_bathtext
	,convert_num_en_with_currency((SELECT sum(aml.debit) FROM account_move_line aml WHERE aml.move_id = am.id), am.currency_id) AS voucher_amount_bathtext_en
	,al.account_id
	,al.move_id

	,NULL::varchar AS vat_name
	,NULL::varchar AS vat_no
	,NULL::date AS vat_date
	,NULL::numeric AS vat_amount
	,NULL::integer AS invoice_id

	,COALESCE((SELECT concat(a.code, ' ', COALESCE(a.name->>'th_TH',''))
		FROM account_analytic_account a
		WHERE a.id IN (SELECT jsonb_object_keys(al.analytic_distribution)::integer)
		LIMIT 1
	),'')AS voucher_budget

	,COALESCE((SELECT a.tax_name
		FROM res_partner a
		WHERE a.id=al.partner_id
	),'')AS voucher_partner_name

	,am.state AS state
	,COALESCE(pn.branch_code, '00000' ) as branch_code
	,am.write_date as prepare_date

	,(SELECT b.name
		FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = am.create_uid LIMIT 1
	) AS prepare_name

	,(SELECT j.name->>'th_TH'
		FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job j ON j.id = v.job_id
		WHERE a.user_id = am.create_uid LIMIT 1
	) AS prepare_position

	,(SELECT d.name->>'th_TH'
		FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department d ON d.id = v.department_id
		WHERE a.user_id = am.create_uid LIMIT 1
	) AS prepare_department

	,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = am.create_uid LIMIT 1
	) AS prepare_signature

	,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.move' and res_id=am.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_approved_name
	,(SELECT d.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department d ON d.id = v.department_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.move' and res_id=am.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_department
	,(SELECT j.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job j ON j.id = v.job_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.move' and res_id=am.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_position
	,(SELECT a.reviewed_date FROM (SELECT * FROM tier_review WHERE model='account.move' and res_id=am.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)AS pre_date_decided
	,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.move' and res_id=am.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_signature

	,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.move' and res_id=am.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_name
	,(SELECT d.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department d ON d.id = v.department_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.move' and res_id=am.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_department
	,(SELECT j.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job j ON j.id = v.job_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.move' and res_id=am.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_position
	,(SELECT reviewed_date FROM tier_review WHERE model='account.move' and res_id=am.id and status='approved' ORDER BY sequence DESC LIMIT 1) AS approved_date_decided
	,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.move' and res_id=am.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_signature
	,(SELECT status FROM tier_review WHERE model='account.move' and res_id=am.id ORDER BY sequence DESC LIMIT 1) AS approved_status

FROM account_move am
LEFT JOIN company_address_header_report c ON c.id=am.company_id
LEFT JOIN account_journal je ON je.id=am.journal_id
LEFT JOIN account_move_line al ON al.move_id=am.id
LEFT JOIN account_account acc ON acc.id=al.account_id
LEFT JOIN res_partner pn ON pn.id=am.partner_id

 $P!{p_ID}

order by am.id,al.credit, acc.code_store->>(am.company_id::text)]]>
	</queryString>
