<?xml version="1.0" encoding="UTF-8"?>
<!--
    Financial Statement - account header (หัวข้อบัญชี) template.

    Mirrors the OCA MIS Builder reports shipped by ``od19_mis_financial_statements``
    (``mis_report_balance_sheet`` / ``mis_report_profit_loss``) line by line:
    every printed row is a 4-digit account header whose balance is the roll-up of
    the Thai chart accounts sharing a code prefix (``1110`` <- ``111%.%``,
    ``1120`` <- ``112%.%`` + ``1130%.%``, ``3400`` <- the whole 4xxx/5xxx block, ...).

    Two engines therefore agree: the interactive MIS report and this printed form.

    Rows are produced by the query itself; ``p_scope`` selects ``BS`` (หมวด 1/2/3)
    or ``PL`` (หมวด 4/5) and ``ALL`` prints both blocks.
  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PL_BS_HEADER" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b2f6c1de-6a2c-4f3b-9d1e-6f0a2c3b4d5f">
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<style name="PlBsRow" fontName="TH Sarabun New" fontSize="12" vAlign="Middle">
		<conditionalStyle>
			<conditionExpression><![CDATA[!$F{kind}.equals("line")]]></conditionExpression>
			<style isBold="true"/>
		</conditionalStyle>
	</style>
	<style name="PlBsRowRight" fontName="TH Sarabun New" fontSize="12" vAlign="Middle" hAlign="Right">
		<conditionalStyle>
			<conditionExpression><![CDATA[!$F{kind}.equals("line")]]></conditionExpression>
			<style isBold="true"/>
		</conditionalStyle>
	</style>
	<parameter name="report_name" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Financial Statement"]]></defaultValueExpression>
	</parameter>
	<parameter name="report_date" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="report_analytic" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="company_id" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Level" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["5"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_scope" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[BS,PL,ALL]]></parameterDescription>
		<defaultValueExpression><![CDATA["ALL"]]></defaultValueExpression>
	</parameter>
	<parameter name="show_dr_cr" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="show_comp" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="move_criteria" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["where 1 = 1"]]></defaultValueExpression>
	</parameter>
	<parameter name="comp_criteria" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["where 1 = 0"]]></defaultValueExpression>
	</parameter>
	<parameter name="account_criteria" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="rpt_label" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cmp_label" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="pl_dr" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["0.00"]]></defaultValueExpression>
	</parameter>
	<parameter name="pl_cr" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["0.00"]]></defaultValueExpression>
	</parameter>
	<parameter name="pl_balance" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["0.00"]]></defaultValueExpression>
	</parameter>
	<parameter name="pl_cmp_balance" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["0.00"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Print_By" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["admin"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_language" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[thai,english]]></parameterDescription>
		<defaultValueExpression><![CDATA["thai"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[;WITH ACC AS (
    SELECT aa.id,
           aa.code_store->>'$P!{company_id}' AS account_code,
           aa.account_type
      FROM account_account aa
     WHERE aa.code_store->>'$P!{company_id}' IS NOT NULL
), AGG AS (
    SELECT b.account_id,
           SUM(b.debit - b.credit) AS balance
      FROM account_move a
      JOIN account_move_line b ON b.move_id = a.id
      $P!{move_criteria}
     GROUP BY b.account_id
), CMPG AS (
    SELECT b.account_id,
           SUM(b.debit - b.credit) AS balance
      FROM account_move a
      JOIN account_move_line b ON b.move_id = a.id
      $P!{comp_criteria}
     GROUP BY b.account_id
), UE AS (
    SELECT COALESCE(SUM(m.balance), 0) AS balance,
           COALESCE(SUM(c.balance), 0) AS cmp_balance
      FROM ACC aa
      LEFT JOIN AGG m ON m.account_id = aa.id
      LEFT JOIN CMPG c ON c.account_id = aa.id
     WHERE aa.account_type = 'equity_unaffected'
), HDR (stmt, seq, kind, hdr_key, disp, name_th, name_en, sign) AS (
    VALUES
      ('BS',   5, 'group',    'grp_assets',          '',     'สินทรัพย์',                          'Assets',                          1),
      ('BS',  10, 'line',     '1110',                '1110', 'เงินสดและเงินฝากธนาคาร',             'Cash and Cash Equivalents',       1),
      ('BS',  20, 'line',     '1120',                '1120', 'ลูกหนี้การค้าและลูกหนี้อื่น',          'Trade and Other Receivables',      1),
      ('BS',  30, 'line',     '1131',                '1131', 'เงินทดรองจ่ายและเงินให้กู้ยืม',        'Advances and Loans',               1),
      ('BS',  40, 'line',     '1140',                '1140', 'สินค้าคงเหลือ',                      'Inventories',                      1),
      ('BS',  50, 'line',     '1150',                '1150', 'สินทรัพย์หมุนเวียนอื่น',              'Other Current Assets',             1),
      ('BS',  60, 'subtotal', 'bs_cur_assets',       '',     'รวมสินทรัพย์หมุนเวียน',              'Total Current Assets',             1),
      ('BS',  70, 'line',     '1210',                '1210', 'เงินลงทุนระยะยาว',                   'Long-term Investments',            1),
      ('BS',  80, 'line',     '1310',                '1310', 'ที่ดิน อาคารและอุปกรณ์',              'Property, Plant and Equipment',    1),
      ('BS',  90, 'line',     '1320',                '1320', 'ค่าเสื่อมราคาสะสม',                  'Accumulated Depreciation',         1),
      ('BS', 100, 'line',     '1410',                '1410', 'เงินมัดจำและเงินค้ำประกัน',           'Deposits and Guarantees',          1),
      ('BS', 110, 'subtotal', 'bs_noncur_assets',    '',     'รวมสินทรัพย์ไม่หมุนเวียน',            'Total Non-current Assets',         1),
      ('BS', 120, 'total',    'bs_total_assets',     '',     'รวมสินทรัพย์',                       'Total Assets',                     1),
      ('BS', 205, 'group',    'grp_liab',            '',     'หนี้สิน',                            'Liabilities',                      1),
      ('BS', 210, 'line',     '2110',                '2110', 'เงินเบิกเกินบัญชีและเงินกู้ยืมจากธนาคาร', 'Bank Overdrafts and Loans',      -1),
      ('BS', 220, 'line',     '2120',                '2120', 'ตั๋วเงินจ่ายและเช็คจ่ายล่วงหน้า',      'Notes Payable',                   -1),
      ('BS', 230, 'line',     '2130',                '2130', 'เจ้าหนี้การค้าและเจ้าหนี้อื่น',        'Trade and Other Payables',        -1),
      ('BS', 240, 'line',     '2210',                '2210', 'หนี้สินหมุนเวียนอื่น',                'Other Current Liabilities',       -1),
      ('BS', 250, 'subtotal', 'bs_cur_liab',         '',     'รวมหนี้สินหมุนเวียน',                'Total Current Liabilities',       -1),
      ('BS', 260, 'line',     '2310',                '2310', 'เงินกู้ยืมระยะยาวจากธนาคาร',          'Long-term Bank Loans',            -1),
      ('BS', 270, 'total',    'bs_total_liab',       '',     'รวมหนี้สิน',                         'Total Liabilities',               -1),
      ('BS', 305, 'group',    'grp_equity',          '',     'ส่วนของผู้ถือหุ้น',                   'Equity',                           1),
      ('BS', 310, 'line',     '3100',                '3100', 'ทุนเรือนหุ้น',                       'Share Capital',                   -1),
      ('BS', 320, 'line',     '3200',                '3200', 'สำรองตามกฎหมาย',                     'Legal Reserve',                   -1),
      ('BS', 330, 'line',     '3300',                '3300', 'กำไร (ขาดทุน) สะสม',                 'Retained Earnings',               -1),
      ('BS', 340, 'line',     '3400',                '3400', 'กำไร (ขาดทุน) สุทธิสำหรับงวด',        'Profit (Loss) for the Period',    -1),
      ('BS', 350, 'subtotal', 'bs_total_equity',     '',     'รวมส่วนของผู้ถือหุ้น',                'Total Equity',                    -1),
      ('BS', 410, 'total',    'bs_liab_equity_total','',     'รวมหนี้สินและส่วนของผู้ถือหุ้น',       'Total Liabilities and Equity',    -1),
      ('BS', 420, 'check',    'bs_check',            '',     'ผลต่างตรวจสอบ',                      'Check',                            1),
      ('PL',  10, 'line',     '4110',                '4110', 'รายได้จากการขาย',                    'Sales Revenue',                   -1),
      ('PL',  20, 'line',     '4120',                '4120', 'รายได้จากการบริการ',                 'Service Revenue',                 -1),
      ('PL',  30, 'subtotal', 'pl_total_income',     '',     'รวมรายได้',                          'Total Revenue',                   -1),
      ('PL',  40, 'line',     '5110',                '5110', 'ต้นทุนขาย',                          'Cost of Goods Sold',              -1),
      ('PL',  50, 'line',     '5120',                '5120', 'ต้นทุนบริการและต้นทุนในการวางระบบ',   'Service and Implementation Cost', -1),
      ('PL',  60, 'subtotal', 'pl_gross_profit',     '',     'กำไร (ขาดทุน) ขั้นต้น',              'Gross Profit (Loss)',             -1),
      ('PL',  70, 'line',     '4200',                '4200', 'กำไรจากอัตราแลกเปลี่ยน',              'Gain on Exchange Rate',           -1),
      ('PL',  80, 'line',     '4300',                '4300', 'รายได้อื่น',                         'Other Income',                    -1),
      ('PL',  90, 'line',     '5130',                '5130', 'ขาดทุนจากอัตราแลกเปลี่ยน',            'Loss on Exchange Rate',           -1),
      ('PL', 100, 'line',     '5210',                '5210', 'ค่าใช้จ่ายในการขาย',                  'Selling Expenses',                -1),
      ('PL', 110, 'line',     '5300',                '5300', 'ค่าใช้จ่ายในการบริหาร',               'Administrative Expenses',         -1),
      ('PL', 120, 'line',     '5400',                '5400', 'ต้นทุนทางการเงิน',                    'Finance Costs',                   -1),
      ('PL', 130, 'line',     '5410',                '5410', 'ค่าใช้จ่ายต้องห้ามตามประมวลรัษฎากร',  'Non-deductible Expenses',         -1),
      ('PL', 140, 'subtotal', 'pl_pretax',           '',     'กำไร (ขาดทุน) ก่อนภาษีเงินได้',       'Profit (Loss) before Income Tax', -1),
      ('PL', 150, 'line',     '5420',                '5420', 'ภาษีเงินได้นิติบุคคล',                'Corporate Income Tax',            -1),
      ('PL', 160, 'total',    'pl_net',              '',     'กำไร (ขาดทุน) สุทธิ',                'Net Profit (Loss)',               -1)
), PFX (hdr_key, prefix) AS (
    VALUES
      ('1110','111'), ('1120','112'), ('1120','1130'), ('1131','1131'), ('1140','1140'), ('1150','115'),
      ('1210','121'), ('1310','131'), ('1320','132'), ('1410','141'),
      ('2110','2110'), ('2120','2120'), ('2130','213'), ('2210','221'), ('2310','231'),
      ('3100','3100'), ('3200','3200'), ('3300','3300'),
      ('3400','4110'), ('3400','4120'), ('3400','4200'), ('3400','4300'), ('3400','511'),
      ('3400','512'), ('3400','5130'), ('3400','521'), ('3400','53'), ('3400','5400'),
      ('3400','5410'), ('3400','5420'),
      ('4110','4110'), ('4120','4120'), ('5110','511'), ('5120','512'), ('4200','4200'),
      ('4300','4300'), ('5130','5130'), ('5210','521'), ('5300','53'), ('5400','5400'),
      ('5410','5410'), ('5420','5420')
), LINES AS (
    SELECT h.stmt, h.seq, h.kind, h.hdr_key, h.disp AS code, h.name_th, h.name_en,
           COALESCE(SUM(m.balance), 0) * h.sign
               - CASE WHEN h.hdr_key = '3300' THEN (SELECT balance FROM UE) ELSE 0 END AS balance,
           COALESCE(SUM(c.balance), 0) * h.sign
               - CASE WHEN h.hdr_key = '3300' THEN (SELECT cmp_balance FROM UE) ELSE 0 END AS cmp_balance
      FROM HDR h
      JOIN PFX p ON p.hdr_key = h.hdr_key
      LEFT JOIN ACC aa ON aa.account_code LIKE (p.prefix || '%.%')
      LEFT JOIN AGG m ON m.account_id = aa.id
      LEFT JOIN CMPG c ON c.account_id = aa.id
     WHERE h.kind = 'line'
     GROUP BY h.stmt, h.seq, h.kind, h.hdr_key, h.disp, h.name_th, h.name_en, h.sign
), ROWS AS (
    SELECT h.stmt, h.seq, h.kind, h.hdr_key, h.disp AS code, h.name_th, h.name_en,
           CAST(NULL AS numeric) AS balance, CAST(NULL AS numeric) AS cmp_balance
      FROM HDR h
     WHERE h.kind = 'group'
    UNION ALL
    SELECT stmt, seq, kind, hdr_key, code, name_th, name_en, balance, cmp_balance FROM LINES
    UNION ALL
    SELECT 'BS',  60, 'subtotal', 'bs_cur_assets',      '', 'รวมสินทรัพย์หมุนเวียน', 'Total Current Assets',
           SUM(balance), SUM(cmp_balance)
      FROM LINES WHERE hdr_key IN ('1110','1120','1131','1140','1150')
    UNION ALL
    SELECT 'BS', 110, 'subtotal', 'bs_noncur_assets',   '', 'รวมสินทรัพย์ไม่หมุนเวียน', 'Total Non-current Assets',
           SUM(balance), SUM(cmp_balance)
      FROM LINES WHERE hdr_key IN ('1210','1310','1320','1410')
    UNION ALL
    SELECT 'BS', 120, 'total',    'bs_total_assets',    '', 'รวมสินทรัพย์', 'Total Assets',
           SUM(balance), SUM(cmp_balance)
      FROM LINES WHERE hdr_key IN ('1110','1120','1131','1140','1150','1210','1310','1320','1410')
    UNION ALL
    SELECT 'BS', 250, 'subtotal', 'bs_cur_liab',        '', 'รวมหนี้สินหมุนเวียน', 'Total Current Liabilities',
           SUM(balance), SUM(cmp_balance)
      FROM LINES WHERE hdr_key IN ('2110','2120','2130','2210')
    UNION ALL
    SELECT 'BS', 270, 'total',    'bs_total_liab',      '', 'รวมหนี้สิน', 'Total Liabilities',
           SUM(balance), SUM(cmp_balance)
      FROM LINES WHERE hdr_key IN ('2110','2120','2130','2210','2310')
    UNION ALL
    SELECT 'BS', 350, 'subtotal', 'bs_total_equity',    '', 'รวมส่วนของผู้ถือหุ้น', 'Total Equity',
           SUM(balance), SUM(cmp_balance)
      FROM LINES WHERE hdr_key IN ('3100','3200','3300','3400')
    UNION ALL
    SELECT 'BS', 410, 'total',    'bs_liab_equity_total', '', 'รวมหนี้สินและส่วนของผู้ถือหุ้น', 'Total Liabilities and Equity',
           SUM(balance), SUM(cmp_balance)
      FROM LINES WHERE hdr_key IN ('2110','2120','2130','2210','2310','3100','3200','3300','3400')
    UNION ALL
    SELECT 'BS', 420, 'check',    'bs_check',           '', 'ผลต่างตรวจสอบ', 'Check',
           (SELECT COALESCE(SUM(balance), 0) FROM LINES
             WHERE hdr_key IN ('1110','1120','1131','1140','1150','1210','1310','1320','1410'))
         - (SELECT COALESCE(SUM(balance), 0) FROM LINES
             WHERE hdr_key IN ('2110','2120','2130','2210','2310','3100','3200','3300','3400')),
           (SELECT COALESCE(SUM(cmp_balance), 0) FROM LINES
             WHERE hdr_key IN ('1110','1120','1131','1140','1150','1210','1310','1320','1410'))
         - (SELECT COALESCE(SUM(cmp_balance), 0) FROM LINES
             WHERE hdr_key IN ('2110','2120','2130','2210','2310','3100','3200','3300','3400'))
    UNION ALL
    SELECT 'PL',  30, 'subtotal', 'pl_total_income',    '', 'รวมรายได้', 'Total Revenue',
           SUM(balance), SUM(cmp_balance)
      FROM LINES WHERE hdr_key IN ('4110','4120')
    UNION ALL
    SELECT 'PL',  60, 'subtotal', 'pl_gross_profit',    '', 'กำไร (ขาดทุน) ขั้นต้น', 'Gross Profit (Loss)',
           SUM(balance), SUM(cmp_balance)
      FROM LINES WHERE hdr_key IN ('4110','4120','5110','5120')
    UNION ALL
    SELECT 'PL', 140, 'subtotal', 'pl_pretax',          '', 'กำไร (ขาดทุน) ก่อนภาษีเงินได้', 'Profit (Loss) before Income Tax',
           SUM(balance), SUM(cmp_balance)
      FROM LINES WHERE hdr_key IN ('4110','4120','5110','5120','4200','4300','5130','5210','5300','5400','5410')
    UNION ALL
    SELECT 'PL', 160, 'total',    'pl_net',             '', 'กำไร (ขาดทุน) สุทธิ', 'Net Profit (Loss)',
           SUM(balance), SUM(cmp_balance)
      FROM LINES WHERE hdr_key IN ('4110','4120','5110','5120','4200','4300','5130','5210','5300','5400','5410','5420')
)
SELECT r.code, r.name_th, r.name_en, r.kind, r.balance, r.cmp_balance,
       (SELECT c.name FROM res_company c WHERE c.id = $P!{company_id}) AS company_name
  FROM ROWS r
 WHERE ('$P!{p_scope}' = 'ALL' OR r.stmt = '$P!{p_scope}')
 ORDER BY r.stmt, r.seq]]>
	</queryString>
	<field name="code" class="java.lang.String"/>
	<field name="name_th" class="java.lang.String"/>
	<field name="name_en" class="java.lang.String"/>
	<field name="kind" class="java.lang.String"/>
	<field name="balance" class="java.math.BigDecimal"/>
	<field name="cmp_balance" class="java.math.BigDecimal"/>
	<field name="company_name" class="java.lang.String"/>
	<title>
		<band height="120" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="555" height="30" uuid="c1000000-0000-0000-0000-000000000001"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="TH Sarabun New" size="16" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{company_name}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="32" width="555" height="20" uuid="c1000000-0000-0000-0000-000000000002"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="TH Sarabun New" size="14" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{report_name}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="52" width="555" height="20" uuid="c1000000-0000-0000-0000-000000000003"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="TH Sarabun New" size="14"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{report_date}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="72" width="555" height="20" uuid="c1000000-0000-0000-0000-000000000004">
					<printWhenExpression><![CDATA[$P{report_analytic} != ""]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="TH Sarabun New" size="14"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>" + IF(EXACT($P{p_language}, "english"), "Analytic Accounts : ", "วิเคราะห์ : ") + "</style>" + $P{report_analytic}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="-15" width="300" height="20" uuid="c1000000-0000-0000-0000-000000000005">
					<printWhenExpression><![CDATA[$V{PAGE_NUMBER} == 1]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Bottom">
					<font fontName="TH Sarabun New" size="12"/>
				</textElement>
