	<queryString>
		<![CDATA[;WITH ACC AS (
    SELECT aa.id,
           aa.code_store->>'$P!{company_id}' AS account_code,
           split_part(aa.account_type, '_', 1) AS internal_group,
           aa.account_type,
           CASE split_part(aa.account_type, '_', 1)
                WHEN 'asset' THEN 1
                WHEN 'liability' THEN 2
                WHEN 'equity' THEN 3
                WHEN 'income' THEN 4
                WHEN 'expense' THEN 5
                ELSE 6
           END AS group_order,
           CASE split_part(aa.account_type, '_', 1)
                WHEN 'asset' THEN 'Assets'
                WHEN 'liability' THEN 'Liabilities'
                WHEN 'equity' THEN 'Equity'
                WHEN 'income' THEN 'Income'
                WHEN 'expense' THEN 'Expenses'
                WHEN 'off' THEN 'Off-Balance Sheet'
                ELSE split_part(aa.account_type, '_', 1)
           END AS group_name_en,
           CASE split_part(aa.account_type, '_', 1)
                WHEN 'asset' THEN 'สินทรัพย์'
                WHEN 'liability' THEN 'หนี้สิน'
                WHEN 'equity' THEN 'ส่วนของเจ้าของ'
                WHEN 'income' THEN 'รายได้'
                WHEN 'expense' THEN 'ค่าใช้จ่าย'
                WHEN 'off' THEN 'บัญชีนอกงบดุล'
                ELSE split_part(aa.account_type, '_', 1)
           END AS group_name_th,
           CASE aa.account_type
                WHEN 'asset_receivable' THEN 'Receivable'
                WHEN 'asset_cash' THEN 'Bank and Cash'
                WHEN 'asset_current' THEN 'Current Assets'
                WHEN 'asset_non_current' THEN 'Non-current Assets'
                WHEN 'asset_prepayments' THEN 'Prepayments'
                WHEN 'asset_fixed' THEN 'Fixed Assets'
                WHEN 'liability_payable' THEN 'Payable'
                WHEN 'liability_credit_card' THEN 'Credit Card'
                WHEN 'liability_current' THEN 'Current Liabilities'
                WHEN 'liability_non_current' THEN 'Non-current Liabilities'
                WHEN 'equity' THEN 'Equity'
                WHEN 'equity_unaffected' THEN 'Current Year Earnings'
                WHEN 'income' THEN 'Income'
                WHEN 'income_other' THEN 'Other Income'
                WHEN 'expense' THEN 'Expenses'
                WHEN 'expense_other' THEN 'Other Expenses'
                WHEN 'expense_depreciation' THEN 'Depreciation'
                WHEN 'expense_direct_cost' THEN 'Cost of Revenue'
                WHEN 'off_balance' THEN 'Off-Balance Sheet'
                ELSE aa.account_type
           END AS account_type_name_en,
           CASE aa.account_type
                WHEN 'asset_receivable' THEN 'ลูกหนี้การค้า'
                WHEN 'asset_cash' THEN 'เงินสดและธนาคาร'
                WHEN 'asset_current' THEN 'สินทรัพย์หมุนเวียน'
                WHEN 'asset_non_current' THEN 'สินทรัพย์ไม่หมุนเวียน'
                WHEN 'asset_prepayments' THEN 'ค่าใช้จ่ายล่วงหน้า'
                WHEN 'asset_fixed' THEN 'สินทรัพย์ถาวร'
                WHEN 'liability_payable' THEN 'เจ้าหนี้การค้า'
                WHEN 'liability_credit_card' THEN 'บัตรเครดิต'
                WHEN 'liability_current' THEN 'หนี้สินหมุนเวียน'
                WHEN 'liability_non_current' THEN 'หนี้สินไม่หมุนเวียน'
                WHEN 'equity' THEN 'ส่วนของเจ้าของ'
                WHEN 'equity_unaffected' THEN 'กำไร(ขาดทุน)ปีปัจจุบัน'
                WHEN 'income' THEN 'รายได้'
                WHEN 'income_other' THEN 'รายได้อื่น'
                WHEN 'expense' THEN 'ค่าใช้จ่าย'
                WHEN 'expense_other' THEN 'ค่าใช้จ่ายอื่น'
                WHEN 'expense_depreciation' THEN 'ค่าเสื่อมราคา'
                WHEN 'expense_direct_cost' THEN 'ต้นทุนขาย'
                WHEN 'off_balance' THEN 'บัญชีนอกงบดุล'
                ELSE aa.account_type
           END AS account_type_name_th,
           COALESCE(aa.name->>'en_US', aa.name->>'th_TH') AS account_name_en,
           COALESCE(aa.name->>'th_TH', aa.name->>'en_US') AS account_name_th,
           c.name AS company_name
      FROM account_account aa
      LEFT JOIN res_company c ON c.id = $P!{company_id}
     WHERE aa.code_store->>'$P!{company_id}' IS NOT NULL
), MV AS (
    SELECT b.account_id,
           SUM(b.debit) AS debit,
           SUM(b.credit) AS credit,
           SUM(b.debit - b.credit) AS balance
      FROM account_move a
      JOIN account_move_line b ON b.move_id = a.id
      $P!{move_criteria}
     GROUP BY b.account_id
), CMP AS (
    SELECT b.account_id,
           SUM(b.debit - b.credit) AS balance
      FROM account_move a
      JOIN account_move_line b ON b.move_id = a.id
      $P!{comp_criteria}
     GROUP BY b.account_id
)
SELECT aa.account_code, aa.internal_group, aa.account_type, aa.group_order,
       aa.group_name_en, aa.group_name_th,
       aa.account_type_name_en, aa.account_type_name_th,
       aa.account_name_en, aa.account_name_th, aa.company_name,
       CASE WHEN aa.account_type = 'equity_unaffected' THEN CAST($P!{pl_dr} AS numeric) ELSE COALESCE(line.debit, 0) END AS debit,
       CASE WHEN aa.account_type = 'equity_unaffected' THEN CAST($P!{pl_cr} AS numeric) ELSE COALESCE(line.credit, 0) END AS credit,
       CASE WHEN aa.account_type = 'equity_unaffected' THEN CAST($P!{pl_balance} AS numeric) ELSE COALESCE(line.balance, 0) END AS balance,
       CASE WHEN aa.account_type = 'equity_unaffected' THEN CAST($P!{pl_cmp_balance} AS numeric) ELSE COALESCE(cmp.balance, 0) END AS cmp_balance
  FROM ACC aa
  LEFT JOIN MV line ON line.account_id = aa.id
  LEFT JOIN CMP cmp ON cmp.account_id = aa.id
 WHERE 1 = 1
   $P!{account_criteria}
 ORDER BY aa.group_order, aa.account_type, aa.account_code]]>
	</queryString>
	<field name="internal_group" class="java.lang.String"/>
	<field name="account_type" class="java.lang.String"/>
	<field name="group_order" class="java.lang.Integer"/>
