	<queryString>
		<![CDATA[select aml.id,
    c.id AS company_id
    ,COALESCE(c.company_name_thai,'') AS company_name_thai
    ,COALESCE(c.company_name_en,'') AS company_name_en
    ,COALESCE(c.company_tax_id,'') AS company_tax_id
    ,COALESCE(c.company_branch,'00000') AS company_branch
    ,encode(c.company_logo,'escape') AS company_logo      
    ,COALESCE(c.company_address_thai,'') AS company_address_thai
    ,COALESCE(c.company_address_en,'') AS company_address_en
    ,COALESCE(c.company_heaer_report,'') AS company_heaer_report
    ,COALESCE(c.company_footer_report,'') AS company_footer_report
    ,COALESCE(c.company_phone,'') AS company_phone
    ,COALESCE(c.company_fax,'') AS company_fax
    ,COALESCE(c.company_email,'') AS company_email
    ,COALESCE(c.company_website,'') AS company_website
    ,(SELECT a.name
          FROM res_currency a
          WHERE a.id=pay.currency_id
    )AS currency_name
    
    ,COALESCE(partner.tax_name,'') as partner_tax_name
    ,partner.vat as partner_tax_id
    ,partner.branch_code as partner_branch_code
    ,COALESCE(partner.street,'' )as partner_street
    ,COALESCE(partner.street2,'') as partner_street2
        ,pay.id as pay_id
        ,am.name as pay_no
        ,am.date as pay_date
        ,COALESCE(NULLIF(pay.memo, ''), am.ref, '') as pay_memo
        ,inv.name as invoice_number
        ,inv.invoice_date as invoice_date
        ,inv.invoice_date_due as invoice_due_date
        ,inv.amount_total as invoice_amount
        ,(inv.amount_total - apr.amount) as invoice_residual
        ,apr.amount as invoice_payment_amount
        
        ,(pay.amount - COALESCE(pay.od19_wht_amount, 0.00)) as pay_amount
        ,convert_num_th_with_currency((pay.amount + COALESCE(pay.fee_amount, 0.00)), pay.currency_id) AS bill_amount_total_bahttext
        ,convert_num_en_with_currency((pay.amount + COALESCE(pay.fee_amount, 0.00)), pay.currency_id) AS bill_amount_total_engtext
        ,apml.name as payment_method
        ,jn.name as pay_journal_name
        ,case when jn.type = 'cash' then 1 else 0 end as is_cash
        ,case when jn.type = 'bank' then 1 else 0 end as is_bank_transfer
        ,case when pay.cheque_id is not null then 1 else 0 end as is_cheque
        --,COALESCE(pay.note,'') as pay_note
        
    ,am.state AS state
      -- *********************************************************************************************** For Prepare By
      ,pay.write_date as prepare_date
      
      ,
	(SELECT b.name FROM resource_resource a LEFT JOIN hr_employee b ON a.id = b.resource_id WHERE a.user_id = pay.write_uid LIMIT 1) AS prepare_name
	,(SELECT COALESCE(j.name->>'th_TH', j.name->>'en_US', v.job_title, '') FROM resource_resource a LEFT JOIN hr_employee b ON a.id = b.resource_id LEFT JOIN hr_version v ON v.id = b.current_version_id LEFT JOIN hr_job j ON j.id = v.job_id WHERE a.user_id = pay.write_uid LIMIT 1) AS prepare_position
	,(SELECT COALESCE(d.name->>'th_TH', d.name->>'en_US', '') FROM resource_resource a LEFT JOIN hr_employee b ON a.id = b.resource_id LEFT JOIN hr_version v ON v.id = b.current_version_id LEFT JOIN hr_department d ON d.id = v.department_id WHERE a.user_id = pay.write_uid LIMIT 1) AS prepare_department
	,(SELECT c.store_fname FROM resource_resource a LEFT JOIN hr_employee b ON a.id = b.resource_id LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature' WHERE a.user_id = pay.write_uid LIMIT 1) AS prepare_signature
     
       -- *********************************************************************************************** For Pre Approval By
    ,(SELECT b.name FROM resource_resource a
        LEFT JOIN hr_employee b ON a.id = b.resource_id
        WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.payment' and res_id=pay.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_approved_name
    ,(SELECT COALESCE(c.name->>'th_TH', c.name->>'en_US', '') FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department c ON c.id = v.department_id
        WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.payment' and res_id=pay.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_department
    ,(SELECT COALESCE(c.name->>'th_TH', c.name->>'en_US', '') FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job c ON c.id = v.job_id
        WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.payment' and res_id=pay.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_position
    ,(SELECT a.reviewed_date FROM (SELECT * FROM tier_review WHERE model='account.payment' and res_id=pay.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)AS pre_date_decided
    ,(SELECT c.store_fname FROM resource_resource a
        LEFT JOIN hr_employee b ON a.id = b.resource_id
        LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
        WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.payment' and res_id=pay.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_signature
      -- *********************************************************************************************** For Final Approval By
     ,(SELECT b.name FROM resource_resource a
        LEFT JOIN hr_employee b ON a.id = b.resource_id
        WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.payment' and res_id=pay.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_name
    ,(SELECT COALESCE(c.name->>'th_TH', c.name->>'en_US', '') FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department c ON c.id = v.department_id
        WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.payment' and res_id=pay.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_department
    ,(SELECT COALESCE(c.name->>'th_TH', c.name->>'en_US', '') FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job c ON c.id = v.job_id
        WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.payment' and res_id=pay.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_position
    ,(SELECT reviewed_date FROM tier_review WHERE model='account.payment' and res_id=pay.id and status='approved' ORDER BY sequence DESC LIMIT 1) AS approved_date_decided
    ,(SELECT c.store_fname FROM resource_resource a
        LEFT JOIN hr_employee b ON a.id = b.resource_id
        LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
        WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.payment' and res_id=pay.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_signature
     -- ***********************************************************************************************
     
     , COALESCE((SELECT SUM(taxl.amount_currency) FROM account_move_line taxl WHERE taxl.move_id = inv.id AND taxl.display_type = 'tax'), 0.00) as amount_vat
     , (pay.amount - COALESCE((SELECT SUM(taxl.amount_currency) FROM account_move_line taxl WHERE taxl.move_id = inv.id AND taxl.display_type = 'tax'), 0.00)) as pay_amount_before_vat
     , COALESCE(pay.od19_wht_amount, 0.00) as amount_wht
     , COALESCE(pay.fee_amount, 0.00) as amount_fee
     , (pay.amount + COALESCE(pay.fee_amount, 0.00)) as amount_with_fee
        
from account_payment as pay
left join account_payment_method_line apml on apml.id = pay.payment_method_line_id
left join company_address_header_report c ON c.id = pay.company_id
left join res_partner as partner on partner.id = pay.partner_id
left join account_move as am on am.id = pay.move_id
left join account_journal as jn on jn.id = am.journal_id
left join account_move_line as aml on aml.move_id = am.id
left join account_account as aa on aa.id = aml.account_id
left outer join account_partial_reconcile as apr on apr.credit_move_id = aml.id
left outer join account_move_line as inv_aml on inv_aml.id = apr.debit_move_id
left outer join account_move as inv on inv.id = inv_aml.move_id

$P!{ids} and aa.account_type = 'asset_receivable' and am.state != 'cancel'
--WHERE pay.id  in (5)

order by pay.id]]>
	</queryString>
