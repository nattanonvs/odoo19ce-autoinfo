	<variable name="Page" class="java.lang.String">
		<variableExpression><![CDATA[$V{PAGE_NUMBER} + " OF " + $V{MASTER_TOTAL_PAGES}]]></variableExpression>
	</variable>
	<variable name="sum_residual" class="java.math.BigDecimal" resetType="Group" resetGroup="BillNo" calculation="Sum">
		<variableExpression><![CDATA[$F{invoice_payment_amount}]]></variableExpression>
	</variable>
	<group name="BillNo" isStartNewPage="true" isResetPageNumber="true" isReprintHeaderOnEachPage="true" footerPosition="StackAtBottom" keepTogether="true" preventOrphanFooter="true">
		<groupExpression><![CDATA[$F{pay_no}]]></groupExpression>
		<groupHeader>
