	<variable name="v_Group_Balance" class="java.math.BigDecimal" resetType="Group" resetGroup="Group_Header">
		<variableExpression><![CDATA[$V{v_Group_Debit}.add($V{T_debit}).subtract( ($V{v_Group_Credit}.add($V{T_credit})))]]></variableExpression>
