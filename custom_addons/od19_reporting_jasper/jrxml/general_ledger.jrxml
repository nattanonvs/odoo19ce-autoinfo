	<variable name="v_Balance_Accum" class="java.math.BigDecimal" resetType="Group" resetGroup="Group_Header" calculation="Sum">
		<variableExpression><![CDATA[$V{T_bal} == null ? $F{debit}.subtract($F{credit}) : 
$V{T_bal}.add($F{debit}).subtract($F{credit})]]></variableExpression>
	</variable>
	<variable name="v_Group_Debit" class="java.math.BigDecimal" resetType="Group" resetGroup="Group_Header" calculation="Sum">
