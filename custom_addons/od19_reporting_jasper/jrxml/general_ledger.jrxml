	<subDataset name="Empty Dataset1" uuid="05aa3d72-7dd1-411e-8b4c-54fb44be6bf1">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DB/Mcon_DB.xml"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="P_T__From_Date" class="java.lang.String"/>
		<parameter name="P_T_Account_id" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[SELECT
aml.account_id,
SUM(COALESCE(round(aml.debit ,2),0)) as debit,
SUM(COALESCE(round(aml.credit,2),0)) as credit
FROM account_move_line aml
left join account_move am on am.id=aml.move_id
WHERE aml.date < TO_DATE( $P{P_T__From_Date}  ,'yyyy-mm-dd')
and aml.account_id =  $P{P_T_Account_id}  and am.state = 'posted' --and aml.company_id = 1

GROUP BY aml.account_id]]>
		</queryString>
		<field name="account_id" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.label" value="account_id"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="account_move_line"/>
		</field>
		<field name="debit" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="debit"/>
		</field>
		<field name="credit" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="credit"/>
		</field>
		<variable name="V_T_Bal" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{debit}.subtract($F{credit})]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="v_credit" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{credit}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="v_debit" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{debit}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
	</subDataset>
	<parameter name="p_State" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["all"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Where" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[" and aml.account_id in (980) and am.state = 'posted' and aml.company_id = 1"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_AccountCodeText" class="java.lang.String"/>
	<parameter name="p_JournalText" class="java.lang.String"/>
	<parameter name="p_AnalyticAccountText" class="java.lang.String"/>
	<parameter name="p_DateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["dd-MM-yyyy"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_From_Date" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2023-01-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_To_Date" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2023-01-31"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_From_Date_Text" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2020-01-31"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_To_Date_Text" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["2020-01-31"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Sort" class="java.lang.String">
		<defaultValueExpression><![CDATA["order by aa.code_store->>(am.company_id::text), aml.date"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_SortingText" class="java.lang.String"/>
	<parameter name="p_Print_By" class="java.lang.String"/>
	<queryString>
		<![CDATA[select c.name AS company_name,
			aa.id AS account_id,
            aa.code_store->>(am.company_id::text) AS account_code,
            COALESCE(aa.name->>'th_TH', aa.name->>'en_US') AS account_name,
            aml.date AS date,
            am.name AS name,
            NULL as voucher_no,
            aj.code as journal_name,
            am.ref as reference,
            aml.name as label,
			aml.partner_id AS partner_id,
			res.name       AS partner_name,
			res.vat        AS partner_vat,
			res.branch_code AS partner_branch_code,
            COALESCE(round(aml.debit ,2),0) as debit,
            COALESCE(round(aml.credit,2),0) as credit
from account_move_line aml
left join account_move am on am.id=aml.move_id
left join res_partner res on res.id=aml.partner_id
left join account_account aa on aa.id= aml.account_id
left join account_journal aj on aj.id=am.journal_id
left join res_company c ON c.id=am.company_id
left join res_currency cur ON cur.id = c.currency_id
				
where aml.date >= TO_DATE($P{p_From_Date} ,'yyyy-mm-dd') 
    and aml.date <= TO_DATE($P{p_To_Date} ,'yyyy-mm-dd')
    and not (round(aml.credit, cur.decimal_places) = 0 and round(aml.debit, cur.decimal_places) = 0)
$P!{p_Where} 
$P!{p_Sort}]]>
	</queryString>
