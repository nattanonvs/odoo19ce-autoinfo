	</parameter>
	<queryString>
		<![CDATA[select row_number() over (partition by cash.id order by cash.id, cash_line.sequence, cash_line.id )  as rowid
    ,c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo      
	,COALESCE(c.company_address_thai,'') AS company_address_thai
	,COALESCE(c.company_address_en,'') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website
	,(SELECT a.name
		  FROM res_currency a
		  WHERE a.id=cash.currency_id
	)AS currency_name
	
	,COALESCE(partner.tax_name,'') as partner_tax_name
	,partner.vat as partner_tax_id
	,COALESCE(partner.branch_code,'00000') as partner_branch_code
	,COALESCE(partner.street,'' )as partner_street
	,COALESCE(partner.street2,'') as partner_street2
		,cash.id as pay_id
        ,cash.name as pay_no
	    ,cash.date as pay_date
	    ,'-' as pay_memo
	    
	    ,prod.default_code as product_code
	    ,cash_line.name as inv_description
	    ,cash_line.quantity as qty
	    ,uom.name as uom
	    ,cash_line.price_unit as price_unit
	    ,cash_line.discount as discount
	    ,'' as discount_type
	    ,cash_line.price_subtotal as subtotal
		
		,cash.amount as pay_amount
		,(cash.amount - COALESCE(cash.od19_wht_amount, 0.00)) as amount_net
		,convert_num_th_with_currency(cash.amount, cash.currency_id) AS bill_amount_total_bahttext
		,convert_num_en_with_currency(cash.amount, cash.currency_id) AS bill_amount_total_engtext
		,jn.name as pay_journal_name
		,case when jn.type = 'cash' then 1 else 0 end as is_cash
		,case when jn.type = 'bank' then 1 else 0 end as is_bank_transfer
		,case when cash.cheque_id is not null then 1 else 0 end as is_cheque
		
	  ,cash.state AS state
	  -- *********************************************************************************************** For Prepare By
	  ,cash.write_date as prepare_date
	  
	  ,
	(SELECT b.name FROM resource_resource a LEFT JOIN hr_employee b ON a.id = b.resource_id WHERE a.user_id = cash.write_uid LIMIT 1) AS prepare_name
	,(SELECT COALESCE(j.name->>'th_TH', j.name->>'en_US', v.job_title, '') FROM resource_resource a LEFT JOIN hr_employee b ON a.id = b.resource_id LEFT JOIN hr_version v ON v.id = b.current_version_id LEFT JOIN hr_job j ON j.id = v.job_id WHERE a.user_id = cash.write_uid LIMIT 1) AS prepare_position
	,(SELECT COALESCE(d.name->>'th_TH', d.name->>'en_US', '') FROM resource_resource a LEFT JOIN hr_employee b ON a.id = b.resource_id LEFT JOIN hr_version v ON v.id = b.current_version_id LEFT JOIN hr_department d ON d.id = v.department_id WHERE a.user_id = cash.write_uid LIMIT 1) AS prepare_department
	,(SELECT c.store_fname FROM resource_resource a LEFT JOIN hr_employee b ON a.id = b.resource_id LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature' WHERE a.user_id = cash.write_uid LIMIT 1) AS prepare_signature
	 
	   -- *********************************************************************************************** For Pre Approval By
	   ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.payment' and res_id=cash.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_approved_name
	   /*,(SELECT c.employee_name
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_name c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=cash.company_id and a.record_name=cash.name  limit 1
		) AS pre_approved_name*/

	   ,(SELECT COALESCE(c.name->>'th_TH', c.name->>'en_US', '') FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department c ON c.id = v.department_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.payment' and res_id=cash.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_department
	   	/*,(SELECT c.department_name
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_name c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=cash.company_id and a.record_name=cash.name  limit 1
		) AS pre_department*/

	    ,(SELECT COALESCE(c.name->>'th_TH', c.name->>'en_US', '') FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job c ON c.id = v.job_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.payment' and res_id=cash.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_position
		/*,(SELECT c.position_name
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_name c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=cash.company_id and a.record_name=cash.name  limit 1
		) AS pre_position*/

		,(SELECT a.reviewed_date FROM (SELECT * FROM tier_review WHERE model='account.payment' and res_id=cash.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)AS pre_date_decided
		/*,(SELECT b.date_decided
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_signature c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=cash.company_id and a.record_name=cash.name  limit 1
		) AS pre_date_decided*/

		,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.payment' and res_id=cash.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_signature
	   	/*,(SELECT c.store_fname
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_signature c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=cash.company_id and a.record_name=cash.name  limit 1
		) AS pre_signature*/

	  -- *********************************************************************************************** For Final Approval By
	  ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.payment' and res_id=cash.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_name
	  /*,(SELECT b.employee_name
		FROM company_final_approval a
		LEFT JOIN company_employee_name b on b.company_id=a.company_id and a.decided_by_user_id=b.user_id
		WHERE a.company_id=cash.company_id and a.record_name=cash.name  limit 1
		) AS approved_name*/

		,(SELECT COALESCE(c.name->>'th_TH', c.name->>'en_US', '') FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department c ON c.id = v.department_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.payment' and res_id=cash.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_department
		/*,(SELECT b.department_name
		FROM company_final_approval a
		LEFT JOIN company_employee_name b on b.company_id=a.company_id and a.decided_by_user_id=b.user_id
		WHERE a.company_id=cash.company_id and a.record_name=cash.name  limit 1
		) AS approved_department*/

		,(SELECT COALESCE(c.name->>'th_TH', c.name->>'en_US', '') FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job c ON c.id = v.job_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.payment' and res_id=cash.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_position
		/*,(SELECT b.position_name
		FROM company_final_approval a
		LEFT JOIN company_employee_name b on b.company_id=a.company_id and a.decided_by_user_id=b.user_id
		WHERE a.company_id=cash.company_id and a.record_name=cash.name  limit 1
		) AS approved_position*/

		,(SELECT reviewed_date FROM tier_review WHERE model='account.payment' and res_id=cash.id and status='approved' ORDER BY sequence DESC LIMIT 1) AS approved_date_decided
		/*,(SELECT a.date_decided
		FROM company_final_approval a
		WHERE a.company_id=cash.company_id and a.record_name=cash.name  limit 1
		) AS approved_date_decided*/

		,'' as approved_status
		/*,(SELECT a.status
		FROM company_final_approval a
		WHERE a.company_id=cash.company_id and a.record_name=cash.name  limit 1
		) AS approved_status*/

		,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.payment' and res_id=cash.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_signature
		/*,(SELECT b.store_fname
		FROM company_final_approval a
		LEFT JOIN company_employee_signature b on b.company_id=a.company_id and a.decided_by_user_id=b.user_id
		WHERE a.company_id=cash.company_id and a.record_name=cash.name  limit 1
		) AS approved_signature */
	 -- *********************************************************************************************** 
	 
	  , COALESCE((SELECT SUM(taxl.amount_currency) FROM account_move_line taxl WHERE taxl.move_id = invoice.id AND taxl.display_type = 'tax'), 0.00) as amount_vat
	 ,  (cash.amount - COALESCE((SELECT SUM(taxl.amount_currency) FROM account_move_line taxl WHERE taxl.move_id = invoice.id AND taxl.display_type = 'tax'), 0.00)) as pay_amount_before_vat
	 , cash.amount as amount_total
	
	,case when coalesce(cash_line.discount, 0) <> 0 then concat(cash_line.discount, '%') else '' end as discount_text
		
from account_payment as cash
left join res_currency as cur on cur.id = cash.currency_id
left join account_move__account_payment rel on rel.payment_id = cash.id
left join account_move as invoice on invoice.id = rel.invoice_id
left join account_move_line as cash_line on cash_line.move_id = invoice.id and (cash_line.display_type is null or cash_line.display_type not in ('tax','payment_term'))
left join uom_uom as uom on uom.id = cash_line.product_uom_id
left join product_product as prod on cash_line.product_id = prod.id
left join account_journal as jn on jn.id = cash.journal_id
left join company_address_header_report c ON c.id = cash.company_id
left join res_partner as partner on partner.id = cash.partner_id
$P!{ids}

order by cash.id]]>
	</queryString>
