	</parameter>
	<queryString>
		<![CDATA[select 
	c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo      
	,COALESCE(c.company_address_thai,'') AS company_address_thai
	,COALESCE(c.company_address_en,'') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website
	
	,(SELECT a.name
		  FROM res_currency a
		  WHERE a.id=bill.currency_id
	)AS currency_name
	
	,COALESCE(partner.tax_name,'') as partner_tax_name
	,partner.vat as partner_tax_id
	,COALESCE(partner.branch_code,'00000' ) as partner_branch_code
	,COALESCE(partner.street,'' )as partner_street
	,COALESCE(partner.street2,'') as partner_street2
		
		,bill.name as bill_number
        ,min(bill.invoice_date) over (partition by bill.partner_id, bill.currency_id) as bill_date
        ,bill.invoice_date as doc_date
        --,bill.actual_due_date as bill_due_date
        ,COALESCE(bill.narration,'') as billing_note
	    ,bill.name as invoice_number
        ,bill.invoice_date as invoice_date
        ,COALESCE(bill.invoice_date_due, bill.invoice_date) as invoice_due_date
        ,COALESCE(term.name->>'th_TH', term.name->>'en_US', '') as payment_method
        ,bill.move_type as invoice_type
        
       ,(case
				when bill.move_type='out_refund' then bill.amount_total*-1
				else bill.amount_total
		  end
		  )invoice_amount

		,(case
				when bill.move_type='out_refund' then bill.amount_residual*-1
				else bill.amount_residual
		  end
		  )invoice_residual
			
		,convert_num_th_with_currency((sum(case when bill.move_type='out_refund' then bill.amount_residual*-1 else bill.amount_residual end) over (partition by bill.partner_id, bill.currency_id)), bill.currency_id) as bill_amount_total_bahttext

		,convert_num_en_with_currency((sum(case when bill.move_type='out_refund' then bill.amount_residual*-1 else bill.amount_residual end) over (partition by bill.partner_id, bill.currency_id)), bill.currency_id) as bill_amount_total_engtext

	,bill.state AS state
	  -- *********************************************************************************************** For Prepare By
	  ,bill.write_date as prepare_date

	  ,
	(SELECT b.name FROM resource_resource a LEFT JOIN hr_employee b ON a.id = b.resource_id WHERE a.user_id = bill.write_uid LIMIT 1) AS prepare_name
	,(SELECT COALESCE(j.name->>'th_TH', j.name->>'en_US', v.job_title, '') FROM resource_resource a LEFT JOIN hr_employee b ON a.id = b.resource_id LEFT JOIN hr_version v ON v.id = b.current_version_id LEFT JOIN hr_job j ON j.id = v.job_id WHERE a.user_id = bill.write_uid LIMIT 1) AS prepare_position
	,(SELECT COALESCE(d.name->>'th_TH', d.name->>'en_US', '') FROM resource_resource a LEFT JOIN hr_employee b ON a.id = b.resource_id LEFT JOIN hr_version v ON v.id = b.current_version_id LEFT JOIN hr_department d ON d.id = v.department_id WHERE a.user_id = bill.write_uid LIMIT 1) AS prepare_department
	,(SELECT c.store_fname FROM resource_resource a LEFT JOIN hr_employee b ON a.id = b.resource_id LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature' WHERE a.user_id = bill.write_uid LIMIT 1) AS prepare_signature
	 
	   -- *********************************************************************************************** For Pre Approval By
	   ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.move' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_approved_name
	   /*,(SELECT c.employee_name
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_name c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS pre_approved_name*/

	   ,(SELECT COALESCE(c.name->>'th_TH', c.name->>'en_US', '') FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department c ON c.id = v.department_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.move' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_department
	   	/*,(SELECT c.department_name
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_name c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS pre_department*/

	    ,(SELECT COALESCE(c.name->>'th_TH', c.name->>'en_US', '') FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job c ON c.id = v.job_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.move' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_position
		/*,(SELECT c.position_name
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_name c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS pre_position*/

		,(SELECT a.reviewed_date FROM (SELECT * FROM tier_review WHERE model='account.move' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)AS pre_date_decided
		/*,(SELECT b.date_decided
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_signature c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS pre_date_decided*/

		,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='account.move' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_signature
	   	/*,(SELECT c.store_fname
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_signature c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS pre_signature */
		
	  -- *********************************************************************************************** For Final Approval By
	  ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.move' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_name
	  /*,(SELECT b.employee_name
		FROM company_final_approval a
		LEFT JOIN company_employee_name b on b.company_id=a.company_id and a.decided_by_user_id=b.user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS approved_name*/

		,(SELECT COALESCE(c.name->>'th_TH', c.name->>'en_US', '') FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department c ON c.id = v.department_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.move' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_department
		/*,(SELECT b.department_name
		FROM company_final_approval a
		LEFT JOIN company_employee_name b on b.company_id=a.company_id and a.decided_by_user_id=b.user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS approved_department*/

		,(SELECT COALESCE(c.name->>'th_TH', c.name->>'en_US', '') FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job c ON c.id = v.job_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.move' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_position
		/*,(SELECT b.position_name
		FROM company_final_approval a
		LEFT JOIN company_employee_name b on b.company_id=a.company_id and a.decided_by_user_id=b.user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS approved_position*/

		,(SELECT reviewed_date FROM tier_review WHERE model='account.move' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 1) AS approved_date_decided
		/*,(SELECT a.date_decided
		FROM company_final_approval a
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS approved_date_decided*/

		,'' as approved_status
		/*,(SELECT a.status
		FROM company_final_approval a
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS approved_status*/

		,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.move' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_signature
		/*,(SELECT b.store_fname
		FROM company_final_approval a
		LEFT JOIN company_employee_signature b on b.company_id=a.company_id and a.decided_by_user_id=b.user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS approved_signature */
	 -- *********************************************************************************************** 

from account_move as bill
left join account_payment_term term on term.id = bill.invoice_payment_term_id
left join company_address_header_report c on ( c.id=bill.company_id )
left join res_partner partner on ( partner.id = bill.partner_id )

$P!{ids}

order by bill.partner_id, bill.id, invoice_due_date]]>
	</queryString>
