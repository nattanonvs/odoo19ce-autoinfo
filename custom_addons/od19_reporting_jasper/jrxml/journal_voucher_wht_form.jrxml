		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
  COALESCE(awm.wht_cert_income_desc,'') AS name
 ,awm.date AS pay_date
 ,COALESCE(awm.wht_cert_income_type,'') AS income_type
 ,COALESCE((SELECT aht.name FROM account_withholding_tax aht WHERE aht.id = awm.wht_tax_id), '') AS tax_type
 ,COALESCE((SELECT aht.amount FROM account_withholding_tax aht WHERE aht.id = awm.wht_tax_id), 0)::numeric AS tax_rate1
 ,0::numeric AS tax_rate2
 ,0::numeric AS tax_rate3
 ,COALESCE(awm.amount_income,0)::numeric AS pay_amount1
 ,0::numeric AS pay_amount2
 ,0::numeric AS pay_amount3
 ,COALESCE(awm.amount_wht,0)::numeric AS wht_amount1
 ,0::numeric AS wht_amount2
 ,0::numeric AS wht_amount3
 ,COALESCE(awm.wht_cert_income_type,'') AS income_type1
 ,''::varchar AS income_type2
 ,''::varchar AS income_type3
FROM account_withholding_move awm
WHERE awm.move_id = $P{p_move_id} AND awm.cancelled IS NOT TRUE]]>
	</queryString>
