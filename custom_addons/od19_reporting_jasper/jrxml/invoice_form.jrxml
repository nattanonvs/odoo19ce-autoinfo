		<groupHeader>
			<band height="106">
				<textField evaluationTime="Group" evaluationGroup="group_id">
					<reportElement mode="Transparent" x="376" y="6" width="175" height="22" backcolor="#EDEDED" uuid="108e4b1b-5c52-4137-ae5f-fd900099422d"/>
					<box>
