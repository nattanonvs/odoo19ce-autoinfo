		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
  COALESCE((SELECT t.name->>'th_TH' FROM account_tax t WHERE t.id = amti.tax_line_id), '') AS vat_name
 ,COALESCE(amti.tax_invoice_number,'') AS vat_no
 ,amti.tax_invoice_date AS vat_date
 ,COALESCE(amti.tax_base_amount,0) AS vat_toal_amount
 ,COALESCE(amti.balance,0) AS vat_amount
 ,amti.move_id AS invoice_id
 ,amti.move_id
FROM account_move_tax_invoice amti
WHERE amti.move_id = $P{p_move_id}]]>
	</queryString>
