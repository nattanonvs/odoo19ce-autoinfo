		<property name="com.jaspersoft.studio.field.label" value="account_name_en"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="account_account"/>
	</field>
	<field name="account_name_th" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="account_name_th"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="account_account"/>
	</field>
	<field name="before_debit" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="before_debit"/>
	</field>
	<field name="before_credit" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="before_credit"/>
	</field>
	<field name="current_debit" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="current_debit"/>
	</field>
	<field name="current_credit" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="current_credit"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="account_move_line"/>
	</field>
	<field name="next_debit" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="next_debit"/>
	</field>
	<field name="next_credit" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="next_credit"/>
	</field>
	<variable name="v_Before_Debit" class="java.math.BigDecimal">
		<variableExpression><![CDATA[IF ($F{before_debit}.compareTo($F{before_credit}) == 1, 
	$F{before_debit}.subtract($F{before_credit}),
	BigDecimal.ZERO
)]]></variableExpression>
	</variable>
	<variable name="v_Before_Credit" class="java.math.BigDecimal">
		<variableExpression><![CDATA[IF ($F{before_credit}.compareTo($F{before_debit}) == 1, 
	$F{before_credit}.subtract($F{before_debit}),
	BigDecimal.ZERO
)]]></variableExpression>
	</variable>
	<variable name="v_Next_Debit" class="java.math.BigDecimal">
		<variableExpression><![CDATA[IF( $V{v_Before_Debit}.add($F{current_debit}).subtract($V{v_Before_Credit}.add($F{current_credit})).compareTo(BigDecimal.ZERO) == 1,
	 $V{v_Before_Debit}.add($F{current_debit}).subtract($V{v_Before_Credit}.add($F{current_credit})),
	 BigDecimal.ZERO
)]]></variableExpression>
	</variable>
	<variable name="v_Next_Credit" class="java.math.BigDecimal">
		<variableExpression><![CDATA[IF( $V{v_Before_Credit}.add($F{current_credit}).subtract($V{v_Before_Debit}.add($F{current_debit})).compareTo(BigDecimal.ZERO) == 1,
	 $V{v_Before_Credit}.add($F{current_credit}).subtract($V{v_Before_Debit}.add($F{current_debit})),
	 BigDecimal.ZERO
)]]></variableExpression>
	</variable>
	<variable name="v_Sum_Before_Debit" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{before_debit}]]></variableExpression>
	</variable>
	<variable name="v_Sum_Before_Credit" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{before_credit}]]></variableExpression>
	</variable>
	<variable name="v_Sum_Current_Debit" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{current_debit}]]></variableExpression>
	</variable>
	<variable name="v_Sum_Current_Credit" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{current_credit}]]></variableExpression>
	</variable>
	<variable name="v_Sum_Next_Debit" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{next_debit}]]></variableExpression>
	</variable>
	<variable name="v_Sum_Next_Credit" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{next_credit}]]></variableExpression>
	</variable>
