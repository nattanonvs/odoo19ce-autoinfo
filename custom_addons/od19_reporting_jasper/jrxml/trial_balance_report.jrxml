	<queryString>
		<![CDATA[;WITH CTE AS (SELECT c.name AS company_name, c.name AS company_name_en,
               aa.code_store->>('$P!{p_Company}') AS account_code,
               CASE WHEN '$P!{p_language}' = 'english' THEN
                    CASE aa.account_type
                        WHEN 'asset_receivable' THEN 'Receivable'
                        WHEN 'asset_cash' THEN 'Bank and Cash'
                        WHEN 'asset_current' THEN 'Current Assets'
                        WHEN 'asset_non_current' THEN 'Non-current Assets'
                        WHEN 'asset_prepayments' THEN 'Prepayments'
                        WHEN 'asset_fixed' THEN 'Fixed Assets'
                        WHEN 'liability_payable' THEN 'Payable'
                        WHEN 'liability_credit_card' THEN 'Credit Card'
                        WHEN 'liability_current' THEN 'Current Liabilities'
                        WHEN 'liability_non_current' THEN 'Non-current Liabilities'
                        WHEN 'equity' THEN 'Equity'
                        WHEN 'equity_unaffected' THEN 'Current Year Earnings'
                        WHEN 'income' THEN 'Income'
                        WHEN 'income_other' THEN 'Other Income'
                        WHEN 'expense' THEN 'Expenses'
                        WHEN 'expense_other' THEN 'Other Expenses'
                        WHEN 'expense_depreciation' THEN 'Depreciation'
                        WHEN 'expense_direct_cost' THEN 'Cost of Revenue'
                        WHEN 'off_balance' THEN 'Off-Balance Sheet'
                        ELSE aa.account_type
                    END
                    ELSE
                    CASE aa.account_type
                        WHEN 'asset_receivable' THEN 'ลูกหนี้การค้า'
                        WHEN 'asset_cash' THEN 'เงินสดและธนาคาร'
                        WHEN 'asset_current' THEN 'สินทรัพย์หมุนเวียน'
                        WHEN 'asset_non_current' THEN 'สินทรัพย์ไม่หมุนเวียน'
                        WHEN 'asset_prepayments' THEN 'ค่าใช้จ่ายล่วงหน้า'
                        WHEN 'asset_fixed' THEN 'สินทรัพย์ถาวร'
                        WHEN 'liability_payable' THEN 'เจ้าหนี้การค้า'
                        WHEN 'liability_credit_card' THEN 'บัตรเครดิต'
                        WHEN 'liability_current' THEN 'หนี้สินหมุนเวียน'
                        WHEN 'liability_non_current' THEN 'หนี้สินไม่หมุนเวียน'
                        WHEN 'equity' THEN 'ส่วนของเจ้าของ'
                        WHEN 'equity_unaffected' THEN 'กำไร(ขาดทุน)ปีปัจจุบัน'
                        WHEN 'income' THEN 'รายได้'
                        WHEN 'income_other' THEN 'รายได้อื่น'
                        WHEN 'expense' THEN 'ค่าใช้จ่าย'
                        WHEN 'expense_other' THEN 'ค่าใช้จ่ายอื่น'
                        WHEN 'expense_depreciation' THEN 'ค่าเสื่อมราคา'
                        WHEN 'expense_direct_cost' THEN 'ต้นทุนขาย'
                        WHEN 'off_balance' THEN 'บัญชีนอกงบดุล'
                        ELSE aa.account_type
                    END
               END AS account_type_name,
               COALESCE(aa.name->>'en_US', aa.name->>'th_TH') AS account_name_en,
               COALESCE(aa.name->>'th_TH', aa.name->>'en_US') AS account_name_th,

              round(COALESCE((select sum(amld.debit)
                                    from account_move_line amld
                                    inner join account_move amd on amd.id = amld.move_id
                                    inner join account_account aad on aad.id = amld.account_id
                                    where date(amld.date) < date($P{p_From_Date})
                                        and aad.id = aa.id
                                        $P!{p_Where} 
              ), 0) , 2) AS before_debit,
              round(COALESCE((select sum(amld.credit)
                                    from account_move_line amld
                                    inner join account_move amd on amd.id = amld.move_id
                                    inner join account_account aad on aad.id = amld.account_id
                                    where date(amld.date) < date($P{p_From_Date})
                                        and aad.id = aa.id
                                        $P!{p_Where} 
              ), 0) , 2) AS before_credit,
             COALESCE((select round(sum(amld.debit),2)
                                    from account_move_line amld
                                    inner join account_move amd on amd.id = amld.move_id
                                    inner join account_account aad on aad.id = amld.account_id
                                    where date(amld.date) >= date($P{p_From_Date}) and date(amld.date) <= date($P{p_To_Date})
                                        and aad.id = aa.id
                                        $P!{p_Where} 
              ), 0) AS current_debit,
              COALESCE((select round(sum(amld.credit),2)
                                    from account_move_line amld
                                    inner join account_move amd on amd.id = amld.move_id
                                    inner join account_account aad on aad.id = amld.account_id
                                    where date(amld.date) >= date($P{p_From_Date}) and date(amld.date) <= date($P{p_To_Date})
                                        and aad.id = aa.id
                                        $P!{p_Where} 
              ), 0) AS current_credit
              
from account_account aa
left join res_company c ON c.id = $P!{p_Company}
where aa.code_store->>'$P!{p_Company}' is not null
), CTE2 AS (
    select company_name, company_name_en, account_code, account_type_name, account_name_en, account_name_th
        , case when before_debit - before_credit = 0 then 0 else case when before_debit - before_credit > 0 then before_debit - before_credit else 0 end end as before_debit
        , case when before_debit - before_credit = 0 then 0 else case when before_debit - before_credit > 0 then 0 else ABS(before_debit - before_credit) end end as before_credit
        , current_debit, current_credit
     from CTE
)
select *
    , case when before_debit - before_credit + current_debit - current_credit > 0 
    THEN before_debit - before_credit + current_debit - current_credit
    ELSE 0
    END AS next_debit
    , case when before_debit - before_credit + current_debit - current_credit > 0 
    THEN 0
    ELSE ABS(before_debit - before_credit + current_debit - current_credit)
    END AS next_credit
    from CTE2
where case when '$P!{p_Show_Balance_Zero}' = 'N' THEN before_debit + before_credit + current_debit + current_credit
ELSE 1 END <> 0
order by account_code]]>
	</queryString>
	<field name="company_name" class="java.lang.String">
