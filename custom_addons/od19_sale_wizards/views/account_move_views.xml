<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The "get sale order lines" entry point now goes through the shared
         od19_document_pull mechanism, which already adds the pull/remove
         buttons to the invoice form, so no extra button is declared here. -->

    <!-- Add "Downpayment Info" group to the Other Info tab of invoices. -->
    <record id="view_move_form_od19_downpayment_info" model="ir.ui.view">
        <field name="name">account.move.form.od19.downpayment.info</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='other_tab_group']" position="inside">
                <group string="Downpayment Info / ข้อมูลเงินมัดจำ"
                       name="od19_downpayment_info_group"
                       invisible="not od19_downpayment_origin and not od19_source_po_name">
                    <field name="od19_downpayment_origin"/>
                    <field name="od19_downpayment_source"/>
                    <field name="od19_source_po_name"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
