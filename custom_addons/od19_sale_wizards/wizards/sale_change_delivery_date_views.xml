<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_sale_change_delivery_date_form" model="ir.ui.view">
        <field name="name">od19.sale.change.delivery.date.form</field>
        <field name="model">od19.sale.change.delivery.date</field>
        <field name="arch" type="xml">
            <form string="Change Delivery Date / เปลี่ยนวันที่จัดส่ง">
                <sheet>
                    <group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="new_delivery_date"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        This will update the commitment date of the sale order
                        and recompute the scheduled date of every order line.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply"
                            type="object"
                            string="Apply"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
