<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_account_invoice_get_sale_lines_form" model="ir.ui.view">
        <field name="name">od19.account.invoice.get.sale.lines.form</field>
        <field name="model">od19.account.invoice.get.sale.lines</field>
        <field name="arch" type="xml">
            <form string="Get Sale Order Lines / ดึงรายการจากใบสั่งขาย">
                <sheet>
                    <group>
                        <group>
                            <field name="invoice_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="sale_order_id"/>
                        </group>
                    </group>
                    <group string="Available Lines / รายการที่สามารถเลือกได้">
                        <field name="sale_line_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Select a confirmed sale order, then pick the lines you
                        want to add to this invoice. Only lines that are not
                        yet fully invoiced are shown.
                    </div>
                </sheet>
                <footer>
                    <button name="action_get_lines"
                            type="object"
                            string="Get Lines"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
