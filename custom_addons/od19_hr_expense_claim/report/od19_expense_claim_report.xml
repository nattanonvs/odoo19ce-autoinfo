<odoo>

    <!-- ============================================================
         เอกสารเบิกค่าใช้จ่าย (Expense Claim document)
         พิมพ์ได้ทั้งจากฟอร์มหลังบ้านและพอร์ทัลพนักงาน: แสดงรายการเบิก
         ยอดรวม และ "ผู้อนุมัติครบ" (ลำดับ/ชื่อขั้น/ผู้อนุมัติ/วันที่/สถานะ)
         พร้อมช่องลงนาม 3 ช่อง (ผู้เบิก / ผู้อนุมัติ / ผู้จ่าย)
         ============================================================ -->
    <template id="od19_expense_claim_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="claim">
                <t t-set="company" t-value="claim.company_id"/>
                <t t-call="web.external_layout">
                    <div class="page" style="font-family:'Sarabun','Noto Sans Thai','Tahoma',sans-serif;">
                        <h2 class="text-center">ใบเบิกค่าใช้จ่าย</h2>
                        <h4 class="text-center">EXPENSE CLAIM</h4>

                        <div class="row mt-3">
                            <div class="col-7">
                                <div>
                                    <strong>พนักงาน / Employee: </strong>
                                    <span t-field="claim.employee_id.name"/>
                                </div>
                                <div t-if="claim.department_id">
                                    <strong>แผนก / Department: </strong>
                                    <span t-field="claim.department_id.name"/>
                                </div>
                                <div>
                                    <strong>บริษัท / Company: </strong>
                                    <span t-field="claim.company_id.name"/>
                                </div>
                                <div>
                                    <strong>วิธีจ่าย / Paid By: </strong>
                                    <span t-out="dict(claim._fields['payment_mode'].selection).get(claim.payment_mode)"/>
                                </div>
                            </div>
                            <div class="col-5 text-right">
                                <div>
                                    <strong>เลขที่ / Reference: </strong>
                                    <span t-field="claim.name"/>
                                </div>
                                <div>
                                    <strong>วันที่ / Date: </strong>
                                    <span t-field="claim.date"/>
                                </div>
                                <div>
                                    <strong>สถานะ / Status: </strong>
                                    <span t-out="dict(claim._fields['state'].selection).get(claim.state)"/>
                                </div>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered mt-4">
                            <thead class="thead-light">
                                <tr>
                                    <th class="text-center" style="width:8%">ลำดับ</th>
                                    <th>รายการ / Description</th>
                                    <th style="width:18%">หมวดค่าใช้จ่าย / Category</th>
                                    <th style="width:22%">ศูนย์ต้นทุน / Analytic</th>
                                    <th class="text-right" style="width:15%">จำนวนเงิน / Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="claim.line_ids" t-as="line">
                                    <tr>
                                        <td class="text-center"><t t-out="line_index + 1"/></td>
                                        <td>
                                            <span t-out="line.name or ''"/>
                                            <div t-if="line.od19_is_mileage" style="font-size:11px;color:#666;">
                                                <span t-if="line.od19_mileage_origin"><t t-out="line.od19_mileage_origin"/> → </span>
                                                <t t-out="line.od19_mileage_destination"/>
                                                <t t-if="line.od19_mileage_distance_km"> (<t t-out="line.od19_mileage_distance_km"/> กม.)</t>
                                            </div>
                                        </td>
                                        <td><span t-field="line.product_id"/></td>
                                        <td>
                                            <t t-if="line.analytic_distribution">
                                                <t t-foreach="line.analytic_distribution" t-as="dist">
                                                    <span t-if="str(dist).isdigit()">
                                                        <t t-out="line.env['account.analytic.account'].sudo().browse(int(dist)).display_name"/>
                                                    </span>
                                                </t>
                                            </t>
                                            <t t-else="">-</t>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="line.total_amount"
                                                  t-options='{"widget": "monetary", "display_currency": claim.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="font-weight-bold">
                                    <td colspan="4" class="text-right">รวมทั้งสิ้น / Total</td>
                                    <td class="text-right">
                                        <span t-field="claim.total_amount"
                                              t-options='{"widget": "monetary", "display_currency": claim.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row mt-2">
                            <div class="col-12">
                                <strong>จำนวนเงิน (ตัวอักษร): </strong>
                                <span t-out="claim.currency_id.amount_to_text(claim.total_amount)"/>
                            </div>
                        </div>

                        <!-- ผู้อนุมัติครบ / Full approval trail -->
                        <h5 class="mt-4">ขั้นตอนการอนุมัติ / Approval Trail</h5>
                        <t t-if="claim.review_ids">
                            <table class="table table-sm table-bordered">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="text-center" style="width:8%">ขั้นที่</th>
                                        <th>ขั้นตอนอนุมัติ / Tier</th>
                                        <th style="width:22%">ผู้อนุมัติ / Approver</th>
                                        <th style="width:18%">วันที่ / Date</th>
                                        <th style="width:15%">สถานะ / Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="claim.review_ids.sorted('sequence')" t-as="review">
                                        <tr>
                                            <td class="text-center"><t t-out="review.sequence"/></td>
                                            <td><t t-out="review.name"/></td>
                                            <td>
                                                <t t-if="review.done_by">
                                                    <span t-out="review.done_by.name"/>
                                                </t>
                                                <t t-elif="review.reviewer_ids">
                                                    <t t-out="', '.join(review.reviewer_ids.mapped('name'))"/>
                                                </t>
                                                <t t-else="">-</t>
                                            </td>
                                            <td>
                                                <t t-if="review.reviewed_date">
                                                    <span t-field="review.reviewed_date"/>
                                                </t>
                                            </td>
                                            <td>
                                                <t t-out="dict(review._fields['status'].selection).get(review.status)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p class="text-muted">ยังไม่มีขั้นตอนการอนุมัติ</p>
                        </t>

                        <div class="row mt-5">
                            <div class="col-4 text-center">
                                <div>__________________________</div>
                                <div>ผู้เบิก / Claimant</div>
                            </div>
                            <div class="col-4 text-center">
                                <div>__________________________</div>
                                <div>ผู้อนุมัติ / Approver</div>
                            </div>
                            <div class="col-4 text-center">
                                <div>__________________________</div>
                                <div>ผู้จ่ายเงิน / Cashier</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_od19_expense_claim" model="ir.actions.report">
        <field name="name">Expense Claim (ใบเบิกค่าใช้จ่าย)</field>
        <field name="model">od19.expense.claim</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">od19_hr_expense_claim.od19_expense_claim_document</field>
        <field name="report_file">od19_hr_expense_claim.od19_expense_claim_document</field>
        <field name="binding_model_id" ref="model_od19_expense_claim"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Expense Claim - %s' % (object.name or '')</field>
    </record>

</odoo>
