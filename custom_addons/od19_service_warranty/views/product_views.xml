<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_warranty" model="ir.ui.view">
        <field name="name">product.template.form.warranty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Warranty">
                    <field name="warranty_type"/>
                    <field name="warranty_duration" invisible="warranty_type == 'none'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
