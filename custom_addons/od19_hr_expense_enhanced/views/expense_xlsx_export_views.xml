<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- XLSX Export Wizard                                           -->
    <!-- ============================================================ -->
    <record id="view_od19_expense_xlsx_export_form" model="ir.ui.view">
        <field name="name">od19.expense.xlsx.export.form</field>
        <field name="model">od19.expense.xlsx.export</field>
        <field name="arch" type="xml">
            <form string="Export Expenses to XLSX">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="cash_state"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Leave filters blank to include all expenses in the selected date range.
                    </div>
                </sheet>
                <footer>
                    <button name="action_export"
                            type="object"
                            string="Export XLSX"
                            class="btn-primary"
                            icon="fa-file-excel-o"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_od19_expense_xlsx_export" model="ir.actions.act_window">
        <field name="name">Export Expenses to XLSX</field>
        <field name="res_model">od19.expense.xlsx.export</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_od19_expense_xlsx_export_form"/>
        <field name="target">new</field>
    </record>

    <!-- ============================================================ -->
    <!-- Return Cash Wizard                                           -->
    <!-- ============================================================ -->
    <record id="view_od19_expense_return_cash_form" model="ir.ui.view">
        <field name="name">od19.expense.return.cash.form</field>
        <field name="model">od19.expense.return.cash</field>
        <field name="arch" type="xml">
            <form string="Return Cash / คืนเงิน">
                <sheet>
                    <group>
                        <group>
                            <field name="expense_id"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="return_date"/>
                            <field name="journal_id"/>
                            <field name="create_accounting_entry"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_return_cash"
                            type="object"
                            string="Return Cash"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Reset Cash State Wizard                                      -->
    <!-- ============================================================ -->
    <record id="view_od19_expense_reset_form" model="ir.ui.view">
        <field name="name">od19.expense.reset.form</field>
        <field name="model">od19.expense.reset</field>
        <field name="arch" type="xml">
            <form string="Reset Cash State / รีเซ็ตสถานะเงินสด">
                <sheet>
                    <group>
                        <field name="expense_id"/>
                        <field name="new_state"/>
                        <field name="reason"/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        This action is restricted to administrators and will be logged.
                    </div>
                </sheet>
                <footer>
                    <button name="action_reset"
                            type="object"
                            string="Reset"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Delegate Approval Wizard                                     -->
    <!-- ============================================================ -->
    <record id="view_od19_expense_delegate_form" model="ir.ui.view">
        <field name="name">od19.expense.delegate.form</field>
        <field name="model">od19.expense.delegate</field>
        <field name="arch" type="xml">
            <form string="Delegate Approval / มอบหมายการอนุมัติ">
                <sheet>
                    <group>
                        <field name="expense_id"/>
                        <field name="delegate_approver_id"/>
                        <field name="reason"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_delegate"
                            type="object"
                            string="Delegate"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
