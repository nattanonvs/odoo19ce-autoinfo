<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend account.payment form view with WHT fields for expense payments -->
    <record id="view_account_payment_form_wht" model="ir.ui.view">
        <field name="name">account.payment.form.wht</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="od19_is_expense_payment" invisible="1"/>
                <group string="Withholding Tax / ภาษีหัก ณ ที่จ่าย"
                       invisible="not od19_is_expense_payment">
                    <group>
                        <field name="od19_wht_type"/>
                        <field name="od19_wht_base_amount"/>
                    </group>
                    <group>
                        <field name="od19_wht_amount" readonly="1"/>
                        <field name="od19_wht_expense_account_id"
                               invisible="od19_wht_type == False"
                               required="od19_wht_type != False"/>
                        <field name="od19_wht_payable_account_id"
                               invisible="od19_wht_type == False"
                               required="od19_wht_type != False"/>
                    </group>
                    <field name="od19_wht_move_id" readonly="1"
                           invisible="od19_wht_move_id == False"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
