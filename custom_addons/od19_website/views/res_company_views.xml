<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Res Company: Website branding fields                          -->
    <!-- ============================================================ -->
    <record id="res_company_view_form_inherit_od19_website" model="ir.ui.view">
        <field name="name">res.company.form.inherit.od19.website</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Website" name="od19_website">
                    <group>
                        <group string="Branding">
                            <field name="od19_website_tagline"/>
                            <field name="od19_website_primary_color" widget="color"/>
                            <field name="od19_website_secondary_color" widget="color"/>
                        </group>
                        <group string="Hero Section">
                            <field name="od19_website_hero_title"/>
                            <field name="od19_website_hero_subtitle"/>
                        </group>
                    </group>
                    <group string="Social Media">
                        <field name="od19_website_facebook_url"/>
                        <field name="od19_website_linkedin_url"/>
                        <field name="od19_website_youtube_url"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
