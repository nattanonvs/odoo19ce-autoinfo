<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Contact Us Page – override the default Odoo contact page       -->
    <!-- ============================================================ -->
    <template id="od19_contact_page" name="Contact Page" inherit_id="website.contactus" priority="20">

        <!-- Replace the default parallax title band with a branded hero -->
        <xpath expr="//section[hasclass('s_title')]" position="replace">
            <section class="od19-page-hero od19-pc-reveal">
                <div class="od19-page-hero-overlay"/>
                <div class="container">
                    <span class="od19-eyebrow">Get in Touch</span>
                    <h1>Contact Us</h1>
                    <p class="od19-lead">
                        Talk to our engineers about industrial, building or terminal automation —
                        quotations, service contracts, spare parts or a long-term partnership.
                    </p>
                    <div class="od19-hero-actions">
                        <a href="tel:+6629345410" class="btn btn-hero">
                            <i class="fa fa-phone"/> +66 2 934 5410-6
                        </a>
                        <a href="mailto:sales@auto-info.co.th" class="btn btn-ghost-light">
                            <i class="fa fa-envelope"/> sales@auto-info.co.th
                        </a>
                    </div>
                </div>
            </section>
        </xpath>

        <!-- Replace the default "My Company" sidebar with Auto-Info details -->
        <xpath expr="//div[hasclass('col-lg-4') and .//h5[text()='My Company']]" position="replace">
            <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0">
                <h5 style="color:var(--od19-primary);font-weight:700;">
                    <i class="fa fa-building me-2"/>The Auto-Info Co., Ltd.
                </h5>
                <ul class="list-unstyled mb-0 ps-2">
                    <li class="mb-2">
                        <i class="fa fa-map-marker fa-fw me-2" style="color:var(--od19-secondary);"/>
                        1359 Soi Ladprao 94 (Panjamitr), Ladprao Rd., Plubpla, Wangthonglang, Bangkok 10310
                    </li>
                    <li class="mb-2">
                        <i class="fa fa-phone fa-fw me-2" style="color:var(--od19-secondary);"/>
                        +66 2 934 5410-6
                    </li>
                    <li class="mb-2">
                        <i class="fa fa-fax fa-fw me-2" style="color:var(--od19-secondary);"/>
                        +66 2 934 5417
                    </li>
                    <li>
                        <i class="fa fa-envelope fa-fw me-2" style="color:var(--od19-secondary);"/>
                        sales@auto-info.co.th
                    </li>
                </ul>
            </div>
        </xpath>

        <!-- Append our additional contact cards (Head Office, Engineering Center, Hours) -->
        <xpath expr="//div[@id='wrap']" position="inside">
            <section class="od19-section bg-light">
                <div class="container">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="od19-contact-card">
                                <h4><i class="fa fa-building me-2"/>Head Office</h4>
                                <p>1359 Soi Ladprao 94 (Panjamitr),<br/>
                                   Ladprao Rd., Plubpla,<br/>
                                   Wangthonglang, Bangkok 10310</p>
                                <p><i class="fa fa-phone"/> +66 2 934 5410-6</p>
                                <p><i class="fa fa-fax"/> +66 2 934 5417</p>
                                <p><i class="fa fa-envelope"/> sales@auto-info.co.th</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="od19-contact-card">
                                <h4><i class="fa fa-cogs me-2"/>Engineering Center</h4>
                                <p>ZENTRO Port Lumlukka K8<br/>
                                   36/8 Moo 13 Buengkhamphroi,<br/>
                                   Lam Luk Ka, Pathumthani 12150</p>
                                <p><i class="fa fa-phone"/> +66 2 934 5410-6</p>
                                <p><i class="fa fa-envelope"/> sales@auto-info.co.th</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="od19-contact-card">
                                <h4><i class="fa fa-clock-o me-2"/>Business Hours</h4>
                                <p><strong>Monday &#8211; Friday</strong><br/>08:30 &#8211; 17:30</p>
                                <p><strong>Saturday</strong><br/>08:30 &#8211; 12:00</p>
                                <p><strong>Sunday &amp; Public Holiday</strong><br/>Closed</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>

        <!-- Department contact channels -->
        <xpath expr="//div[@id='wrap']" position="inside">
            <section class="od19-section">
                <div class="container">
                    <div class="od19-section-title">
                        <h2>Talk to the Right Team</h2>
                        <div class="od19-divider"/>
                        <p class="od19-careers-lead">
                            Reach the department that matches your enquiry — every message is routed
                            to a specialist who can help.
                        </p>
                    </div>
                    <div class="od19-cap-grid">
                        <div class="od19-cap-card od19-pc-reveal">
                            <div class="od19-cap-icon"><i class="fa fa-line-chart"/></div>
                            <h4>Sales &amp; Quotation</h4>
                            <p>Product enquiries, integrated solutions and project quotations.</p>
                            <p class="od19-channel-line"><i class="fa fa-envelope"/> <a href="mailto:sales@auto-info.co.th">sales@auto-info.co.th</a></p>
                            <p class="od19-channel-line"><i class="fa fa-phone"/> +66 2 934 5410-6</p>
                        </div>
                        <div class="od19-cap-card od19-pc-reveal">
                            <div class="od19-cap-icon"><i class="fa fa-wrench"/></div>
                            <h4>Service &amp; Maintenance</h4>
                            <p>Preventive maintenance, calibration and long-term service contracts.</p>
                            <p class="od19-channel-line"><i class="fa fa-envelope"/> <a href="mailto:service@auto-info.co.th">service@auto-info.co.th</a></p>
                            <p class="od19-channel-line"><i class="fa fa-clock-o"/> On-call support</p>
                        </div>
                        <div class="od19-cap-card od19-pc-reveal">
                            <div class="od19-cap-icon"><i class="fa fa-cubes"/></div>
                            <h4>Spare Parts</h4>
                            <p>Genuine spare parts, replacements and upgrade components.</p>
                            <p class="od19-channel-line"><i class="fa fa-envelope"/> <a href="mailto:spare@auto-info.co.th">spare@auto-info.co.th</a></p>
                            <p class="od19-channel-line"><i class="fa fa-phone"/> +66 2 934 5410-6</p>
                        </div>
                        <div class="od19-cap-card od19-pc-reveal">
                            <div class="od19-cap-icon"><i class="fa fa-briefcase"/></div>
                            <h4>Careers</h4>
                            <p>Join our engineering, service and project delivery teams.</p>
                            <p class="mt-3">
                                <a href="/careers" class="btn btn-hero">View Openings <i class="fa fa-arrow-right"/></a>
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>

        <!-- Find us: map and directions -->
        <xpath expr="//div[@id='wrap']" position="inside">
            <section class="od19-section bg-light">
                <div class="container">
                    <div class="od19-section-title">
                        <h2>Find Us</h2>
                        <div class="od19-divider"/>
                    </div>
                    <div class="row g-4 align-items-stretch">
                        <div class="col-lg-7">
                            <div class="od19-img-frame od19-map-frame">
                                <iframe title="Auto-Info Head Office location" loading="lazy"
                                        referrerpolicy="no-referrer-when-downgrade"
                                        src="https://www.google.com/maps?q=1359%20Soi%20Ladprao%2094%20Wangthonglang%20Bangkok&amp;output=embed"/>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="od19-contact-card h-100">
                                <h4><i class="fa fa-map-marker me-2"/>Getting Here</h4>
                                <p><strong>Head Office</strong><br/>
                                   1359 Soi Ladprao 94 (Panjamitr), Ladprao Rd.,<br/>
                                   Plubpla, Wangthonglang, Bangkok 10310</p>
                                <p><i class="fa fa-car"/> Ample on-site parking</p>
                                <p><i class="fa fa-subway"/> MRT Lat Phrao (Exit 4), about 10 minutes on foot</p>
                                <p><i class="fa fa-clock-o"/> Mon&#8211;Fri 08:30&#8211;17:30 &#183; Sat 08:30&#8211;12:00</p>
                                <a class="btn btn-hero mt-2" target="_blank" rel="noopener"
                                   href="https://www.google.com/maps/dir/?api=1&amp;destination=1359+Soi+Ladprao+94+Bangkok">
                                    Get Directions <i class="fa fa-arrow-right"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>

    </template>

</odoo>
