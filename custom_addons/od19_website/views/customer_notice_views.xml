<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Customer Notice - list                                        -->
    <!-- ============================================================ -->
    <record id="view_od19_customer_notice_list" model="ir.ui.view">
        <field name="name">od19.customer.notice.list</field>
        <field name="model">od19.customer.notice</field>
        <field name="arch" type="xml">
            <list string="Customer Notices" decoration-muted="not active">
                <field name="name"/>
                <field name="notice_type"/>
                <field name="published"/>
                <field name="published_date"/>
                <field name="expiry_date"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Customer Notice - form                                        -->
    <!-- ============================================================ -->
    <record id="view_od19_customer_notice_form" model="ir.ui.view">
        <field name="name">od19.customer.notice.form</field>
        <field name="model">od19.customer.notice</field>
        <field name="arch" type="xml">
            <form string="Customer Notice">
                <header>
                    <button name="action_publish" type="object" string="Publish"
                            class="btn-primary" invisible="published"/>
                    <button name="action_unpublish" type="object" string="Unpublish"
                            invisible="not published"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Title"/>
                        <h1><field name="name" placeholder="e.g. Scheduled maintenance notice"/></h1>
                    </div>
                    <group>
                        <group name="left" string="Notice">
                            <field name="notice_type"/>
                            <field name="website_url" placeholder="https://..."/>
                        </group>
                        <group name="right" string="Publication">
                            <field name="published" widget="boolean_toggle"/>
                            <field name="published_date" readonly="1"/>
                            <field name="expiry_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="body" widget="html"
                                   placeholder="Message shown to customers in the portal."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Customer Notice - search                                      -->
    <!-- ============================================================ -->
    <record id="view_od19_customer_notice_search" model="ir.ui.view">
        <field name="name">od19.customer.notice.search</field>
        <field name="model">od19.customer.notice</field>
        <field name="arch" type="xml">
            <search string="Customer Notices">
                <field name="name"/>
                <field name="body"/>
                <filter name="filter_published" string="Published"
                        domain="[('published', '=', True)]"/>
                <filter name="filter_important" string="Important"
                        domain="[('notice_type', '=', 'mandatory')]"/>
                <separator/>
                <filter name="filter_active" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Type" domain="[]"
                            context="{'group_by': 'notice_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Customer Notice - action & menu                               -->
    <!-- ============================================================ -->
    <record id="action_od19_customer_notice" model="ir.actions.act_window">
        <field name="name">Customer Notices</field>
        <field name="res_model">od19.customer.notice</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_od19_customer_notice_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Publish your first customer notice</p>
            <p>Notices created here appear to signed-in customers on their portal home page.</p>
        </field>
    </record>

    <!--
        Nested inside the standard "Website" app (same approach as the
        recruitment menus) so we don't declare an extra top-level app.
    -->
    <menuitem id="menu_od19_customer_notice_root" name="Customer Portal"
              parent="website.menu_website_configuration"
              sequence="85" groups="base.group_user"/>
    <menuitem id="menu_od19_customer_notice" name="Customer Notices"
              parent="menu_od19_customer_notice_root"
              action="action_od19_customer_notice" sequence="10"/>

</odoo>
