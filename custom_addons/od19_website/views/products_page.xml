<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Product Catalog — single card renderer                         -->
    <!-- ============================================================ -->
    <template id="od19_pc_card" name="Product Catalog Card">
        <t t-set="labels" t-value="{'industrial': 'Industrial', 'building': 'Building', 'terminal': 'Terminal'}"/>
        <t t-set="img_url" t-value="'/od19_website/static/src/img/products/' + p['img']"/>
        <article class="od19-pc-card od19-pc-reveal" t-att-data-dept="p['dept']">
            <div class="od19-pc-media">
                <img t-att-src="img_url" t-att-alt="p['name']" loading="lazy"/>
                <span class="od19-pc-chip" t-esc="labels.get(p['dept'])"/>
            </div>
            <div class="od19-pc-body">
                <span class="od19-pc-brand" t-esc="p['brand']"/>
                <h3 class="od19-pc-name" t-esc="p['name']"/>
                <p class="od19-pc-desc" t-esc="p['desc']"/>
                <ul class="od19-pc-specs">
                    <li t-foreach="p['specs']" t-as="spec">
                        <i class="fa fa-check"/> <t t-esc="spec"/>
                    </li>
                </ul>
                <a href="/contactus" class="od19-pc-cta">
                    Request Info <i class="fa fa-arrow-right"/>
                </a>
            </div>
        </article>
    </template>

    <!-- ============================================================ -->
    <!-- Products Page                                                  -->
    <!-- ============================================================ -->
    <template id="od19_products_page" name="Products Page">
        <t t-call="website.layout">
            <div id="wrap" class="od19-pc oe_structure">

                <!-- SP4: catalog is served from website.od19_products() so the
                     grid, the filter counts and the service-page cross-links
                     all read from one source of truth. -->
                <t t-set="products" t-value="website.od19_products()"/>
                <t t-set="count_all" t-value="len(products)"/>
                <t t-set="count_industrial" t-value="len([p for p in products if p['dept'] == 'industrial'])"/>
                <t t-set="count_building" t-value="len([p for p in products if p['dept'] == 'building'])"/>
                <t t-set="count_terminal" t-value="len([p for p in products if p['dept'] == 'terminal'])"/>
                <t t-set="brand_count" t-value="len(set(p['brand'] for p in products))"/>

                <!-- Hero -->
                <section class="od19-pc-hero">
                    <div class="container od19-pc-hero-inner">
                        <nav class="od19-breadcrumb">
                            <a href="/">Home</a>
                            <i class="fa fa-angle-right"/>
                            <span>Products</span>
                        </nav>
                        <span class="od19-pc-eyebrow">Product Catalog</span>
                        <h1>Technology that makes work <span class="od19-pc-hl">effortless</span></h1>
                        <p class="od19-pc-sub">
                            Explore best-in-class automation products across the Industrial,
                            Building and Terminal domains — selected and supported by Auto-Info.
                        </p>
                        <div class="od19-pc-hero-stats">
                            <div class="od19-pc-stat"><strong t-esc="'%d+' % count_all"/><span>Products</span></div>
                            <div class="od19-pc-stat"><strong>3</strong><span>Domains</span></div>
                            <div class="od19-pc-stat"><strong t-esc="brand_count"/><span>Product Brands</span></div>
                        </div>
                        <a href="#od19-pc-catalog" class="od19-pc-hero-btn">
                            Browse Catalog <i class="fa fa-arrow-down"/>
                        </a>
                    </div>
                </section>

                <!-- Filter bar -->
                <div class="od19-pc-filter" id="od19-pc-catalog">
                    <div class="container od19-pc-filter-inner">
                        <button type="button" class="od19-pc-pill active" data-filter="all">
                            <i class="fa fa-th-large"/> All Products
                            <span class="od19-pc-count" t-esc="count_all"/>
                        </button>
                        <button type="button" class="od19-pc-pill" data-filter="industrial">
                            <i class="fa fa-industry"/> Industrial
                            <span class="od19-pc-count" t-esc="count_industrial"/>
                        </button>
                        <button type="button" class="od19-pc-pill" data-filter="building">
                            <i class="fa fa-building"/> Building
                            <span class="od19-pc-count" t-esc="count_building"/>
                        </button>
                        <button type="button" class="od19-pc-pill" data-filter="terminal">
                            <i class="fa fa-tint"/> Terminal
                            <span class="od19-pc-count" t-esc="count_terminal"/>
                        </button>
                    </div>
                </div>

                <!-- Industrial -->
                <section class="od19-pc-dept" data-dept="industrial">
                    <div class="container">
                        <div class="od19-pc-dept-head od19-pc-reveal">
                            <div class="od19-pc-dept-index">01</div>
                            <div>
                                <h2>Industrial Automation</h2>
                                <p>Controllers, drives, sensors and SCADA that keep production lines running without interruption.</p>
                                <a href="/industrial-automation" class="od19-pc-dept-link">
                                    Explore Industrial Automation services <i class="fa fa-arrow-right"/>
                                </a>
                            </div>
                        </div>
                        <div class="od19-pc-grid">
                            <t t-foreach="products" t-as="product">
                                <t t-if="product['dept'] == 'industrial'">
                                    <t t-call="od19_website.od19_pc_card">
                                        <t t-set="p" t-value="product"/>
                                    </t>
                                </t>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- Building -->
                <section class="od19-pc-dept od19-pc-alt" data-dept="building">
                    <div class="container">
                        <div class="od19-pc-dept-head od19-pc-reveal">
                            <div class="od19-pc-dept-index">02</div>
                            <div>
                                <h2>Building Automation</h2>
                                <p>GMP-ready building systems that protect comfort, compliance and energy performance.</p>
                                <a href="/building-automation" class="od19-pc-dept-link">
                                    Explore Building Automation services <i class="fa fa-arrow-right"/>
                                </a>
                            </div>
                        </div>
                        <div class="od19-pc-grid">
                            <t t-foreach="products" t-as="product">
                                <t t-if="product['dept'] == 'building'">
                                    <t t-call="od19_website.od19_pc_card">
                                        <t t-set="p" t-value="product"/>
                                    </t>
                                </t>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- Terminal -->
                <section class="od19-pc-dept" data-dept="terminal">
                    <div class="container">
                        <div class="od19-pc-dept-head od19-pc-reveal">
                            <div class="od19-pc-dept-index">03</div>
                            <div>
                                <h2>Terminal Automation</h2>
                                <p>Best-in-class tank gauging and loading technology for safe, efficient terminals.</p>
                                <a href="/terminal-automation" class="od19-pc-dept-link">
                                    Explore Terminal Automation services <i class="fa fa-arrow-right"/>
                                </a>
                            </div>
                        </div>
                        <div class="od19-pc-grid">
                            <t t-foreach="products" t-as="product">
                                <t t-if="product['dept'] == 'terminal'">
                                    <t t-call="od19_website.od19_pc_card">
                                        <t t-set="p" t-value="product"/>
                                    </t>
                                </t>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- CTA -->
                <section class="od19-pc-cta-section">
                    <div class="container">
                        <div class="od19-pc-cta-box">
                            <div>
                                <h2>Cannot find what you are looking for?</h2>
                                <p>Our engineers will help you specify the right product for your project.</p>
                            </div>
                            <a href="/contactus" class="btn btn-primary btn-lg">
                                <i class="fa fa-envelope me-2"/>Talk to an Expert
                            </a>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

</odoo>
