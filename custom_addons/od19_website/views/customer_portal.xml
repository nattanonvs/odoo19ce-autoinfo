<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Customer Portal: notices on the standard /my home page         -->
    <!-- ============================================================ -->
    <template id="od19_portal_customer_notices" name="Auto-Info Portal Customer Notices"
              inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="od19_customer_notices"
               t-value="request.env['od19.customer.notice'].od19_published_notices(5)"/>
            <div class="od19-cn-wrap" t-if="od19_customer_notices">
                <h5 class="od19-cn-title">
                    <i class="fa fa-bullhorn me-2" aria-hidden="true"/>
                    <span>ประกาศสำหรับลูกค้า</span>
                    <span class="od19-cn-title-en">Customer Notices</span>
                </h5>
                <div class="row g-3">
                    <t t-foreach="od19_customer_notices" t-as="notice">
                        <div class="col-md-6">
                            <div t-attf-class="od19-cn-card od19-cn-#{notice.notice_type}">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <strong class="od19-cn-name" t-esc="notice.name"/>
                                    <span t-attf-class="od19-announcement-badge od19-cn-badge-#{notice.notice_type}"
                                          t-esc="dict(info='Info', warning='Warning', mandatory='Important').get(notice.notice_type, notice.notice_type)"/>
                                </div>
                                <small class="text-muted d-block mt-1"
                                       t-esc="notice.published_date and notice.published_date.strftime('%d %b %Y') or ''"/>
                                <div class="od19-cn-body mt-2" t-out="notice.body"/>
                                <t t-if="notice.website_url">
                                    <a class="od19-cn-link" t-att-href="notice.website_url"
                                       t-att-title="notice.name">รายละเอียดเพิ่มเติม →</a>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
