<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Homepage template                                             -->
    <!-- ============================================================ -->
    <template id="od19_homepage" name="Auto-Info Homepage">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">

                <!-- Hero -->
                <section class="od19-hero">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-8">
                                <h1 t-esc="website.company_id.od19_website_hero_title or 'Automation Solutions for a Smarter Future'"/>
                                <p class="lead" t-esc="website.company_id.od19_website_hero_subtitle or 'Industrial · Building · Terminal Automation'"/>
                                <a href="/contactus" class="btn btn-hero">
                                    <i class="fa fa-envelope me-2"/>Contact Us
                                </a>
                                <a href="/about-us" class="btn btn-outline-light ms-2" style="border-color:#fff;color:#fff;">
                                    Learn More
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Services -->
                <section class="od19-section bg-light">
                    <div class="container">
                        <div class="od19-section-title">
                            <h2>Service &amp; Solutions</h2>
                            <div class="od19-divider"/>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <a href="/industrial-automation" class="text-decoration-none">
                                    <div class="od19-service-card">
                                        <div class="od19-icon"><i class="fa fa-industry"/></div>
                                        <h3>Industrial Automation</h3>
                                        <p>System Migrations, SCADA Centralized Information,
                                           Preventive Maintenance and Service Contract.</p>
                                    </div>
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="/building-automation" class="text-decoration-none">
                                    <div class="od19-service-card">
                                        <div class="od19-icon"><i class="fa fa-building"/></div>
                                        <h3>Building Automation</h3>
                                        <p>Market leader in Thailand's life science business for
                                           Building Automation Systems with GMP &amp; CSV compliance.</p>
                                    </div>
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="/terminal-automation" class="text-decoration-none">
                                    <div class="od19-service-card">
                                        <div class="od19-icon"><i class="fa fa-tint"/></div>
                                        <h3>Terminal Automation</h3>
                                        <p>Best-in-Class products for Tank gauging, Loading system
                                           and integrated terminal system.</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Product Highlights -->
                <section class="od19-section od19-pf">
                    <div class="container">
                        <div class="od19-section-title">
                            <h2>Featured Products</h2>
                            <div class="od19-divider"/>
                            <p class="od19-pf-sub">Equipment our engineers rely on every day — across
                               Industrial, Building and Terminal automation.</p>
                        </div>
                        <t t-set="featured" t-value="[
                            {'dept': 'Industrial', 'brand': 'Schneider Electric', 'name': 'Modicon M580',
                             'img': 'modern industrial PLC automation controller cabinet in a clean high-tech factory, professional product photography, cinematic lighting'},
                            {'dept': 'Building', 'brand': 'Siemens', 'name': 'Desigo CC',
                             'img': 'modern smart building management control room with large monitoring displays, professional photography, cinematic lighting'},
                            {'dept': 'Terminal', 'brand': 'Emerson', 'name': 'Fusion 4 MSC-L',
                             'img': 'fuel terminal loading control skid at an oil storage tank farm, industrial photography, cinematic lighting'},
                            {'dept': 'Terminal', 'brand': 'Honeywell Enraf', 'name': 'Servo Gauge 854 ATG',
                             'img': 'servo tank gauging level instrument mounted on a large oil storage tank, industrial photography, cinematic lighting'}
                        ]"/>
                        <div class="od19-pf-grid">
                            <t t-foreach="featured" t-as="f">
                                <a href="/products" class="od19-pf-card od19-pc-reveal">
                                    <div class="od19-pf-media">
                                        <img t-att-src="'https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=' + f['img'].replace(' ', '%20') + '&amp;image_size=landscape_4_3'"
                                             t-att-alt="f['name']" loading="lazy"/>
                                        <span class="od19-pc-chip" t-esc="f['dept']"/>
                                    </div>
                                    <div class="od19-pf-body">
                                        <span class="od19-pc-brand" t-esc="f['brand']"/>
                                        <h3 class="od19-pc-name" t-esc="f['name']"/>
                                        <span class="od19-pc-cta">More Detail <i class="fa fa-arrow-right"/></span>
                                    </div>
                                </a>
                            </t>
                        </div>
                        <div class="od19-pf-more">
                            <a href="/products" class="btn btn-hero">Explore Full Catalog <i class="fa fa-arrow-right"/></a>
                        </div>
                    </div>
                </section>

                <!-- Stats -->
                <section class="od19-stats">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-3 col-6">
                                <div class="od19-stat-number">20+</div>
                                <div class="od19-stat-label">Years Experience</div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="od19-stat-number">3</div>
                                <div class="od19-stat-label">Automation Domains</div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="od19-stat-number">100%</div>
                                <div class="od19-stat-label">GMP &amp; CSV Ready</div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="od19-stat-number">1M+</div>
                                <div class="od19-stat-label">Website Visitors</div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- News & Events -->
                <section class="od19-section bg-light">
                    <div class="container">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="mb-0" style="color:var(--od19-dark);font-weight:700;">
                                        <i class="fa fa-newspaper-o me-2" style="color:var(--od19-primary);"/>News Update
                                    </h3>
                                    <a href="/blog" class="btn btn-sm btn-outline-primary">View More</a>
                                </div>
                                <t t-foreach="website.env['blog.post'].sudo().search([('is_published','=',True)], limit=3, order='published_date desc')" t-as="post">
                                    <div class="card mb-3 border-0 shadow-sm">
                                        <div class="card-body">
                                            <h6 class="card-title mb-1">
                                                <a t-att-href="'/blog/%s/post/%s' % (post.blog_id.id, post.id)" class="text-decoration-none" style="color:var(--od19-dark);">
                                                    <t t-esc="post.name"/>
                                                </a>
                                            </h6>
                                            <small class="text-muted" t-esc="post.published_date and post.published_date.strftime('%d %B %Y') or ''"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="mb-0" style="color:var(--od19-dark);font-weight:700;">
                                        <i class="fa fa-calendar me-2" style="color:var(--od19-secondary);"/>Events Update
                                    </h3>
                                    <a href="/blog" class="btn btn-sm btn-outline-primary">View More</a>
                                </div>
                                <div class="card mb-3 border-0 shadow-sm">
                                    <div class="card-body">
                                        <h6 class="card-title mb-1">AUTO TOGETHER 2025</h6>
                                        <small class="text-muted">12 September 2026</small>
                                    </div>
                                </div>
                                <div class="card mb-3 border-0 shadow-sm">
                                    <div class="card-body">
                                        <h6 class="card-title mb-1">Auto Virtual Run 2026</h6>
                                        <small class="text-muted">Coming Soon</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CTA -->
                <section class="od19-section" style="background:var(--od19-primary);color:#fff;">
                    <div class="container text-center">
                        <h2 style="color:#fff;font-weight:700;">Ready to Automate Your Business?</h2>
                        <p class="lead mb-4" style="opacity:0.9;">Let our experts help you design the right solution.</p>
                        <a href="/contactus" class="btn btn-hero">Get In Touch</a>
                    </div>
                </section>

            </div>
        </t>
    </template>

</odoo>
