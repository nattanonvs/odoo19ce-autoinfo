<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Footer override: Auto-Info branded footer                    -->
    <!-- ============================================================ -->
    <template id="od19_footer" name="Auto-Info Footer" inherit_id="website.layout" priority="20">
        <xpath expr="//div[@id='footer']" position="replace">
            <footer class="od19-footer" t-if="not no_footer">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-4 col-md-6 mb-4">
                            <h5>The Auto-Info Co., Ltd.</h5>
                            <p style="font-size:0.9rem;">
                                Total Integrated Automation Solutions in Industrial,
                                Building and Terminal Automation.
                            </p>
                            <div>
                                <a t-att-href="website.company_id.od19_website_facebook_url or '#'" class="me-2" aria-label="Facebook">
                                    <i class="fa fa-facebook-square fa-lg"/>
                                </a>
                                <a t-att-href="website.company_id.od19_website_linkedin_url or '#'" class="me-2" aria-label="LinkedIn">
                                    <i class="fa fa-linkedin-square fa-lg"/>
                                </a>
                                <a t-att-href="website.company_id.od19_website_youtube_url or '#'" aria-label="YouTube">
                                    <i class="fa fa-youtube-play fa-lg"/>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-6 mb-4">
                            <h5>Services</h5>
                            <ul class="list-unstyled">
                                <li><a href="/industrial-automation">Industrial Automation</a></li>
                                <li><a href="/building-automation">Building Automation</a></li>
                                <li><a href="/terminal-automation">Terminal Automation</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-2 col-md-6 mb-4">
                            <h5>Company</h5>
                            <ul class="list-unstyled">
                                <li><a href="/about-us">About Us</a></li>
                                <li><a href="/products">Products</a></li>
                                <li><a href="/careers">Careers</a></li>
                                <li><a href="/blog">News &amp; Events</a></li>
                                <li><a href="/contactus">Contact</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-4 col-md-6 mb-4">
                            <h5>Head Office</h5>
                            <p>
                                1359 Soi Ladprao 94 (Panjamitr),<br/>
                                Ladprao Rd., Plubpla, Wangthonglang,<br/>
                                Bangkok 10310 Thailand
                            </p>
                            <p>
                                <i class="fa fa-phone"/> +66 2 934 5410-6<br/>
                                <i class="fa fa-fax"/> +66 2 934 5417<br/>
                                <i class="fa fa-envelope"/> sales@auto-info.co.th<br/>
                                <i class="fa fa-clock-o"/> Mon&#8211;Fri 08:00&#8211;17:00
                            </p>
                        </div>
                    </div>
                    <div class="od19-footer-bottom">
                        © <span t-esc="datetime.datetime.now().year"/> The Auto-Info Co., Ltd. All Rights Reserved.
                    </div>
                </div>
            </footer>
        </xpath>
        <!-- Remove the default Odoo copyright bar (we have our own) -->
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="replace"/>
    </template>

    <!-- ============================================================ -->
    <!-- Header phone/email: replace Odoo hardcoded fake data          -->
    <!-- ============================================================ -->
    <template id="od19_header_text_element" name="Auto-Info Header Text Element"
              inherit_id="website.header_text_element" priority="20">
        <xpath expr="//li" position="replace">
            <li t-attf-class="#{_item_class}">
                <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                    <a href="tel:+6629345410" class="nav-link o_nav-link_secondary p-2">
                        <i class="fa fa-1x fa-fw fa-phone me-1"/>
                        <span class="o_force_ltr"><small>+66 2 934 5410</small></span>
                    </a>
                </div>
            </li>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Search bar: friendlier placeholder + branded pill styling     -->
    <!-- ============================================================ -->
    <template id="od19_search_box" name="Auto-Info Search Box"
              inherit_id="website.website_search_box" priority="20">
        <xpath expr="//div[@role='search']" position="attributes">
            <attribute name="t-attf-class" add="od19-search" separator=" "/>
        </xpath>
        <xpath expr="//t[@t-set='search_placeholder']" position="replace">
            <t t-set="search_placeholder">Search products, services, pages&#8230;</t>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Header search: inline, prominent search bar (no icon + modal)  -->
    <!-- ============================================================ -->
    <template id="od19_header_search_inline" name="Auto-Info Inline Header Search"
              inherit_id="website.template_header_default" priority="30">
        <xpath expr="//t[@t-call='website.placeholder_header_search_box']" position="attributes">
            <attribute name="_layout.f">inline</attribute>
            <attribute name="_item_class.f" add="od19-nav-search" separator=" "/>
            <attribute name="_input_classes.f">od19-nav-search-input</attribute>
            <attribute name="_submit_classes.f">od19-nav-search-btn</attribute>
            <attribute name="default_style.f">True</attribute>
            <attribute name="limit.f">8</attribute>
            <attribute name="placeholder.f">Search products, services, pages&#8230;</attribute>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Search results page: branded header + styled results          -->
    <!-- ============================================================ -->
    <template id="od19_search_results" name="Auto-Info Search Results"
              inherit_id="website.list_hybrid" priority="20">
        <xpath expr="//t[@t-call='website.website_search_box_input']" position="replace">
            <div class="od19-search-band">
                <h1 class="h3-fs">Search our website</h1>
                <p class="od19-search-band-sub">
                    Find products, services, pages and news across Auto-Info.
                </p>
                <t t-call="website.website_search_box_input"
                   _classes.f=""
                   search_type.f="all"
                   action.f="/website/search"
                   search.f="search"
                   placeholder.f="Search products, services, pages&#8230;"/>
            </div>
        </xpath>
        <xpath expr="//h1[hasclass('h3-fs')]" position="replace">
            <h2 class="od19-jobs-title mb-4" t-if="results">
                <span class="od19-search-count" t-esc="len(results)"/> result(s)
                <t t-if="search">for &#8220;<t t-esc="search"/>&#8221;</t>
            </h2>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Add favicon / brand meta from company                         -->
    <!-- ============================================================ -->
    <template id="od19_layout_assets" name="Auto-Info Layout Assets" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <link rel="icon" type="image/svg+xml" href="/od19_website/static/src/img/favicon.svg"/>
            <link rel="alternate icon" type="image/jpeg" href="/od19_website/static/src/img/autoinfo_logo.jpg"/>
            <meta name="theme-color" content="#9E2424"/>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Language switch (EN | ไทย): compact, one-click, always shown  -->
    <!-- Both languages stay visible so visitors switch in one click.  -->
    <!-- ============================================================ -->
    <template id="od19_language_switch" name="Auto-Info Language Switch"
              inherit_id="website.header_language_selector" priority="20">
        <xpath expr="//t[@id='header_language_selector_call']" position="replace">
            <div class="od19-lang-switch" t-if="len(frontend_languages) &gt; 1">
                <t t-foreach="frontend_languages.values()" t-as="lg">
                    <span t-if="not lg_first" class="od19-lang-sep">|</span>
                    <a t-attf-class="od19-lang-opt js_change_lang #{'active' if lg.code == lang else ''}"
                       t-att-href="url_localized(lang_code=lg.code, prefetch_langs=True, force_default_lang=True)"
                       t-att-data-url_code="lg.url_code"
                       t-att-title="lg.name.split('/').pop().split('(')[0].strip()">
                        <t t-esc="lg.name.split('/').pop().split('(')[0].strip()"/>
                    </a>
                </t>
            </div>
        </xpath>
    </template>

</odoo>
