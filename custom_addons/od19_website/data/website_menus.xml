<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================ -->
    <!-- Website Menu (Top Navigation)                                 -->
    <!-- Menus are created under website.main_menu and re-parented to  -->
    <!-- the website's actual top menu by post_init_hook.  noupdate=1 -->
    <!-- ensures the re-parenting persists across module upgrades.    -->
    <!-- ============================================================ -->

    <record id="menu_home" model="website.menu">
        <field name="name">Home</field>
        <field name="url">/</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="10"/>
    </record>

    <record id="menu_services" model="website.menu">
        <field name="name">Services</field>
        <field name="url">#</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="20"/>
    </record>

    <record id="menu_services_industrial" model="website.menu">
        <field name="name">Industrial Automation</field>
        <field name="url">/industrial-automation</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="menu_services"/>
        <field name="sequence" eval="10"/>
    </record>

    <record id="menu_services_building" model="website.menu">
        <field name="name">Building Automation</field>
        <field name="url">/building-automation</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="menu_services"/>
        <field name="sequence" eval="20"/>
    </record>

    <record id="menu_services_terminal" model="website.menu">
        <field name="name">Terminal Automation</field>
        <field name="url">/terminal-automation</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="menu_services"/>
        <field name="sequence" eval="30"/>
    </record>

    <record id="menu_products" model="website.menu">
        <field name="name">Products</field>
        <field name="url">/products</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="30"/>
    </record>

    <record id="menu_about" model="website.menu">
        <field name="name">About</field>
        <field name="url">/about-us</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="40"/>
    </record>

    <record id="menu_news" model="website.menu">
        <field name="name">News &amp; Events</field>
        <field name="url">/blog</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="50"/>
    </record>

    <record id="menu_contact" model="website.menu">
        <field name="name">Contact</field>
        <field name="url">/contactus</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="60"/>
    </record>

    <record id="menu_employee_portal" model="website.menu">
        <field name="name">Employee Portal</field>
        <field name="url">/employee-portal</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="70"/>
    </record>

</odoo>
