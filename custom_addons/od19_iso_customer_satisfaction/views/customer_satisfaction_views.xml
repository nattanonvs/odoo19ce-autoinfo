<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== CSAT Survey Views ===================== -->
    <record id="view_iso_csat_tree" model="ir.ui.view">
        <field name="name">od19.iso.customer.satisfaction.tree</field>
        <field name="model">od19.iso.customer.satisfaction</field>
        <field name="arch" type="xml">
            <tree string="ความพึงพอใจลูกค้า" decoration-success="overall_score >= 4" decoration-warning="overall_score >= 3 and overall_score &lt; 4" decoration-danger="overall_score &lt; 3">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="period"/>
                <field name="method"/>
                <field name="overall_score"/>
                <field name="overall_csat"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_iso_csat_form" model="ir.ui.view">
        <field name="name">od19.iso.customer.satisfaction.form</field>
        <field name="model">od19.iso.customer.satisfaction</field>
        <field name="arch" type="xml">
            <form string="ความพึงพอใจลูกค้า">
                <header>
                    <button name="action_sent" type="object" string="ส่งแบบสอบถาม" invisible="status != 'draft'"/>
                    <button name="action_complete" type="object" string="ตอบกลับแล้ว" invisible="status not in ('draft','sent')"/>
                    <button name="action_close" type="object" string="ปิด" class="btn-primary" invisible="status not in ('sent','completed')"/>
                    <button name="action_cancel" type="object" string="ยกเลิก" invisible="status in ('completed','cancelled')"/>
                    <button name="action_reset_to_draft" type="object" string="กลับเป็นร่าง" invisible="status not in ('cancelled','sent')"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="contact_person"/>
                            <field name="date"/>
                            <field name="period"/>
                            <field name="method"/>
                        </group>
                        <group>
                            <field name="overall_score" readonly="1"/>
                            <field name="overall_csat"/>
                            <field name="would_recommend"/>
                            <field name="responsible_id"/>
                            <field name="close_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="รายการประเมิน">
                            <field name="item_ids">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="max_score"/>
                                    <field name="score"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ข้อเสนอแนะและการดำเนินการ">
                            <group>
                                <field name="positive_feedback" colspan="2"/>
                                <field name="improvement" colspan="2"/>
                                <field name="complaint" colspan="2"/>
                                <field name="action_taken" colspan="2"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iso_csat" model="ir.actions.act_window">
        <field name="name">ความพึงพอใจลูกค้า</field>
        <field name="res_model">od19.iso.customer.satisfaction</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">สร้างแบบสอบถามความพึงพอใจลูกค้า</p></field>
    </record>

    <!-- ===================== CSAT Period Report Views ===================== -->
    <record id="view_iso_csat_period_tree" model="ir.ui.view">
        <field name="name">od19.iso.csat.period.report.tree</field>
        <field name="model">od19.iso.csat.period.report</field>
        <field name="arch" type="xml">
            <tree string="รายงานความพึงพอใจรายงวด">
                <field name="name"/>
                <field name="period"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="survey_count"/>
                <field name="avg_score"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_iso_csat_period_form" model="ir.ui.view">
        <field name="name">od19.iso.csat.period.report.form</field>
        <field name="model">od19.iso.csat.period.report</field>
        <field name="arch" type="xml">
            <form string="รายงานความพึงพอใจรายงวด">
                <header>
                    <button name="action_done" type="object" string="เสร็จสิ้น" invisible="state != 'draft'" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="period"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="survey_count" readonly="1"/>
                            <field name="avg_score" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="แบบสอบถาม">
                            <field name="survey_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date"/>
                                    <field name="overall_score"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="สรุปผลและแผนการปรับปรุง">
                            <group>
                                <field name="summary" colspan="2"/>
                                <field name="action_plan" colspan="2"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iso_csat_period" model="ir.actions.act_window">
        <field name="name">รายงานความพึงพอใจรายงวด</field>
        <field name="res_model">od19.iso.csat.period.report</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
