<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_stock_count_session_list" model="ir.ui.view">
        <field name="name">od19.stock.count.session.list</field>
        <field name="model">od19.stock.count.session</field>
        <field name="arch" type="xml">
            <list string="Count Sessions">
                <field name="name"/>
                <field name="location_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'scheduled'"
                       decoration-warning="state in ('counted', 'pending_approval')"
                       decoration-success="state in ('adjusted', 'reviewed')"
                       decoration-danger="state == 'cancelled'"/>
                <field name="variance_count"/>
                <field name="approved_by"/>
            </list>
        </field>
    </record>

    <record id="view_od19_stock_count_session_form" model="ir.ui.view">
        <field name="name">od19.stock.count.session.form</field>
        <field name="model">od19.stock.count.session</field>
        <field name="arch" type="xml">
            <form string="Stock Count Session">
                <header>
                    <button name="action_mark_counted" string="Mark as Counted"
                            type="object" class="btn-primary"
                            invisible="state != 'scheduled'"/>
                    <button name="action_submit_for_approval" string="Submit for Approval"
                            type="object" class="btn-primary"
                            invisible="state != 'counted'"/>
                    <button name="action_create_adjustment" string="Approve &amp; Apply Adjustments"
                            type="object" class="btn-primary"
                            groups="stock.group_stock_manager"
                            invisible="state != 'pending_approval'"/>
                    <button name="action_mark_reviewed" string="Mark as Reviewed"
                            type="object"
                            invisible="state != 'adjusted'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('adjusted', 'reviewed', 'cancelled')"/>
                    <button name="action_reset_to_scheduled" string="Reset to Scheduled"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="scheduled,counted,pending_approval,adjusted,reviewed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="variance_count" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                        </group>
                    </group>
                    <group string="Count Lines">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="quant_id"/>
                                <field name="product_id" readonly="1"/>
                                <field name="system_qty" readonly="1"/>
                                <field name="counted_qty"/>
                                <field name="variance_qty" readonly="1"
                                       decoration-danger="variance_qty &lt; 0"
                                       decoration-success="variance_qty &gt; 0"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="od19_stock_count_session_action" model="ir.actions.act_window">
        <field name="name">Stock Count Sessions</field>
        <field name="res_model">od19.stock.count.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_od19_stock_count_session" name="Audit Counts"
              parent="stock.menu_stock_inventory_control"
              action="od19_stock_count_session_action" sequence="80"/>
</odoo>
