<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ============ res.partner (core) — เพิ่มฟิลด์โดเมน TA ============ -->
    <record id="od19_ta_view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.od19.ta</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_od19_ta_plants"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    invisible="od19_ta_plant_count == 0"
                >
                    <field
                        name="od19_ta_plant_count"
                        widget="statinfo"
                        string="Plants"
                    />
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="TA Asset Register" name="od19_ta">
                    <group>
                        <group>
                            <field name="od19_ta_is_company" />
                            <field
                                name="od19_ta_company_type"
                                invisible="not od19_ta_is_company"
                            />
                            <field
                                name="od19_ta_industry"
                                invisible="not od19_ta_is_company"
                            />
                            <field name="od19_ta_odoo_ref" />
                        </group>
                        <group>
                            <field name="od19_ta_contact_plant_id" />
                            <field name="od19_ta_merged_into_id" />
                            <field name="od19_ta_merged_at" />
                        </group>
                    </group>
                    <field name="od19_ta_plant_ids" invisible="not od19_ta_is_company">
                        <list>
                            <field name="code" />
                            <field name="name" />
                            <field name="province" />
                            <field name="tank_count" />
                            <field name="equipment_count" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============ Action: TA Companies ============ -->
    <record id="od19_ta_partner_action" model="ir.actions.act_window">
        <field name="name">TA Companies</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('od19_ta_is_company', '=', True)]</field>
        <field name="context">{'default_od19_ta_is_company': True, 'res_partner_search_mode': 'customer'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">เพิ่มบริษัทลูกค้าทะเบียน TA</p>
            <p>ใช้ <b>res.partner</b> มาตรฐานของ Odoo — เพิ่มเฉพาะฟิลด์โดเมน TA</p>
        </field>
    </record>
</odoo>
