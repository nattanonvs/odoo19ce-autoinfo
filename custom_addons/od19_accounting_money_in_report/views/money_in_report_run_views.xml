<odoo>
    <record id="view_od19_money_in_report_run_list" model="ir.ui.view">
        <field name="name">od19.money.in.report.run.list</field>
        <field name="model">od19.money.in.report.run</field>
        <field name="arch" type="xml">
            <list string="Money In Report Runs">
                <field name="name"/>
                <field name="company_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="phase"/>
                <field name="status"/>
                <field name="line_count" string="Lines"/>
                <field name="generated_by"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>

    <record id="view_od19_money_in_report_run_form" model="ir.ui.view">
        <field name="name">od19.money.in.report.run.form</field>
        <field name="model">od19.money.in.report.run</field>
        <field name="arch" type="xml">
            <form string="Money In Report Run">
                <header>
                    <button
                        name="action_open_lines"
                        type="object"
                        string="Open Analysis"
                        class="btn-primary"
                        invisible="status != 'done'"
                    />
                    <button
                        name="action_export_xlsx"
                        type="object"
                        string="Export XLSX"
                        class="btn-secondary"
                        invisible="status != 'done'"
                    />
                    <field name="status" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bar-chart"
                        >
                            <field name="line_count" string="Analysis Lines" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="phase" readonly="1"/>
                            <field name="notes"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="generated_by" readonly="1"/>
                            <field name="generated_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Filters">
                            <group>
                                <group>
                                    <field name="job_type_values"/>
                                    <field name="partner_ids" widget="many2many_tags"/>
                                    <field name="salesperson_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="project_ids" widget="many2many_tags"/>
                                    <field name="product_categ_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                        <page string="Lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="project_id"/>
                                    <field name="product_id"/>
                                    <field name="recognized_amount"/>
                                    <field name="recognized_profit"/>
                                    <field name="cycle_days"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <div class="alert alert-info" role="alert">
                        Profit metrics are preliminary in Phase 1 and cycle timing falls back to invoice date when stamp date is missing.
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_od19_money_in_report_runs" model="ir.actions.act_window">
        <field name="name">Money In Report Runs</field>
        <field name="res_model">od19.money.in.report.run</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_od19_money_in_report_run_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a report run from the wizard to capture a snapshot of invoice-based money-in data.
            </p>
        </field>
    </record>
</odoo>
