<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Goods Issue Type - list -->
    <record id="view_od19_goods_issue_type_list" model="ir.ui.view">
        <field name="name">od19.goods.issue.type.list</field>
        <field name="model">od19.goods.issue.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Goods Issue Type - form -->
    <record id="view_od19_goods_issue_type_form" model="ir.ui.view">
        <field name="name">od19.goods.issue.type.form</field>
        <field name="model">od19.goods.issue.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name" placeholder="เช่น เบิกวัสดุผลิต, เบิกของใช้สำนักงาน"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="รายละเอียดเพิ่มเติม"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Goods Issue Type - action -->
    <record id="action_od19_goods_issue_type" model="ir.actions.act_window">
        <field name="name">ประเภทการเบิก / Issue Types</field>
        <field name="res_model">od19.goods.issue.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
