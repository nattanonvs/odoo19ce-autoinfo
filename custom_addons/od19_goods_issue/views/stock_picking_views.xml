<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Show the Goods Issue department / reason on the picking form -->
    <record id="view_picking_form_od19_goods_issue" model="ir.ui.view">
        <field name="name">stock.picking.form.od19.goods.issue</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="od19_goods_issue_department_id"/>
                <field name="od19_goods_issue_reason"/>
            </xpath>
        </field>
    </record>

</odoo>
