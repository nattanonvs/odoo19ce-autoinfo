<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Multi-company rule for the Goods Issue Type model. -->
    <record id="od19_goods_issue_type_company_rule" model="ir.rule">
        <field name="name">Goods Issue Type multi-company</field>
        <field name="model_id" ref="model_od19_goods_issue_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
    </record>

</odoo>
