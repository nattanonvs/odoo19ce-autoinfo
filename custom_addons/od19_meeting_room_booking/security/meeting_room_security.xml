<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_meeting_room_booking" model="res.groups.privilege">
        <field name="name">Meeting Room Booking</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="sequence">84</field>
    </record>

    <record id="group_meeting_room_user" model="res.groups">
        <field name="name">Meeting Room User</field>
        <field name="comment">Create and follow meeting room bookings.</field>
        <field name="privilege_id" ref="res_groups_privilege_meeting_room_booking"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_meeting_room_manager" model="res.groups">
        <field name="name">Meeting Room Manager</field>
        <field name="comment">Maintain the room catalog and manage all bookings.</field>
        <field name="privilege_id" ref="res_groups_privilege_meeting_room_booking"/>
        <field name="implied_ids" eval="[Command.link(ref('group_meeting_room_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_meeting_room_manager'))]"/>
    </record>

    <record id="meeting_room_rule_company_room" model="ir.rule">
        <field name="name">Meeting room: multi-company</field>
        <field name="model_id" ref="model_od19_meeting_room"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_meeting_room_user'))]"/>
    </record>

    <record id="meeting_room_rule_company_booking" model="ir.rule">
        <field name="name">Meeting room booking: multi-company</field>
        <field name="model_id" ref="model_od19_meeting_room_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_meeting_room_user'))]"/>
    </record>
</odoo>
