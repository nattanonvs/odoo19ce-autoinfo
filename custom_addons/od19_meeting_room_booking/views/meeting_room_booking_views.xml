<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meeting_room_booking_calendar" model="ir.ui.view">
        <field name="name">od19.meeting.room.booking.calendar</field>
        <field name="model">od19.meeting.room.booking</field>
        <field name="arch" type="xml">
            <calendar string="Meeting Room Bookings"
                      date_start="start_datetime"
                      date_stop="end_datetime"
                      color="room_id"
                      mode="week">
                <field name="name"/>
                <field name="room_id"/>
                <field name="organizer_id"/>
                <field name="participant_count"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_meeting_room_booking_list" model="ir.ui.view">
        <field name="name">od19.meeting.room.booking.list</field>
        <field name="model">od19.meeting.room.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="room_id"/>
                <field name="organizer_id"/>
                <field name="participant_count"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-primary="state in ('approved', 'in_use')"
                       decoration-success="state == 'done'"
                       decoration-danger="state in ('rejected', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_meeting_room_booking_form" model="ir.ui.view">
        <field name="name">od19.meeting.room.booking.form</field>
        <field name="model">od19.meeting.room.booking</field>
        <field name="arch" type="xml">
            <form string="Meeting Room Booking">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" groups="od19_meeting_room_booking.group_meeting_room_manager"
                            invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject" type="object"
                            groups="od19_meeting_room_booking.group_meeting_room_manager"
                            invisible="state != 'submitted'"/>
                    <button name="action_start_meeting" string="Start Meeting" type="object"
                            invisible="state != 'approved'"/>
                    <button name="action_complete" string="Complete" type="object"
                            invisible="state not in ('approved', 'in_use')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'rejected', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,in_use,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Weekly operations review"/></h1>
                        <div class="text-muted"><field name="reference" readonly="1"/></div>
                    </div>
                    <group>
                        <group>
                            <field name="room_id"/>
                            <field name="organizer_id"/>
                            <field name="participant_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration_hours" readonly="1"/>
                            <field name="approved_by" readonly="1" invisible="not approved_by"/>
                            <field name="approved_on" readonly="1" invisible="not approved_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Meeting Brief">
                            <field name="purpose" placeholder="What is this meeting for?"/>
                            <field name="attendee_summary" placeholder="Teams, guests, or important attendees..."/>
                            <field name="equipment_request" placeholder="Projector, VC, whiteboard, refreshments, etc."/>
                        </page>
                        <page string="Approval Notes">
                            <field name="approval_note" placeholder="Internal approval notes or conditions..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_meeting_room_booking_search" model="ir.ui.view">
        <field name="name">od19.meeting.room.booking.search</field>
        <field name="model">od19.meeting.room.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="name"/>
                <field name="room_id"/>
                <field name="organizer_id"/>
                <field name="start_datetime"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="In Use" name="in_use" domain="[('state', '=', 'in_use')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Today" name="today"
                        domain="[('start_datetime', '&gt;=', context_today()), ('start_datetime', '&lt;', context_today() + relativedelta(days=1))]"/>
                <group name="group_by" domain="[]">
                    <filter string="Room" name="group_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Organizer" name="group_organizer" context="{'group_by': 'organizer_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_meeting_room_booking" model="ir.actions.act_window">
        <field name="name">Meeting Room Bookings</field>
        <field name="res_model">od19.meeting.room.booking</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="view_meeting_room_booking_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Plan, approve, and follow up meeting room bookings.
            </p>
        </field>
    </record>
</odoo>
