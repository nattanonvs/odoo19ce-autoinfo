<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Default view: calendar, so a user just picks a slot and saves. -->
    <record id="view_meeting_room_booking_calendar" model="ir.ui.view">
        <field name="name">od19.meeting.room.booking.calendar</field>
        <field name="model">od19.meeting.room.booking</field>
        <field name="arch" type="xml">
            <calendar string="Meeting Room Bookings"
                      date_start="start_datetime"
                      date_stop="end_datetime"
                      color="room_id"
                      mode="week"
                      quick_create="false">
                <field name="name"/>
                <field name="room_id"/>
                <field name="organizer_id"/>
                <field name="participant_count"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_meeting_room_booking_list" model="ir.ui.view">
        <field name="name">od19.meeting.room.booking.list</field>
        <field name="model">od19.meeting.room.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="name"/>
                <field name="room_id"/>
                <field name="organizer_id"/>
                <field name="participant_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'booked'"
                       decoration-warning="state == 'in_use'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_meeting_room_booking_form" model="ir.ui.view">
        <field name="name">od19.meeting.room.booking.form</field>
        <field name="model">od19.meeting.room.booking</field>
        <field name="arch" type="xml">
            <form string="Meeting Room Booking">
                <header>
                    <button name="action_start_meeting" string="Start Meeting" type="object"
                            class="btn-primary" invisible="state != 'booked'"/>
                    <button name="action_complete" string="Finish" type="object"
                            class="btn-primary" invisible="state != 'in_use'"/>
                    <button name="action_cancel" string="Cancel Booking" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state not in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="booked,in_use,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Weekly operations review"/></h1>
                        <div class="text-muted"><field name="reference" readonly="1"/></div>
                    </div>
                    <group>
                        <group>
                            <field name="room_id"/>
                            <field name="organizer_id"/>
                            <field name="participant_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="duration_hours" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Meeting Brief">
                            <field name="purpose" placeholder="What is this meeting for?"/>
                            <field name="attendee_summary" placeholder="Teams, guests, or important attendees..."/>
                            <field name="equipment_request" placeholder="Projector, VC, whiteboard, refreshments, etc."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_meeting_room_booking_search" model="ir.ui.view">
        <field name="name">od19.meeting.room.booking.search</field>
        <field name="model">od19.meeting.room.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="name"/>
                <field name="room_id"/>
                <field name="organizer_id"/>
                <field name="start_datetime"/>
                <filter string="Booked" name="booked" domain="[('state', '=', 'booked')]"/>
                <filter string="In Use" name="in_use" domain="[('state', '=', 'in_use')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('start_datetime', '&gt;=', context_today()), ('start_datetime', '&lt;', context_today() + relativedelta(days=1))]"/>
                <filter string="Upcoming" name="upcoming"
                        domain="[('start_datetime', '&gt;=', context_today())]"/>
                <group name="group_by">
                    <filter string="Room" name="group_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Organizer" name="group_organizer" context="{'group_by': 'organizer_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_meeting_room_booking" model="ir.actions.act_window">
        <field name="name">Meeting Room Bookings</field>
        <field name="res_model">od19.meeting.room.booking</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="view_meeting_room_booking_search"/>
        <field name="context">{'search_default_upcoming': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Pick a room and a time slot, then save — your booking is confirmed right away.</p></field>
    </record>
</odoo>
