<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ===== Inherit the base sale order document to inject the CONFIRMED stamp =====
             The stamp is rendered only when `show_stamp` is set (by the stamped report)
             AND the order is confirmed AND stamp_date is filled in. -->
        <template id="report_saleorder_document_inherit_stamp"
                  inherit_id="sale.report_saleorder_document">
            <xpath expr="//div[hasclass('page')]" position="inside">
                <t t-if="show_stamp and doc.state == 'sale' and doc.stamp_date">
                    <!-- CONFIRMED stamp: overlaid on the page like a rubber stamp -->
                    <div style="position:absolute; top:120px; right:40px; z-index:10; opacity:0.90; transform: rotate(-6deg); -webkit-transform: rotate(-6deg);">
                        <table class="od19-confirmed-stamp"
                               style="border:2.5px solid #dc3545; width:300px; background:transparent; border-collapse:collapse;">
                            <tbody>
                                <!-- Header: CONFIRMED -->
                                <tr>
                                    <td colspan="2"
                                        style="border:1.5px solid #dc3545; text-align:center; padding:5px 8px; background:transparent;">
                                        <strong style="color:#dc3545; font-size:20px; letter-spacing:3px; font-family:'Arial Black', sans-serif;">
                                            CONFIRMED
                                        </strong>
                                    </td>
                                </tr>
                                <!-- SIGN -->
                                <tr>
                                    <td style="border:1.5px solid #dc3545; color:#dc3545; font-weight:bold; width:110px; padding:4px 8px; text-align:right; vertical-align:middle;">
                                        SIGN
                                    </td>
                                    <td style="border:1.5px solid #dc3545; padding:4px 8px; height:60px; vertical-align:middle; background:transparent;">
                                        <t t-if="doc.confirmed_by_id.employee_id and doc.confirmed_by_id.employee_id.signature">
                                            <img t-att-src="image_data_uri(doc.confirmed_by_id.employee_id.signature)"
                                                 alt="Signature"
                                                 style="max-height:52px; max-width:100%; height:auto; width:auto;"/>
                                        </t>
                                        <t t-else="">
                                            <span t-field="doc.confirmed_by_id.name"/>
                                        </t>
                                    </td>
                                </tr>
                                <!-- DATE -->
                                <tr>
                                    <td style="border:1.5px solid #dc3545; color:#dc3545; font-weight:bold; padding:4px 8px; text-align:right; vertical-align:middle;">
                                        DATE
                                    </td>
                                    <td style="border:1.5px solid #dc3545; padding:4px 8px; vertical-align:middle; background:transparent;">
                                        <span t-field="doc.stamp_date"
                                              t-options='{"widget": "date"}'/>
                                    </td>
                                </tr>
                                <!-- DELIVERY ON -->
                                <tr>
                                    <td style="border:1.5px solid #dc3545; color:#dc3545; font-weight:bold; padding:4px 8px; text-align:right; vertical-align:middle;">
                                        DELIVERY ON
                                    </td>
                                    <td style="border:1.5px solid #dc3545; padding:4px 8px; vertical-align:middle; background:transparent;">
                                        <span t-field="doc.commitment_date"
                                              t-options='{"widget": "date"}'/>
                                    </td>
                                </tr>
                                <!-- JOB -->
                                <tr>
                                    <td style="border:1.5px solid #dc3545; color:#dc3545; font-weight:bold; padding:4px 8px; text-align:right; vertical-align:middle;">
                                        JOB
                                    </td>
                                    <td style="border:1.5px solid #dc3545; padding:4px 8px; vertical-align:middle; background:transparent;">
                                        <t t-if="doc.od19_project_id">
                                            <span t-field="doc.od19_project_id.job_no"/>
                                        </t>
                                    </td>
                                </tr>
                                <!-- CODE -->
                                <tr>
                                    <td style="border:1.5px solid #dc3545; color:#dc3545; font-weight:bold; padding:4px 8px; text-align:right; vertical-align:middle;">
                                        CODE
                                    </td>
                                    <td style="border:1.5px solid #dc3545; padding:4px 8px; vertical-align:middle; background:transparent;">
                                        <span t-field="doc.stamp_code"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </xpath>
        </template>

        <!-- ===== Stamped report document: sets show_stamp then calls the base template ===== -->
        <template id="report_saleorder_stamp_document">
            <t t-set="show_stamp" t-value="True"/>
            <t t-call="sale.report_saleorder_document"/>
        </template>

        <!-- Raw wrapper (iterates over multiple records) -->
        <template id="report_saleorder_stamp">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="od19_sales_confirm_stamp.report_saleorder_stamp_document"
                       t-lang="doc.partner_id.lang"/>
                </t>
            </t>
        </template>

        <!-- ===== Report action: Print Quotation (with Stamp) ===== -->
        <record id="action_report_saleorder_stamp" model="ir.actions.report">
            <field name="name">Quotation / Order (with Stamp)</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">od19_sales_confirm_stamp.report_saleorder_stamp</field>
            <field name="report_file">od19_sales_confirm_stamp.report_saleorder_stamp</field>
            <field name="print_report_name">
                (object.name or 'Quotation') + ' (stamped)'
            </field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
            <field name="attachment_use" eval="False"/>
        </record>

    </data>
</odoo>
