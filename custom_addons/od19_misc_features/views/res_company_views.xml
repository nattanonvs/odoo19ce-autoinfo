<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_company_form_logo_iso" model="ir.ui.view">
        <field name="name">res.company.form.logo.iso</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='logo' and @widget='contact_image']" position="after">
                <field name="od19_logo_iso"
                       widget="image"
                       class="img-fluid"
                       help="ISO certification logo (โลโก้ ISO)"/>
            </xpath>
        </field>
    </record>

</odoo>
