<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_form_logo_iso" model="ir.ui.view">
        <field name="name">res.config.settings.form.logo.iso</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="inside">
                <setting id="od19_logo_iso_setting"
                         string="ISO Logo"
                         help="ISO certification logo (โลโก้ ISO) displayed on reports and documents."
                         company_dependent="1">
                    <div class="content-group">
                        <div class="mt16">
                            <field name="od19_logo_iso"
                                   widget="image"
                                   class="img-fluid"/>
                        </div>
                    </div>
                </setting>
                <setting id="od19_document_emails_setting"
                         string="Document E-mails"
                         help="E-mail printed on documents. Sales documents use the Sales e-mail; purchase, inventory and accounting documents use the Accounting e-mail."
                         company_dependent="1">
                    <div class="content-group">
                        <div class="mt16">
                            <label for="od19_email_sales" class="o_light_label"/>
                            <field name="od19_email_sales" class="oe_inline"/>
                        </div>
                        <div class="mt16">
                            <label for="od19_email_accounts" class="o_light_label"/>
                            <field name="od19_email_accounts" class="oe_inline"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
