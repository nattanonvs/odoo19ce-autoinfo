<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dncn_reason_view_tree" model="ir.ui.view">
        <field name="name">account.move.dncn.reason.tree</field>
        <field name="model">account.move.dncn.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="dncn_reason_view_form" model="ir.ui.view">
        <field name="name">account.move.dncn.reason.form</field>
        <field name="model">account.move.dncn.reason</field>
        <field name="arch" type="xml">
            <form string="DN/CN Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dncn_reason" model="ir.actions.act_window">
        <field name="name">DN/CN Reasons</field>
        <field name="res_model">account.move.dncn.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dncn_reason"
              name="DN/CN Reasons"
              parent="account.menu_finance_configuration"
              action="action_dncn_reason"
              sequence="50"/>
</odoo>
